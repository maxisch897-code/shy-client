local notify
do
    local notifyGui = new("ScreenGui", {Name="ShyNotify",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,Parent=pg})
    local holder = new("Frame", {Size=UDim2.new(0,280,0.6,0),Position=UDim2.new(1,-300,0,20),BackgroundTransparency=1,Parent=notifyGui})
    new("UIListLayout", {Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder,Parent=holder})
    local order = 0

    notify = function(title, msg, good)
        order += 1
        local wrap = new("Frame", {Size=UDim2.new(1,0,0,56),BackgroundTransparency=1,LayoutOrder=order,Parent=holder})
        local c = new("Frame", {Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 46, 0, 0), BackgroundColor3 = T.Card, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = wrap})
        corner(c, RM); stroke(c, 1, 0.7, T.Line, true)
        local bad = (good == false)
        local bar = new("Frame", {Size = UDim2.new(0, 3, 1, -16), Position = UDim2.new(0, 6, 0, 8), BackgroundColor3 = (bad and T.Bad or T.Accent), BorderSizePixel = 0, Parent = c})
        corner(bar, 2); gradient(bar, (bad and T.Bad or T.Accent), (bad and T.Bad or T.Accent2), 90)
        local titleLbl = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 10), Size = UDim2.new(1, -24, 0, 16), Font = Enum.Font.GothamBold, Text = title, TextColor3 = T.Text, TextSize = 12, TextTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = c})
        local msgLbl = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 28), Size = UDim2.new(1, -24, 0, 20), Font = Enum.Font.Gotham, Text = msg, TextColor3 = T.Dim, TextSize = 11, TextTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = c})
        tween(c, 0.3, {BackgroundTransparency = TR.Notify, Position = UDim2.new(0, 0, 0, 0)})
        tween(titleLbl, 0.3, {TextTransparency = 0})
        tween(msgLbl, 0.3, {TextTransparency = 0})
        task.delay(2.8, function()
            tween(c, 0.22, {BackgroundTransparency = 1, Position = UDim2.new(0, 46, 0, 0)})
            tween(titleLbl, 0.22, {TextTransparency = 1})
            tween(msgLbl, 0.22, {TextTransparency = 1})
            task.wait(0.26); wrap:Destroy()
        end)
    end
end

