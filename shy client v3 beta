-- MUSIC + LYRICS ENGINE
-- ══════════════════════════════════════════════════════════════
do
    Music.sound = new("Sound", {Name="ShyMusic", Volume=Music.volume, Looped=true, Parent=SoundService})

    local function cleanName(s)
        s = tostring(s or "")
        s = s:gsub("%b()", " "):gsub("%b[]", " "):gsub("_", " ")
        s = s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
        return s
    end

    local function mkLine(t, text)
        local words, cum, total = {}, {}, 0
        for w in text:gmatch("%S+") do words[#words+1] = w; total = total + #w + 1 end
        local acc = 0
        for i, w in ipairs(words) do acc = acc + #w + 1; cum[i] = acc / math.max(total, 1) end
        return { t=t, text=text, words=words, cum=cum }
    end

    Lyrics.parse = function(raw)
        local lines, plain, synced = {}, {}, false
        for ln in tostring(raw):gmatch("[^\r\n]+") do
            local stamps, rest = {}, ln
            while true do
                local mm, ss, ff, nxt = rest:match("^%s*%[(%d+):(%d+)[%.:]?(%d*)%]()")
                if not mm then break end
                local frac = (ff ~= "" and tonumber("0."..ff)) or 0
                stamps[#stamps+1] = tonumber(mm) * 60 + tonumber(ss) + frac
                rest = rest:sub(nxt)
            end
            rest = rest:gsub("<%d+:%d+[%.:]?%d*>", "")
            rest = rest:gsub("^%s+", ""):gsub("%s+$", "")
            if #stamps > 0 then
                synced = true
                if rest ~= "" then for _, t in ipairs(stamps) do lines[#lines+1] = mkLine(t, rest) end end
            elseif rest ~= "" and not rest:match("^%[%a+:") then
                plain[#plain+1] = rest
            end
        end
        if synced then
            table.sort(lines, function(a, b) return a.t < b.t end)
            return lines
        end
        local total = Music.sound.TimeLength > 0 and Music.sound.TimeLength or 180
        for i, text in ipairs(plain) do lines[#lines+1] = mkLine((i - 1) * total / math.max(#plain, 1), text) end
        return lines
    end

    Lyrics.fetch = function(query, quiet)
        if not req then
            if not quiet then notify("Lyrics", "Executor has no HTTP request — paste LRC instead", false) end
            return
        end
        local q = cleanName(query)
        if q == "" then if not quiet then notify("Lyrics", "Enter artist - song", false) end return end
        task.spawn(function()
            if not quiet then notify("Lyrics", "Searching: " .. q) end
            local ok, res = pcall(req, { Url="https://lrclib.net/api/search?q=" .. HttpService:UrlEncode(q), Method="GET" })
            if not ok or type(res) ~= "table" or not res.Body then notify("Lyrics", "Request failed", false) return end
            local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if not ok2 or type(data) ~= "table" or #data == 0 then notify("Lyrics", "No lyrics found", false) return end
            local pick
            for _, it in ipairs(data) do
                if type(it.syncedLyrics) == "string" and #it.syncedLyrics > 0 then pick = it.syncedLyrics; break end
            end
            if not pick then
                for _, it in ipairs(data) do
                    if type(it.plainLyrics) == "string" and #it.plainLyrics > 0 then pick = it.plainLyrics; break end
                end
            end
            if not pick then notify("Lyrics", "No lyrics found", false) return end
            local lines = Lyrics.parse(pick)
            if #lines == 0 then notify("Lyrics", "Could not read lyrics", false) return end
            Lyrics.lines = lines; Lyrics.key = nil
            notify("Lyrics", "Loaded " .. #lines .. " lines")
        end)
    end

    Lyrics.loadText = function(text)
        local lines = Lyrics.parse(text)
        if #lines == 0 then notify("Lyrics", "Nothing to load", false) return end
        Lyrics.lines = lines; Lyrics.key = nil
        notify("Lyrics", "Loaded " .. #lines .. " lines")
    end

    Lyrics.clear = function() Lyrics.lines = {}; Lyrics.key = nil end

    Lib.save = function()
        if not FILE_OK then return end
        local ok, e = pcall(function() return HttpService:JSONEncode(Lib.list) end)
        if ok then pcall(writefile, Lib.file, e) end
    end
    Lib.load = function()
        if not FILE_OK then return end
        local ok, ex = pcall(isfile, Lib.file)
        if ok and ex then
            local ok2, raw = pcall(readfile, Lib.file)
            if ok2 then
                local ok3, d = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok3 and type(d) == "table" then Lib.list = d end
            end
        end
    end
    Lib.add = function(id, name, artist)
        local clean = tostring(id or ""):gsub("rbxassetid://", ""):gsub("%D", "")
        if clean == "" then notify("Library", "Enter a valid audio ID", false) return end
        name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then name = "Song " .. (#Lib.list + 1) end
        for _, e in ipairs(Lib.list) do
            if e.id == clean then
                e.name = name; if artist and artist ~= "" then e.artist = artist end
                Lib.save(); if Lib.refresh then Lib.refresh() end
                notify("Library", "Updated: " .. name)
                return
            end
        end
        Lib.list[#Lib.list+1] = { id=clean, name=name, artist=artist or "" }
        Lib.save(); if Lib.refresh then Lib.refresh() end
        notify("Library", "Saved: " .. name)
    end
    Lib.remove = function(i)
        local e = Lib.list[i]; if not e then return end
        table.remove(Lib.list, i)
        Lib.save(); if Lib.refresh then Lib.refresh() end
        notify("Library", "Deleted: " .. e.name, false)
    end
    Lib.load()

    Music.play = function(id, name, artist)
        local clean = tostring(id or ""):gsub("rbxassetid://", ""):gsub("%D", "")
        if clean == "" then notify("Music", "Enter a valid audio ID", false) return end
        Music.id = clean
        Music.name = (name and name ~= "") and name or ("Audio " .. clean)
        Music.artist = artist or ""
        Music.sound.SoundId = "rbxassetid://" .. clean
        Music.sound.TimePosition = 0
        Music.sound:Play()
        Music.playing = true
        Lyrics.clear()
        notify("Music", "Playing: " .. Music.name)
        Fn.updateHud()
        if Lyrics.auto then Lyrics.fetch((Music.artist ~= "" and (Music.artist .. " ") or "") .. Music.name, true) end
        task.delay(4, function()
            if Music.id == clean and Music.sound.TimeLength == 0 then
                notify("Music", "Audio could not load (private/blocked ID?)", false)
            end
        end)
    end

    Music.toggle = function()
        if not Music.id then notify("Music", "Nothing loaded — pick a song first", false) return end
        if Music.playing then Music.sound:Pause(); Music.playing = false
        else Music.sound:Resume(); Music.playing = true end
        Fn.updateHud()
    end

    Music.stop = function()
        Music.sound:Stop(); Music.playing = false
        Fn.updateHud()
    end

    local function step(dir)
        if #Lib.list == 0 then notify("Music", "Save songs in the library first", false) return end
        local cur = 0
        for i, e in ipairs(Lib.list) do if e.id == Music.id then cur = i; break end end
        local nxt = ((cur - 1 + dir) % #Lib.list) + 1
        local e = Lib.list[nxt]
        Music.play(e.id, e.name, e.artist)
    end
    Music.next = function() step(1) end
    Music.prev = function() step(-1) end

    Music.sound.Ended:Connect(function() if not Music.looped then step(1) end end)

    -- Favourites storage
    Fav.load = function()
        if not FILE_OK then return end
        local ok, ex = pcall(isfile, Fav.file)
        if ok and ex then
            local ok2, raw = pcall(readfile, Fav.file)
            if ok2 then
                local ok3, d = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok3 and type(d) == "table" then Fav.list = d end
            end
        end
    end
    Fav.save = function()
        if not FILE_OK then return end
        local ok, e = pcall(function() return HttpService:JSONEncode(Fav.list) end)
        if ok then pcall(writefile, Fav.file, e) end
    end
    Fav.has = function(userId) return Fav.list[tostring(userId)] ~= nil end
    Fav.toggle = function(userId, username, displayName)
        local key = tostring(userId)
        if Fav.list[key] then
            Fav.list[key] = nil
            notify("Favourites", "Removed " .. (username or key))
        else
            Fav.list[key] = { username = username or "", displayName = displayName or username or "" }
            notify("Favourites", "Added " .. (username or key))
        end
        Fav.save()
    end
    Fav.load()
end

-- ══════════════════════════════════════════════════════════════
-- WORLD FX
-- ══════════════════════════════════════════════════════════════
do
    local fx = new("Folder", {Name="ShyFX", Parent=workspace})
    local function emitterPart(name, size)
        return new("Part", {Name=name,Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,Transparency=1,Size=size,Parent=fx})
    end
    local sky = emitterPart("Sky", Vector3.new(110, 1, 110))
    local vol = emitterPart("Vol", Vector3.new(80, 30, 80))
    local rainE, snowE, flyE, atmo
    local tint = new("ColorCorrectionEffect", {Name="ShyTint", Enabled=false, Parent=Lighting})
    local flash = new("ColorCorrectionEffect", {Name="ShyFlash", Parent=Lighting})
    local bloom = new("BloomEffect", {Name="ShyBloom", Enabled=false, Intensity=0.7, Size=28, Threshold=0.85, Parent=Lighting})
    local cubes, amb = {}, {}

    Wx.rain = function()
        if rainE then rainE:Destroy(); rainE = nil end
        if not feat.rain then return end
        rainE = new("ParticleEmitter", {
            Rate=900, Lifetime=NumberRange.new(0.55, 0.65), Speed=NumberRange.new(95, 110),
            EmissionDirection=Enum.NormalId.Bottom, SpreadAngle=Vector2.new(2, 2),
            Orientation=Enum.ParticleOrientation.VelocityParallel,
            Size=NumberSequence.new(0.5), Squash=NumberSequence.new(-3),
            Transparency=NumberSequence.new(0.45), Color=ColorSequence.new(EFFECT_COLOR:Lerp(Color3.new(1, 1, 1), 0.3)),
            LightEmission=0.25, Acceleration=Vector3.new(-8, 0, 0), Parent=sky,
        })
    end
    Wx.snow = function()
        if snowE then snowE:Destroy(); snowE = nil end
        if not feat.snow then return end
        snowE = new("ParticleEmitter", {
            Rate=350, Lifetime=NumberRange.new(7, 9), Speed=NumberRange.new(5, 8),
            EmissionDirection=Enum.NormalId.Bottom, SpreadAngle=Vector2.new(25, 25),
            Size=NumberSequence.new(0.35), Transparency=NumberSequence.new(0.15),
            Color=ColorSequence.new(EFFECT_COLOR:Lerp(Color3.new(1, 1, 1), 0.35)), LightEmission=0.4,
            Acceleration=Vector3.new(3, 0, 2), Rotation=NumberRange.new(0, 360), RotSpeed=NumberRange.new(-40, 40), Parent=sky,
        })
    end
    Wx.fog = function()
        if atmo then atmo:Destroy(); atmo = nil end
        if feat.fog then
            atmo = new("Atmosphere", {Name="ShyFog", Density=feat.fogDensity, Offset=0.25, Color=EFFECT_COLOR:Lerp(Color3.new(1, 1, 1), 0.55), Decay=EFFECT_COLOR:Lerp(Color3.new(0, 0, 0), 0.45), Glare=0, Haze=2, Parent=Lighting})
        end
    end
    Wx.fogDensity = function(v) if atmo then atmo.Density = v end end
    Wx.fireflies = function()
        if flyE then flyE:Destroy(); flyE = nil end
        if not feat.fireflies then return end
        flyE = new("ParticleEmitter", {
            Rate=18, Lifetime=NumberRange.new(5, 8), Speed=NumberRange.new(0.5, 1.5),
            EmissionDirection=Enum.NormalId.Top, SpreadAngle=Vector2.new(180, 180),
            Size=NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.28), NumberSequenceKeypoint.new(1, 0)}),
            Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.1), NumberSequenceKeypoint.new(0.8, 0.1), NumberSequenceKeypoint.new(1, 1)}),
            Color=ColorSequence.new(EFFECT_COLOR), LightEmission=1, Acceleration=Vector3.new(0, 0.4, 0), Parent=vol,
        })
    end

    local function mkCube(size, transp)
        return new("Part", {Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,Material=Enum.Material.Neon,Size=Vector3.new(size,size,size),Color=EFFECT_COLOR,Transparency=transp,Parent=fx})
    end
    Wx.cubes = function()
        for _, p in ipairs(cubes) do p:Destroy() end
        cubes = {}
        if feat.cubes then for i = 1, feat.cubeCount do cubes[i] = mkCube(0.7, 0.2) end end
    end
    Wx.ambient = function()
        for _, e in ipairs(amb) do e.part:Destroy() end
        amb = {}
        if feat.ambient then
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local base = hrp and hrp.Position or camera.CFrame.Position
            for i = 1, 28 do
                amb[i] = {
                    part = mkCube(0.3 + math.random() * 0.6, 0.35),
                    pos = base + Vector3.new(math.random(-45, 45), math.random(-6, 18), math.random(-45, 45)),
                    s = 0.6 + math.random() * 1.2, ph = math.random() * 6.28,
                }
            end
        end
    end

    Wx.tint = function()
        tint.Enabled = feat.tint
        local k = feat.tintStrength / 100
        tint.TintColor = Color3.new(1, 1, 1):Lerp(EFFECT_COLOR, k * 0.75)
        tint.Saturation = 0.15 * k
        tint.Contrast = 0.08 * k
        tint.Brightness = -0.03 * k
    end
    Wx.bloom = function() bloom.Enabled = feat.bloom end

    local vig = {}
    do
        local function edge(size, pos, rot)
            local f = new("Frame", {Size=size, Position=pos, BackgroundColor3=Color3.fromRGB(0, 10, 10), BorderSizePixel=0, Visible=false, ZIndex=1, Parent=UI.ovGui})
            local g = Instance.new("UIGradient")
            g.Rotation = rot
            g.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1)})
            g.Parent = f
            vig[#vig+1] = f
        end
        edge(UDim2.new(1,0,0.3,0), UDim2.new(0,0,0,0), 90)
        edge(UDim2.new(1,0,0.3,0), UDim2.new(0,0,0.7,0), 270)
        edge(UDim2.new(0.22,0,1,0), UDim2.new(0,0,0,0), 0)
        edge(UDim2.new(0.22,0,1,0), UDim2.new(0.78,0,0,0), 180)
    end
    Wx.vignette = function() for _, f in ipairs(vig) do f.Visible = feat.vignette end end

    -- ── GHOST TRAIL / AFTERIMAGE (rewritten AGAIN - per-part clone, no char:Clone)
    -- Old version used char:Clone() which often returns nil or fails silently.
    -- New version clones individual BaseParts with pcall, snapshots their CFrame,
    -- strips decals/particles, applies Neon + effect color, fades with Quint.
    local function spawnGhost(char)
        if not char or not char.Parent then return end
        local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if not hrp then return end

        local ghostParts = {}
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart")
                and p.Name ~= "HumanoidRootPart"
                and p.Transparency < 0.98
                and p.Size.Magnitude > 0
                and p.Parent ~= nil
            then
                -- skip parts that are inside accessories if we already handled them,
                -- but for simplicity include everything visible
                local ok, clone = pcall(function() return p:Clone() end)
                if ok and clone and clone:IsA("BasePart") then
                    clone.Anchored = true
                    clone.CanCollide = false
                    clone.CanQuery = false
                    clone.CanTouch = false
                    clone.CastShadow = false
                    clone.Massless = true
                    clone.Material = Enum.Material.Neon
                    clone.Color = EFFECT_COLOR
                    clone.Transparency = 0.25
                    clone.CFrame = p.CFrame
                    clone.Parent = fx
                    -- strip anything that would still run/tween on the ghost
                    for _, c in ipairs(clone:GetChildren()) do
                        if c:IsA("Decal") or c:IsA("Texture") or c:IsA("ParticleEmitter")
                            or c:IsA("Trail") or c:IsA("Light") or c:IsA("Sound")
                            or c:IsA("Attachment") or c:IsA("BillboardGui") or c:IsA("SurfaceAppearance")
                            or c:IsA("Fire") or c:IsA("Smoke") or c:IsA("Sparkles") then
                            c:Destroy()
                        end
                    end
                    ghostParts[#ghostParts + 1] = clone
                end
            end
        end

        if #ghostParts == 0 then return end

        -- Soft fade out; even if the tween is interrupted, we destroy after 0.9s
        local fadeInfo = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        for _, p in ipairs(ghostParts) do
            TS:Create(p, fadeInfo, { Transparency = 1 }):Play()
        end

        task.delay(0.85, function()
            for _, p in ipairs(ghostParts) do
                if p and p.Parent then p:Destroy() end
            end
        end)
    end

    Wx.color = function()
        for _, p in ipairs(cubes) do p.Color = EFFECT_COLOR end
        for _, e in ipairs(amb) do e.part.Color = EFFECT_COLOR end
        if feat.fireflies then Wx.fireflies() end
        if feat.rain then Wx.rain() end
        if feat.snow then Wx.snow() end
        if feat.fog then Wx.fog() end
        Wx.tint()
        for _, f in ipairs(vig) do f.BackgroundColor3 = EFFECT_COLOR:Lerp(Color3.new(0, 0, 0), 0.85) end
        if Fn.rebuildVFX then Fn.rebuildVFX() end
    end

    Wx.all = function()
        Wx.rain(); Wx.snow(); Wx.fog(); Wx.fireflies(); Wx.cubes(); Wx.ambient(); Wx.tint(); Wx.bloom(); Wx.vignette()
    end

    local t0, lastGhost = tick(), 0
    local lastGhostPos = nil

    RS.RenderStepped:Connect(function(dt)
        camera = workspace.CurrentCamera or camera
        local cp = camera.CFrame.Position
        sky.CFrame = CFrame.new(cp + Vector3.new(0, 45, 0))
        vol.CFrame = CFrame.new(cp)
        local now = tick() - t0
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then lastGhostPos = nil; return end

        if feat.cubes then
            local n = #cubes
            for i, c in ipairs(cubes) do
                local a = now * feat.cubeSpeed + (i / math.max(n, 1)) * math.pi * 2
                local r = feat.cubeRadius
                local pos = hrp.Position + Vector3.new(math.cos(a) * r, 0.8 + math.sin(now * 2 + i) * 0.9, math.sin(a) * r)
                c.CFrame = CFrame.new(pos) * CFrame.Angles(now + i, now * 1.3, i)
            end
        end

        if feat.ambient then
            for _, e in ipairs(amb) do
                e.pos = e.pos + Vector3.new(math.sin(now * 0.3 + e.ph) * 0.4 * dt, 0.3 * dt, math.cos(now * 0.25 + e.ph) * 0.4 * dt)
                if (e.pos - hrp.Position).Magnitude > 55 or e.pos.Y > hrp.Position.Y + 35 then
                    e.pos = hrp.Position + Vector3.new(math.random(-45, 45), math.random(-6, 4), math.random(-45, 45))
                end
                local p = e.pos + Vector3.new(0, math.sin(now * e.s + e.ph) * 1.2, 0)
                e.part.CFrame = CFrame.new(p) * CFrame.Angles(now * e.s, now * e.s * 0.7, e.ph)
            end
        end

        -- AFTERIMAGE trigger: check velocity, fall back to position delta
        if feat.ghost and (now - lastGhost) >= feat.ghostInterval then
            local v = hrp.AssemblyLinearVelocity
            local speed = Vector3.new(v.X, 0, v.Z).Magnitude
            local moved = 0
            if lastGhostPos then
                moved = (hrp.Position - lastGhostPos).Magnitude
            end
            lastGhostPos = hrp.Position
            -- Trigger if speed > 1.5 OR the HRP moved more than 0.3 studs this frame
            if speed > 1.5 or moved > 0.3 then
                lastGhost = now
                spawnGhost(char)
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(math.random(7, 16))
            if feat.thunder then
                flash.TintColor = Color3.new(1, 1, 1):Lerp(EFFECT_COLOR, 0.6)
                for _ = 1, 2 do
                    flash.Brightness = 0.5
                    task.wait(0.06)
                    tween(flash, 0.25, {Brightness = 0})
                    task.wait(0.35)
                end
            end
        end
    end)

    player.CharacterAdded:Connect(function() task.wait(1); if feat.ambient then Wx.ambient() end end)
end

-- ══════════════════════════════════════════════════════════════
-- ANIMATED SKYBOXES (unchanged)
-- ══════════════════════════════════════════════════════════════
do
    local Sky = {mode = "Off", ents = {}, anim = nil}
    Fn.Sky = Sky
    local D = 650
    local WHITE = Color3.new(1, 1, 1)
    local MODES = {"Black Hole", "Aurora", "Galaxy", "Nebula", "Starry Night"}
    Sky.MODES = MODES
    for _, m in ipairs(MODES) do feat["sky" .. m:gsub(" ", "")] = false end

    local function part(props)
        local p = new("Part", {Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Material=Enum.Material.Neon, Size=Vector3.new(1, 1, 1)})
        for k, v in pairs(props) do p[k] = v end
        p.Parent = Sky.model
        return p
    end
    local function add(p, cf) local e = {p=p, cf=cf}; Sky.ents[#Sky.ents + 1] = e; return e end

    local function glow(cf, studs, color, strength)
        local a = part({Transparency=1})
        local bb = new("BillboardGui", {Size=UDim2.new(studs, 0, studs, 0), LightInfluence=0, Brightness=2, AlwaysOnTop=false, Adornee=a, Parent=a})
        for k = 1, 6 do
            local s = k / 6
            local f = new("Frame", {AnchorPoint=Vector2.new(0.5, 0.5), Position=UDim2.fromScale(0.5, 0.5), Size=UDim2.fromScale(s, s), BackgroundColor3=color, BackgroundTransparency=math.clamp(1 - 0.13 * (strength or 1), 0, 1), BorderSizePixel=0, Parent=bb})
            new("UICorner", {CornerRadius=UDim.new(0.5, 0), Parent=f})
        end
        local e = add(a, cf); e.bb = bb; e.size = studs
        return e
    end

    local function curtain(color, topColor)
        local p = part({Transparency=1, Size=Vector3.new(30, 100, 0.2)})
        local frames = {}
        for _, face in ipairs({Enum.NormalId.Front, Enum.NormalId.Back}) do
            local sg = new("SurfaceGui", {Face=face, SizingMode=Enum.SurfaceGuiSizingMode.FixedSize, CanvasSize=Vector2.new(16, 128), LightInfluence=0, Brightness=2.5, Parent=p})
            local f = new("Frame", {Size=UDim2.fromScale(1, 1), BackgroundColor3=WHITE, BorderSizePixel=0, Parent=sg})
            new("UIGradient", {Rotation=90, Color=ColorSequence.new(topColor, color),
                Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 0.7), NumberSequenceKeypoint.new(0.85, 0.12), NumberSequenceKeypoint.new(1, 1)}), Parent=f})
            frames[#frames + 1] = f
        end
        return p, frames
    end

    local function stars(n, EC)
        local list = {}
        for _ = 1, n do
            local dir
            repeat dir = Vector3.new(math.random() * 2 - 1, math.random() * 1.1 - 0.1, math.random() * 2 - 1) until dir.Magnitude > 0.2 and dir.Magnitude <= 1
            local sz = 1 + math.random() * 2.4
            local p = part({Shape=Enum.PartType.Ball, Size=Vector3.new(sz, sz, sz), Color=WHITE:Lerp(EC, math.random() * 0.5), Transparency=math.random() * 0.4})
            local e = add(p, CFrame.new(dir.Unit * (D + 150)))
            e.base = p.Transparency
            list[#list + 1] = e
        end
        return list
    end
    local function twinkle(list)
        for _ = 1, 14 do
            local e = list[math.random(#list)]
            e.p.Transparency = math.clamp(e.base + (math.random() - 0.5) * 0.7, 0, 0.92)
        end
    end
    local function skyDir(az, el) return Vector3.new(math.cos(el) * math.sin(az), math.sin(el), -math.cos(el) * math.cos(az)) end

    local BUILD = {}

    BUILD["Black Hole"] = function(EC)
        local st = stars(220, EC)
        local center = Vector3.new(0.35, 0.5, -0.8).Unit * D
        local face = CFrame.lookAt(center, Vector3.zero)
        glow(CFrame.new(center), 520, EC, 0.9)
        glow(CFrame.new(center), 230, WHITE:Lerp(EC, 0.4), 1.3)
        add(part({Shape=Enum.PartType.Ball, Size=Vector3.new(96, 96, 96), Color=Color3.new(0, 0, 0)}), CFrame.new(center))
        local N = 48
        for i = 1, N do
            local a = i / N * math.pi * 2
            local r = 58
            local p = part({Size=Vector3.new(2 * math.pi * r / N * 1.15, 3.2, 1), Color=WHITE:Lerp(EC, 0.35), Transparency=0.15 + 0.5 * (0.5 - 0.5 * math.cos(a))})
            add(p, face * CFrame.Angles(0, 0, a) * CFrame.new(0, r, 0))
        end
        local disk = {}
        for ri, r in ipairs({72, 100, 132, 165}) do
            local n = 56
            for i = 1, n do
                local phi = i / n * math.pi * 2
                local p = part({Size=Vector3.new(2 * math.pi * r / n * 1.12, 1.4, 30), Color=WHITE:Lerp(EC, 0.15 + ri * 0.2),
                    Transparency=math.clamp(0.05 + ri * 0.14 + 0.3 * (0.5 + 0.5 * math.sin(phi * 3 + ri)), 0, 0.95)})
                disk[#disk + 1] = {e=add(p, CFrame.new()), r=r, phi=phi, w=0.35 * 72 / r}
            end
        end
        local diskCF = face * CFrame.Angles(math.rad(12), 0, 0)
        return function(t)
            for _, d in ipairs(disk) do d.e.cf = diskCF * CFrame.Angles(0, d.phi + t * d.w, 0) * CFrame.new(0, 0, -d.r) end
            twinkle(st)
        end
    end

    BUILD["Aurora"] = function(EC)
        local st = stars(200, EC)
        local top = EC:Lerp(WHITE, 0.3)
        local bands = {}
        for b = 1, 2 do
            local n = 34
            local az0, span = (b == 1) and -1.2 or 0.6, (b == 1) and 2.0 or 1.6
            local rad, y = (b == 1) and 520 or 600, (b == 1) and 190 or 260
            for i = 1, n do
                local p, frames = curtain(EC, top)
                bands[#bands + 1] = {p=p, frames=frames, e=add(p, CFrame.new()), az=az0 + span * i / n, rad=rad, y=y, k=i + b * 50, w=rad * span / n * 1.15}
            end
        end
        return function(t)
            for _, c in ipairs(bands) do
                local k = c.k
                local az = c.az + 0.03 * math.sin(t * 0.2 + k * 0.3)
                local r = c.rad + 45 * math.sin(k * 0.45 + t * 0.35)
                local h = 110 + 70 * (0.5 + 0.5 * math.sin(k * 0.7 + t * 0.6))
                local pos = Vector3.new(math.sin(az) * r, c.y + h * 0.5 + 15 * math.sin(k * 0.3 + t * 0.4), -math.cos(az) * r)
                c.p.Size = Vector3.new(c.w, h, 0.2)
                c.e.cf = CFrame.lookAt(pos, Vector3.new(0, pos.Y, 0))
                local tr = 0.15 + 0.45 * (0.5 + 0.5 * math.sin(k * 1.3 + t * 1.1))
                for _, f in ipairs(c.frames) do f.BackgroundTransparency = tr end
            end
            twinkle(st)
        end
    end

    BUILD["Galaxy"] = function(EC)
        local st = stars(240, EC)
        local center = Vector3.new(-0.45, 0.55, -0.7).Unit * D
        local plane = CFrame.lookAt(center, Vector3.zero) * CFrame.Angles(math.rad(-58), 0, 0)
        glow(CFrame.new(center), 260, EC, 0.8)
        glow(CFrame.new(center), 90, WHITE:Lerp(EC, 0.25), 1.6)
        local pts = {}
        for i = 1, 180 do
            local tt = i / 180
            local sz = 5 - tt * 3 + math.random() * 1.5
            local p = part({Shape=Enum.PartType.Ball, Size=Vector3.new(sz, sz, sz), Color=WHITE:Lerp(EC, 0.2 + tt * 0.8), Transparency=0.1 + tt * 0.5})
            pts[#pts + 1] = {e=add(p, CFrame.new()), ang=(i % 2) * math.pi + tt * math.pi * 3.2 + (math.random() - 0.5) * 0.5, r=12 + tt * 190 + (math.random() - 0.5) * 18, h=(math.random() - 0.5) * 6}
        end
        for i = 1, 10 do
            local tt = i / 10
            pts[#pts + 1] = {e=glow(CFrame.new(), 70 + math.random() * 40, EC, 0.45), ang=(i % 2) * math.pi + tt * math.pi * 3.2, r=20 + tt * 180, h=0}
        end
        return function(t)
            local rot = t * 0.04
            for _, s in ipairs(pts) do s.e.cf = plane * CFrame.new(math.cos(s.ang + rot) * s.r, s.h, math.sin(s.ang + rot) * s.r) end
            twinkle(st)
        end
    end

    BUILD["Nebula"] = function(EC)
        local st = stars(260, EC)
        local hue, sat, val = EC:ToHSV()
        local clouds = {}
        for _ = 1, 16 do
            local dir = skyDir(math.random() * math.pi * 2, math.rad(12 + math.random() * 62))
            local c = Color3.fromHSV((hue + (math.random() - 0.5) * 0.12) % 1, sat, val)
            clouds[#clouds + 1] = {e=glow(CFrame.new(dir * D), 180 + math.random() * 220, c, 0.35 + math.random() * 0.35), dir=dir, ph=math.random() * 6}
        end
        return function(t)
            local drift = CFrame.Angles(0, t * 0.01, 0)
            for _, c in ipairs(clouds) do
                c.e.cf = drift * CFrame.new(c.dir * D + Vector3.new(0, 10 * math.sin(t * 0.3 + c.ph), 0))
                local s = c.e.size * (1 - 0.12 * (0.5 + 0.5 * math.sin(t * 0.5 + c.ph)))
                c.e.bb.Size = UDim2.new(s, 0, s, 0)
            end
            twinkle(st)
        end
    end

    BUILD["Starry Night"] = function(EC)
        local st = stars(420, EC)
        local moon = Vector3.new(0.2, 0.45, -0.85).Unit * D
        glow(CFrame.new(moon), 140, WHITE:Lerp(EC, 0.3), 1.2)
        add(part({Shape=Enum.PartType.Ball, Size=Vector3.new(34, 34, 34), Color=WHITE:Lerp(EC, 0.15)}), CFrame.new(moon))
        local shoot = {}
        for i = 1, 3 do
            local p = part({Size=Vector3.new(0.8, 0.8, 60), Color=WHITE:Lerp(EC, 0.4), Transparency=1})
            shoot[i] = {e=add(p, CFrame.new(0, -5000, 0)), p=p, t0=-10, life=0}
        end
        local nextShot = 1
        return function(t)
            twinkle(st)
            if t > nextShot then
                nextShot = t + 1.5 + math.random() * 3
                for _, s in ipairs(shoot) do
                    if t - s.t0 > s.life then
                        local az = math.random() * math.pi * 2
                        s.t0, s.life = t, 0.9 + math.random() * 0.6
                        s.from = skyDir(az, math.rad(25 + math.random() * 45)) * D
                        s.vel = Vector3.new(math.cos(az), -0.5, math.sin(az)).Unit * (260 + math.random() * 200)
                        break
                    end
                end
            end
            for _, s in ipairs(shoot) do
                local a = t - s.t0
                if s.from and a <= s.life then
                    local pos = s.from + s.vel * a
                    s.e.cf = CFrame.lookAt(pos, pos + s.vel)
                    s.p.Transparency = math.clamp(math.abs(a / s.life - 0.5) * 2, 0.05, 1)
                else
                    s.p.Transparency = 1
                end
            end
        end
    end

    local function teardown()
        if Sky.conn then Sky.conn:Disconnect(); Sky.conn = nil end
        if Sky.model then Sky.model:Destroy(); Sky.model = nil end
        Sky.ents, Sky.anim = {}, nil
    end
    local function restoreLighting()
        local s = Sky.saved
        if not s then return end
        Lighting.ClockTime = s.clock; Lighting.OutdoorAmbient = s.oa; Lighting.Ambient = s.amb
        for _, sk in ipairs(s.skies) do pcall(function() sk.Parent = Lighting end) end
        Sky.saved = nil
    end

    Fn.setSky = function(mode)
        teardown()
        Sky.mode = BUILD[mode] and mode or "Off"
        for _, m in ipairs(MODES) do
            local id = (m:gsub(" ", ""))
            feat["sky" .. id] = (m == Sky.mode)
            if m ~= Sky.mode and ToggleReg["Sky" .. id] then ToggleReg["Sky" .. id](false) end
        end
        if Sky.mode == "Off" then restoreLighting() return end
        if not Sky.saved then
            local skies = {}
            for _, c in ipairs(Lighting:GetChildren()) do if c:IsA("Sky") then skies[#skies + 1] = c; c.Parent = nil end end
            Sky.saved = {clock=Lighting.ClockTime, oa=Lighting.OutdoorAmbient, amb=Lighting.Ambient, skies=skies}
        end
        local EC = EFFECT_COLOR
        Lighting.ClockTime = 0
        Lighting.OutdoorAmbient = Color3.fromRGB(105, 105, 120):Lerp(EC, 0.25)
        Lighting.Ambient = Color3.fromRGB(70, 70, 85):Lerp(EC, 0.2)
        Sky.model = new("Model", {Name="ShySkybox", Parent=workspace})
        local ok, anim = pcall(BUILD[Sky.mode], EC)
        if not ok then
            warn("[Shy] skybox: " .. tostring(anim)); teardown(); restoreLighting(); Sky.mode = "Off"
            return
        end
        Sky.anim = anim
        local parts, cfs = {}, {}
        for i, e in ipairs(Sky.ents) do parts[i] = e.p end
        local t = 0
        Sky.conn = RS.RenderStepped:Connect(function(dt)
            t += dt
            local ok2, err = pcall(Sky.anim, t, dt)
            if not ok2 and not Sky.warned then Sky.warned = true; warn("[Shy] skybox: " .. tostring(err)) end
            if Lighting.ClockTime ~= 0 then Lighting.ClockTime = 0 end
            local o = CFrame.new(workspace.CurrentCamera.CFrame.Position)
            for i, e in ipairs(Sky.ents) do cfs[i] = o * e.cf end
            workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
        end)
    end
    Fn.skyRecolor = function() if Sky.mode ~= "Off" then Fn.setSky(Sky.mode) end end
end

