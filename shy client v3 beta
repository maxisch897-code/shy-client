        if feat.halo then
            local anchor = char:FindFirstChild("Head") or hrp
            local model = new("Model",{Name="ShyHalo",Parent=workspace})
            local R, SEG = 1.05, 40
            local layers = {
                {0.16, 0.09, 0.0, EC:Lerp(Color3.new(1,1,1), 0.25)},
                {0.42, 0.04, 0.72, EC},
                {0.8, 0.03, 0.88, EC},
            }
            local parts, locals, core = {}, {}, {}
            for li, L in ipairs(layers) do
                for i = 1, SEG do
                    local th = i / SEG * math.pi * 2
