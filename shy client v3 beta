            }),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.1),NumberSequenceKeypoint.new(1,1)}),LightEmission=1,Parent=hrp})
            vfxObj.fireL = new("PointLight",{Color=EC,Range=18,Brightness=4,Parent=hrp})
        end
        if feat.sparkle then
            vfxObj.sparkle = new("ParticleEmitter",{Texture="rbxassetid://243098098",Rate=25,Lifetime=NumberRange.new(1.2,2.2),Speed=NumberRange.new(0,0.5),SpreadAngle=Vector2.new(180,180),Color=ColorSequence.new({ColorSequenceKeypoint.new(0,EC:Lerp(Color3.new(1,1,1),0.4)),ColorSequenceKeypoint.new(1,EC)}),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(0.4,0.7),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}),LightEmission=1,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-50,50),Parent=hrp})
