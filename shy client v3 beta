            vfxObj.trail = new("Trail",{Attachment0=a0,Attachment1=a1,Lifetime=1.2,LightEmission=1,Color=ColorSequence.new(EC),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.15),NumberSequenceKeypoint.new(1,1)}),WidthScale=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}),Parent=hrp})
