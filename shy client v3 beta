-- 3D LYRICS
-- ══════════════════════════════════════════════════════════════
do
    feat.lyrics3d = false
    Lyrics.airScale = 1.6
    local A = {}
    Lyrics.A = A
    local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)

    local function esc(c) return (c:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end

    local function build()
        A.part = new("Part", {Name="ShyLyrics3D", Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Transparency=1, Size=Vector3.new(16, 3, 0.05), Parent=workspace.CurrentCamera})
        A.sg = new("SurfaceGui", {Name="ShyLyrics3D", Face=Enum.NormalId.Front, Adornee=A.part, SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud=60, LightInfluence=0, AlwaysOnTop=false, Enabled=false, Parent=A.part})
        A.holder = new("Frame", {BackgroundTransparency=1, Size=UDim2.fromScale(1, 1), Parent=A.sg})
        A.scale = new("UIScale", {Scale=1, Parent=A.holder})
        A.shadow = new("TextLabel", {BackgroundTransparency=1, Size=UDim2.fromScale(1, 1), Position=UDim2.fromOffset(4, 6), FontFace=FONT, TextScaled=true, RichText=true, Text="", TextColor3=Color3.new(0, 0, 0), TextTransparency=0.55, ZIndex=1, Parent=A.holder})
        A.lbl = new("TextLabel", {BackgroundTransparency=1, Size=UDim2.fromScale(1, 1), FontFace=FONT, TextScaled=true, RichText=true, Text="", TextColor3=Color3.new(1, 1, 1), ZIndex=2, Parent=A.holder})
        A.glow = new("UIStroke", {Color=T.Accent, Thickness=3, Transparency=0.6, Parent=A.lbl})
        new("UITextSizeConstraint", {MaxTextSize=130, Parent=A.lbl})
        new("UITextSizeConstraint", {MaxTextSize=130, Parent=A.shadow})
    end

    local function hide()
        if A.sg then A.sg.Enabled = false end
        A.idx, A.pos = nil, nil
    end

    local function pickSpot(cam, hrp)
        local vp = cam.ViewportSize
        local ps = cam:WorldToViewportPoint(hrp.Position)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {player.Character, A.part}
        for _ = 1, 16 do
            local sx = vp.X * (0.28 + math.random() * 0.44)
            local sy = vp.Y * (0.14 + math.random() * 0.36)
            if ps.Z <= 0 or (Vector2.new(sx, sy) - Vector2.new(ps.X, ps.Y)).Magnitude > vp.Y * 0.25 then
                local ray = cam:ViewportPointToRay(sx, sy)
                local dist = 16 + math.random() * 10
                local hit = workspace:Raycast(ray.Origin, ray.Direction * dist, params)
                if hit then dist = (hit.Position - ray.Origin).Magnitude - 2 end
                if dist >= 9 then return ray.Origin + ray.Direction * dist end
            end
        end
        local cf = cam.CFrame
        return cf.Position + cf.LookVector * 18 + cf.UpVector * 5 + cf.RightVector * (math.random() < 0.5 and -6 or 6)
    end

    local function respawn(cam, hrp)
        A.pos = pickSpot(cam, hrp)
        A.tilt = CFrame.Angles(0, math.rad((math.random() < 0.5 and -1 or 1) * (8 + math.random() * 14)), math.rad((math.random() - 0.5) * 8))
        A.lost, A.bob = 0, math.random() * 6
        A.scale.Scale = 0.6
        TS:Create(A.scale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
    end

    RS.RenderStepped:Connect(function(dt)
        if not feat.lyrics3d then if A.sg and A.sg.Enabled then hide() end return end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local lines = Lyrics.lines
        if not hrp or #lines == 0 or not (Music.sound and Music.sound.IsPlaying) then hide() return end
        local pos = Music.sound.TimePosition + Lyrics.offset
        local idx = 0
        for i = 1, #lines do if lines[i].t <= pos then idx = i else break end end
        if idx == 0 then hide() return end
        if not A.part or not A.part.Parent then build() end

        local L = lines[idx]
        local t1 = lines[idx + 1] and lines[idx + 1].t or (L.t + 4)
        if A.idx ~= idx then
            A.idx, A.key = idx, nil
            A.chars = {}
            local str = string.upper(table.concat(L.words, " "))
            if not pcall(function() for _, c in utf8.codes(str) do A.chars[#A.chars + 1] = utf8.char(c) end end) then
                A.chars = {}
                for i = 1, #str do A.chars[i] = str:sub(i, i) end
            end
            respawn(workspace.CurrentCamera, hrp)
        end

        local n = #A.chars
        local reveal = math.clamp((pos - L.t) / math.max(math.min(t1 - L.t, 6) * 0.55, 0.2), 0, 1)
        local nf = reveal * n
        local shown = math.floor(nf)
        local frac = nf - shown
        local key = shown * 8 + math.floor(frac * 8)
        if A.key ~= key then
            A.key = key
            local done = {}
            for i = 1, shown do done[i] = esc(A.chars[i]) end
            local solid = table.concat(done)
            local nxt = A.chars[shown + 1]
            A.lbl.Text = nxt and (solid .. string.format('<font transparency="%.2f">%s</font>', 1 - frac, esc(nxt))) or solid
            A.shadow.Text = solid
        end

        local fade = 1 - math.clamp((t1 - pos) / 0.3, 0, 1)
        A.lbl.TextTransparency = fade
        A.shadow.TextTransparency = 0.55 + 0.45 * fade
        A.glow.Transparency = 0.6 + 0.4 * fade
        A.glow.Color = T.Accent

        local cam = workspace.CurrentCamera
        local camPos = cam.CFrame.Position
        local sp, onScreen = cam:WorldToViewportPoint(A.pos)
        local ps = cam:WorldToViewportPoint(hrp.Position)
        local bad = not onScreen or sp.Z < 5 or (A.pos - camPos).Magnitude > 50
            or (ps.Z > 0 and (Vector2.new(sp.X, sp.Y) - Vector2.new(ps.X, ps.Y)).Magnitude < cam.ViewportSize.Y * 0.15)
        A.chk = (A.chk or 0) + dt
        if not bad and A.chk > 0.25 then
            A.chk = 0
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {player.Character, A.part}
            if workspace:Raycast(camPos, A.pos - camPos, params) then bad = true end
        end
        A.lost = bad and (A.lost + dt) or 0
        if A.lost > 0.4 then respawn(cam, hrp) end

        local s = Lyrics.airScale
        A.part.Size = Vector3.new(10 * s, 1.9 * s, 0.05)
        local p = A.pos + Vector3.new(0, math.sin(os.clock() * 1.4 + A.bob) * 0.25, 0)
        A.part.CFrame = CFrame.lookAt(p, camPos) * A.tilt
        A.sg.Enabled = true
    end)
end

