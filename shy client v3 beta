do
    local SG = {panels = {}}
    Glass.SG = SG
    local PCA = Glass.pca
    local MAX_CELLS, OUT_PX, MAX_OUT = 9000, 2, 60000
    local SAT, LIFT = 1.3, 0.85
    SG.budget = 3e-3
    local exp, clamp, floor, ceil, min, max, clock = math.exp, math.clamp, math.floor, math.ceil, math.min, math.max, os.clock
    local CH = {"tR", "tG", "tB", "cR", "cG", "cB"}

    local function trunc(x) if x >= 0 then return floor(x) end return ceil(x) end
    local function gcd(a, b) while b ~= 0 do a, b = b, a % b end return a end
    local function pickStride(n)
        local s = max(1, floor(n * 0.618))
        while s > 1 and gcd(s, n) ~= 1 do s -= 1 end
        return s
    end
    local function rrect(px, py, W, H, R)
        local hx, hy = W * 0.5, H * 0.5
        local dx, dy = px - hx, py - hy
        local ax, ay = math.abs(dx) - (hx - R), math.abs(dy) - (hy - R)
        local sx, sy = dx < 0 and 1 or -1, dy < 0 and 1 or -1
        if ax > 0 and ay > 0 then
            local l = math.sqrt(ax * ax + ay * ay)
            return R - l, sx * ax / l, sy * ay / l
        elseif ax > ay then return R - ax, sx, 0 end
        return R - ay, 0, sy
    end
    local function freeImg(P) if P.img then pcall(function() P.img:Destroy() end); P.img = nil end end
    local function axis(count, cells)
        local i0, i1, fr = table.create(count, 1), table.create(count, 1), table.create(count, 0)
        for x = 1, count do
            local g = clamp((x - 0.5) * cells / count - 0.5, 0, cells - 1)
            local a = floor(g)
            i0[x], i1[x], fr[x] = a + 1, min(a + 1, cells - 1) + 1, g - a
        end
        return i0, i1, fr
    end

    local function rebuild(P)
        local size = P.frame.AbsoluteSize
        P.lastBuild = clock()
        if size.X < 8 or size.Y < 8 then return end
        local c = 3 + Glass.blur * 0.5
        local gw, gh = max(2, ceil(size.X / c)), max(2, ceil(size.Y / c))
        if gw * gh > MAX_CELLS then
            local s = math.sqrt(MAX_CELLS / (gw * gh))
            gw, gh = max(2, floor(gw * s)), max(2, floor(gh * s))
        end
        local ow, oh = max(gw, ceil(size.X / OUT_PX)), max(gh, ceil(size.Y / OUT_PX))
        if ow * oh > MAX_OUT then
            local s = math.sqrt(MAX_OUT / (ow * oh))
            ow, oh = max(gw, floor(ow * s)), max(gh, floor(oh * s))
        end
        P.sizeX, P.sizeY = size.X, size.Y
        P.band = min(42, min(size.X, size.Y) * 0.45)
        if not (P.img and P.ow == ow and P.oh == oh) then
            local res = Vector2.new(ow, oh)
            local ok, img = pcall(AssetService.CreateEditableImage, AssetService, {Size = res})
            if not (ok and img) and P.img then
                freeImg(P)
                ok, img = pcall(AssetService.CreateEditableImage, AssetService, {Size = res})
            end
            if not (ok and img) then P.gw = nil; return end
            freeImg(P)
            P.img, P.res, P.ow, P.oh = img, res, ow, oh
            P.pane.ImageContent = Content.fromObject(img)
            P.out = buffer.create(ow * oh * 4)
        end
        if P.gw ~= gw or P.gh ~= gh then
            local n = gw * gh
            local tint = P.frame.BackgroundColor3
            local fresh = {}
            for k, name in ipairs(CH) do
                fresh[name] = table.create(n, (k % 3 == 1 and tint.R) or (k % 3 == 2 and tint.G) or tint.B)
            end
            if P.gw then
                local ogw, ogh = P.gw, P.gh
                for y = 0, gh - 1 do
                    local oy = min(ogh - 1, floor((y + 0.5) * ogh / gh))
                    for x = 0, gw - 1 do
                        local j = oy * ogw + min(ogw - 1, floor((x + 0.5) * ogw / gw)) + 1
                        local i = y * gw + x + 1
                        for _, name in ipairs(CH) do fresh[name][i] = P[name][j] end
                    end
                end
            end
            for _, name in ipairs(CH) do P[name] = fresh[name] end
            P.gw, P.gh, P.n = gw, gh, n
            P.hR, P.hG, P.hB = table.create(n, 0), table.create(n, 0), table.create(n, 0)
            P.bR, P.bG, P.bB = table.create(n, 0), table.create(n, 0), table.create(n, 0)
            P.rowR, P.rowG, P.rowB = table.create(gw, 0), table.create(gw, 0), table.create(gw, 0)
            P.queue, P.queued, P.qh, P.idx, P.stride = {}, {}, 1, 0, pickStride(n)
        end
        P.cx0, P.cx1, P.cfx = axis(ow, gw)
        P.ry0, P.ry1, P.rfy = axis(oh, gh)
        local R, W, H = P.radius, size.X, size.Y
        local rim = table.create(ow * oh, 0)
        for y = 0, oh - 1 do
            local v = (y + 0.5) / oh
            local py = v * H
            local sheen = (1 - v) ^ 3 * 0.05
            for x = 0, ow - 1 do
                local d, nx, ny = rrect((x + 0.5) / ow * W, py, W, H, R)
                local lit = nx * 0.55 + ny * 0.83
                local spec = (0.10 + 0.40 * max(lit, 0) + 0.18 * max(-lit, 0)) * clamp(1 - d / 5, 0, 1)
                local glow = clamp(1 - d / 26, 0, 1)
                rim[y * ow + x + 1] = spec + glow * glow * 0.07 + sheen
            end
        end
        P.rim = rim
        P.dirty = true
    end

    local function push(P, k) if not P.queued[k] then P.queued[k] = true; P.queue[#P.queue + 1] = k end end
    local function nextCell(P)
        local q = P.queue
        while P.qh <= #q do
            local k = q[P.qh]; P.qh += 1; P.queued[k] = nil
            if k < P.n then return k end
        end
        if P.qh > 1 then table.clear(q); P.qh = 1 end
        local k = P.idx
        P.idx = (k + P.stride) % P.n
        return k
    end

    local function shiftGrid(P, sx, sy)
        local gw, gh, n = P.gw, P.gh, P.n
        for _, name in ipairs(CH) do
            local src, dst = P[name], table.create(n, 0)
            for y = 0, gh - 1 do
                local row = clamp(y + sy, 0, gh - 1) * gw + 1
                local base = y * gw + 1
                for x = 0, gw - 1 do dst[base + x] = src[row + clamp(x + sx, 0, gw - 1)] end
            end
            P[name] = dst
        end
        for y = 0, gh - 1 do
            local oy = y + sy
            for x = 0, gw - 1 do
                local ox = x + sx
                if ox < 0 or ox >= gw or oy < 0 or oy >= gh then push(P, y * gw + x) end
            end
        end
        P.dirty = true
    end

    local function sampleCell(P, k, ox, oy)
        local gw, gh = P.gw, P.gh
        local u, v = (k % gw + 0.5) / gw, (k // gw + 0.5) / gh
        local W, H = P.sizeX, P.sizeY
        local sx, sy = u * W, v * H
        local d, nx, ny = rrect(sx, sy, W, H, P.radius)
        local band = P.band
        if d < band then
            local t = 1 - max(d, 0) / band
            local p = t * t * band * 0.2 * Glass.refraction
            sx += nx * p; sy += ny * p
        end
        local r, g, b = PCA:GetColorXY(ox + sx, oy + sy, P.pane, P.cellW)
        local i = k + 1
        P.tR[i], P.tG[i], P.tB[i] = r, g, b
    end

    local function composite(P, a)
        local tint = P.frame.BackgroundColor3
        local ta = clamp(1 - (P.t or 0.6), 0, 1)
        local changed = P.dirty or P.lastTint ~= tint or P.lastTa ~= ta
        P.dirty, P.lastTint, P.lastTa = false, tint, ta
        local tR, tG, tB, cR, cG, cB = P.tR, P.tG, P.tB, P.cR, P.cG, P.cB
        local moved = false
        for i = 1, P.n do
            local dr, dg, db = tR[i] - cR[i], tG[i] - cG[i], tB[i] - cB[i]
            if dr > 0.003 or dr < -0.003 or dg > 0.003 or dg < -0.003 or db > 0.003 or db < -0.003 then
                cR[i] += dr * a; cG[i] += dg * a; cB[i] += db * a
                moved = true
            end
        end
        if not (moved or changed) then return end
        local gw, gh, ow, oh = P.gw, P.gh, P.ow, P.oh
        local ia = 1 - ta
        local kR, kG, kB = tint.R * ta, tint.G * ta, tint.B * ta
        local hR, hG, hB, bR, bG, bB = P.hR, P.hG, P.hB, P.bR, P.bG, P.bB
        local wc = 0.5
        local ws = (1 - wc) * 0.5
        for y = 0, gh - 1 do
            local base = y * gw
            for x = 1, gw do
                local i = base + x
                local l, r = base + (x > 1 and x - 1 or 1), base + (x < gw and x + 1 or gw)
                hR[i] = (cR[l] + cR[r]) * ws + cR[i] * wc
                hG[i] = (cG[l] + cG[r]) * ws + cG[i] * wc
                hB[i] = (cB[l] + cB[r]) * ws + cB[i] * wc
            end
        end
        for y = 0, gh - 1 do
            local base = y * gw
            local up, dn = (y > 0 and y - 1 or 0) * gw, (y < gh - 1 and y + 1 or gh - 1) * gw
            for x = 1, gw do
                local i, u, d = base + x, up + x, dn + x
                local r = (hR[u] + hR[d]) * ws + hR[i] * wc
                local g = (hG[u] + hG[d]) * ws + hG[i] * wc
                local b = (hB[u] + hB[d]) * ws + hB[i] * wc
                local L = r * 0.299 + g * 0.587 + b * 0.114
                bR[i] = max(L + (r - L) * SAT, 0) * LIFT * ia + kR
                bG[i] = max(L + (g - L) * SAT, 0) * LIFT * ia + kG
                bB[i] = max(L + (b - L) * SAT, 0) * LIFT * ia + kB
            end
        end
        local rowR, rowG, rowB = P.rowR, P.rowG, P.rowB
        local cx0, cx1, cfx, ry0, ry1, rfy = P.cx0, P.cx1, P.cfx, P.ry0, P.ry1, P.rfy
        local rim, out = P.rim, P.out
        local o, p = 0, 0
        for y = 1, oh do
            local r0, r1, fy = (ry0[y] - 1) * gw, (ry1[y] - 1) * gw, rfy[y]
            for x = 1, gw do
                local A, B = r0 + x, r1 + x
                local vA = bR[A]; rowR[x] = vA + (bR[B] - vA) * fy
                vA = bG[A]; rowG[x] = vA + (bG[B] - vA) * fy
                vA = bB[A]; rowB[x] = vA + (bB[B] - vA) * fy
            end
            for x = 1, ow do
                local i0, i1, fx = cx0[x], cx1[x], cfx[x]
                p += 1
                local w = rim[p]
                local v0 = rowR[i0]; local r = v0 + (rowR[i1] - v0) * fx + w
                v0 = rowG[i0]; local g = v0 + (rowG[i1] - v0) * fx + w
                v0 = rowB[i0]; local b = v0 + (rowB[i1] - v0) * fx + w
                r = r >= 1 and 255 or floor(r * 255 + 0.5)
                g = g >= 1 and 255 or floor(g * 255 + 0.5)
                b = b >= 1 and 255 or floor(b * 255 + 0.5)
                buffer.writeu32(out, o, r + g * 256 + b * 65536 + 4278190080)
                o += 4
            end
        end
        P.img:WritePixelsBuffer(Vector2.zero, P.res, out)
    end

    local function syncPane(P)
        local f, pane, g = P.frame, P.pane, P.group
        if g then
            if pane.Position ~= f.Position then pane.Position = f.Position end
            if pane.Size ~= f.Size then pane.Size = f.Size end
            if pane.ImageTransparency ~= g.GroupTransparency then pane.ImageTransparency = g.GroupTransparency end
        end
        local vis = P.on and f.Visible and P.gw ~= nil
        if pane.Visible ~= vis then pane.Visible = vis end
    end

    local active = {}
    local function step(dt)
        table.clear(active)
        local relayout = SG.relayoutAt and clock() >= SG.relayoutAt
        if relayout then SG.relayoutAt = nil end
        for _, P in pairs(SG.panels) do
            if P.on and P.frame.Parent and P.frame.Visible and (P.always or UI.isOpen) then
                local size = P.frame.AbsoluteSize
                if (not P.gw and clock() - P.lastBuild > 0.5) or (P.gw and (relayout
                    or ((size.X ~= P.sizeX or size.Y ~= P.sizeY) and clock() - P.lastBuild > 0.12))) then
                    rebuild(P)
                end
                if P.gw then
                    local pos = P.frame.AbsolutePosition
                    P.cellW, P.cellH = P.sizeX / P.gw, P.sizeY / P.gh
                    if P.lastPos then
                        P.accX += pos.X - P.lastPos.X; P.accY += pos.Y - P.lastPos.Y
                        local sx, sy = trunc(P.accX / P.cellW), trunc(P.accY / P.cellH)
                        if math.abs(sx) >= P.gw or math.abs(sy) >= P.gh then
                            P.accX, P.accY = 0, 0
                        elseif sx ~= 0 or sy ~= 0 then
                            shiftGrid(P, sx, sy)
                            P.accX -= sx * P.cellW; P.accY -= sy * P.cellH
                        end
                    else
                        P.accX, P.accY = 0, 0
                    end
                    P.lastPos = pos
                    active[#active + 1] = P
                end
            end
        end
        local np = #active
        if np == 0 then return end
        if dt > 1 / 50 then SG.budget = max(1e-3, SG.budget * 0.8) else SG.budget = min(4.5e-3, SG.budget + 0.1e-3) end
        local deadline = clock() + SG.budget
        local pi, guard = 0, 0
        repeat
            pi = pi % np + 1
            local P = active[pi]
            sampleCell(P, nextCell(P), P.lastPos.X - P.accX, P.lastPos.Y - P.accY)
            guard += 1
        until clock() >= deadline or guard >= 8000
        SG.frameN = (SG.frameN or 0) + 1
        for k, P in ipairs(active) do
            P.accDt = (P.accDt or 0) + dt
            if P.dirty or (SG.frameN + k) % 2 == 0 then
                composite(P, 1 - exp(-P.accDt * 24))
                P.accDt = 0
            end
        end
    end

    local function frameUpdate(dt)
        if Glass.on and Glass.ok then
            step(dt)
            for _, P in pairs(SG.panels) do if P.on then syncPane(P) end end
        end
        local cg = UI.canvas
        if cg then
            if Glass.on and Glass.ok and Glass.hq and UI.isOpen then
                local C = Glass.lib and Glass.lib.Config
                if C then
                    local slow = dt > 1 / 45
                    C.SAMPLE_TIME_BUDGET = slow and 3e-3 or 6e-3
                    C.LIQUID_TIME_BUDGET = slow and 5e-3 or 10e-3
                end
                SG.flip = not SG.flip
                cg.GroupColor3 = SG.flip and Color3.fromRGB(254, 254, 254) or Color3.new(1, 1, 1)
            elseif SG.flip then
                SG.flip = false
                cg.GroupColor3 = Color3.new(1, 1, 1)
            end
        end
    end

    function SG.enable(f, on, t, always)
        local P = SG.panels[f]
        if not P then
            if not on then return end
            local group = f.Parent and f.Parent:IsA("CanvasGroup") and f.Parent or nil
            local pane = new("ImageLabel", {
                Name = "ShyGlassPane", Size = group and f.Size or UDim2.fromScale(1, 1),
                Position = group and f.Position or nil, BackgroundTransparency = 1,
                ScaleType = Enum.ScaleType.Stretch, ResampleMode = Enum.ResamplerMode.Default,
                ZIndex = group and (group.ZIndex - 1) or 0, Visible = false,
                Parent = group and group.Parent or f,
            })
            local fc = f:FindFirstChildOfClass("UICorner")
            if fc then new("UICorner", {CornerRadius = fc.CornerRadius, Parent = pane}) end
            P = {frame = f, pane = pane, group = group, lastBuild = 0, radius = fc and fc.CornerRadius.Offset or 0}
            SG.panels[f] = P
        end
        P.on = on; P.always = always; P.lastPos = nil
        if on then
            P.t = t
            f.BackgroundTransparency = 1
        else
            freeImg(P); P.gw = nil; P.pane.Visible = false
        end
    end
    function SG.setT(f, t)
        local P = SG.panels[f]
        if P then P.t = t end
    end

    if Glass.ok then
        RS.RenderStepped:Connect(function(dt)
            local ok, err = pcall(frameUpdate, dt)
            if not ok and not SG.warned then SG.warned = true; warn("[Shy] glass engine: " .. tostring(err)) end
        end)
    end
end

