    local br = new("Frame",{Size=UDim2.new(1,-4,0,46),BackgroundTransparency=1,Parent=pSaves})
    new("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,8),Parent=br})
    local sb = new("TextButton",{Size=UDim2.new(0.5,-4,1,0),BackgroundColor3=Color3.fromRGB(255,255,255),Text="Save",Font=Enum.Font.GothamBold,TextColor3=ON_ACCENT,TextSize=12,BorderSizePixel=0,AutoButtonColor=false,Parent=br})
    corner(sb, RM); gradient(sb, T.Accent, T.Accent2, 0)
    sb.MouseButton1Click:Connect(function() doSave((ni.Text:gsub("^%s+", ""):gsub("%s+$", ""))) end)
    local qs = new("TextButton",{Size=UDim2.new(0.5,-4,1,0),BackgroundColor3=T.Card,BackgroundTransparency=TR.Card,Text="Quick Save",Font=Enum.Font.GothamBold,TextColor3=T.Text,TextSize=12,BorderSizePixel=0,AutoButtonColor=false,Parent=br})
    corner(qs, RM); stroke(qs, 1, 0.55, T.Line)
    regRef(qs, "BackgroundColor3", "Card"); regRef(qs, "TextColor3", "Text"); regCard(qs)
    qs.MouseButton1Click:Connect(function() doSave("Slot " .. (#SaveOrder + 1)) end)
    hdr(pSaves, "Saved Slots")
    local sl = new("Frame",{Size=UDim2.new(1,-4,0,0),BackgroundTransparency=1,AutomaticSize=Enum.AutomaticSize.Y,Parent=pSaves})
    new("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,6),Parent=sl})
    refreshList = function()
        for _, c in ipairs(sl:GetChildren()) do if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end end
        if #SaveOrder == 0 then
            local e = new("TextLabel",{Size=UDim2.new(1,0,0,42),BackgroundColor3=T.Card,BackgroundTransparency=TR.Card,Font=Enum.Font.Gotham,Text="No saves yet",TextColor3=T.Muted,TextSize=11,BorderSizePixel=0,Parent=sl})
            corner(e, RM); stroke(e, 1, 0.55, T.Line); regRef(e, "BackgroundColor3", "Card"); regCard(e)
