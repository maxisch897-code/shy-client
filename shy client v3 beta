end

-- MORE ---------------------------------------------------------
do
    local flinging = false
    local function findPlayerByName(query)
        query = tostring(query or ""):gsub("^%s+", ""):gsub("%s+$", ""):lower()
        if query == "" then return nil end
        local partial = nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local n, d = p.Name:lower(), p.DisplayName:lower()
                if n == query or d == query then return p end
                if not partial and (n:sub(1, #query) == query or d:sub(1, #query) == query) then partial = p end
            end
        end
        if partial then return partial end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and (p.Name:lower():find(query, 1, true) or p.DisplayName:lower():find(query, 1, true)) then return p end
        end
        return nil
    end
    local function flingPlayer(target)
        if flinging then notify("Fling", "Already flinging", false) return end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then notify("Fling", "Character not ready", false) return end
        local tchar = target.Character
        local thrp = tchar and tchar:FindFirstChild("HumanoidRootPart")
        if not thrp then notify("Fling", target.Name .. " has no character", false) return end
        flinging = true
        notify("Fling", "Flinging " .. target.Name)
        local origCF = hrp.CFrame
        local saved = {}
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                saved[p] = p.CustomPhysicalProperties
                p.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
            end
        end
        local startTime = tick()
        local function finished()
            local th = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            local el = tick() - startTime
            return el > 4 or not th or not target.Parent
                or (el > 0.4 and th.AssemblyLinearVelocity.Magnitude > 300)
                or not (player.Character and player.Character:FindFirstChild("HumanoidRootPart"))
        end
        local conn
        conn = RS.Heartbeat:Connect(function()
            if finished() then return end
            local th = target.Character.HumanoidRootPart
            local mh = player.Character.HumanoidRootPart
            mh.CFrame = th.CFrame + th.AssemblyLinearVelocity * 0.1
            mh.AssemblyAngularVelocity = Vector3.new(0, 1e5, 0)
            mh.AssemblyLinearVelocity = Vector3.zero
        end)
        task.spawn(function()
            while not finished() do task.wait(0.03) end
            conn:Disconnect()
            local h2 = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if h2 then
                for _ = 1, 10 do
                    h2.AssemblyAngularVelocity = Vector3.zero
                    h2.AssemblyLinearVelocity = Vector3.zero
                    h2.CFrame = origCF
                    task.wait()
                end
                for p, props in pairs(saved) do if p and p.Parent then p.CustomPhysicalProperties = props end end
            end
            flinging = false
            notify("Fling", "Done: " .. target.Name)
        end)
    end
    hdr(pMore, "Fling Player")
    local flingInput = mkInput(pMore, "Player Name", "username")
    local function doFling()
        local target = findPlayerByName(flingInput.Text)
        if not target then notify("Fling", "Player not found", false) return end
        flingPlayer(target)
    end
    mkAccentBtn(pMore, "Fling", doFling, 44)
    flingInput.FocusLost:Connect(function(enter) if enter then doFling() end end)
    local hint = new("TextLabel",{Size=UDim2.new(1,-4,0,44),BackgroundColor3=T.Card,BackgroundTransparency=TR.Card,Font=Enum.Font.Gotham,
        Text="  Type a name or display name (partial works). You return to your spot afterwards.",
        TextColor3=T.Dim,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,TextWrapped=true,BorderSizePixel=0,Parent=pMore})
    corner(hint, RM); stroke(hint, 1, 0.55, T.Line); regRef(hint, "BackgroundColor3", "Card"); regRef(hint, "TextColor3", "Dim"); regCard(hint)
end

