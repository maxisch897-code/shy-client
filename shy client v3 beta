        if ok and type(d) == "table" then
            local name = "Imported " .. (#SaveOrder + 1)
            Saves[name] = d; table.insert(SaveOrder, name)
            save(); if refreshList then refreshList() end
            ii.Text = ""
            notify("Import", "Imported: " .. name)
        else notify("Import", "Invalid JSON", false) end
    end)
