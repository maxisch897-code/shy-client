local openKeyPrompt
do
    local promptGui = new("ScreenGui", {Name="ShyPrompt",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,Parent=pg})

    openKeyPrompt = function(name)
        for _, c in ipairs(promptGui:GetChildren()) do c:Destroy() end
        local bg = new("Frame", {Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.fromRGB(0,0,0),BackgroundTransparency=0.5,BorderSizePixel=0,ZIndex=100,Parent=promptGui})
        local box = new("Frame", {Size=UDim2.new(0,340,0,120),Position=UDim2.new(0.5,-170,0.5,-60),BackgroundColor3=T.Panel,BackgroundTransparency=0.05,BorderSizePixel=0,ZIndex=101,Parent=bg})
        corner(box, RB); stroke(box, 1, 0.5, T.Line, true)
        local stripe = new("Frame",{Size=UDim2.new(1,0,0,3),BackgroundColor3=T.Accent,BorderSizePixel=0,ZIndex=102,Parent=box})
        corner(stripe, RB); gradient(stripe, T.Accent, T.Accent2, 0)
        new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,0,0,20),Size=UDim2.new(1,0,0,22),Font=Enum.Font.GothamBold,Text="PRESS A KEY",TextColor3=T.Text,TextSize=14,ZIndex=102,Parent=box})
        new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,0,0,48),Size=UDim2.new(1,0,0,18),Font=Enum.Font.GothamMedium,Text=name,TextColor3=T.Accent,TextSize=12,ZIndex=102,Parent=box})
        new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,0,0,78),Size=UDim2.new(1,0,0,16),Font=Enum.Font.Gotham,Text="ESC cancel  •  BACKSPACE clear",TextColor3=T.Muted,TextSize=10,ZIndex=102,Parent=box})
        local cn
        cn = UIS.InputBegan:Connect(function(i, gp)
            if i.KeyCode == Enum.KeyCode.Escape then cn:Disconnect(); bg:Destroy()
            elseif i.KeyCode == Enum.KeyCode.Backspace then
                if Keybinds[name] then Keybinds[name].key = nil end
                cn:Disconnect(); bg:Destroy(); notify("Keybind", name.." cleared")
            elseif not gp and i.KeyCode ~= Enum.KeyCode.Unknown then
                if Keybinds[name] then Keybinds[name].key = i.KeyCode end
                cn:Disconnect(); bg:Destroy(); notify("Keybind", name.." → "..i.KeyCode.Name)
            end
        end)
    end

    UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Enum.KeyCode.RightShift then return end
        for _, k in pairs(Keybinds) do
            if k.key and i.KeyCode == k.key then
                if k.isToggle then k.setState(not k.getState())
                elseif k.fire then pcall(k.fire) end
                break
            end
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- FLY / NOCLIP / INFJUMP
-- ══════════════════════════════════════════════════════════════
do
    local flyBV, flyVel = nil, Vector3.zero

    Fn.startFly = function()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then notify("Fly", "Character not ready", false); return end
        feat.fly = true; flyVel = Vector3.zero
        if flyBV then flyBV:Destroy() end
        flyBV = new("BodyVelocity", {MaxForce=Vector3.new(1e5,1e5,1e5), Velocity=Vector3.zero, P=1250, Parent=hrp})
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = true end
        notify("Fly", "ON")
    end

    Fn.stopFly = function()
        feat.fly = false
        if flyBV then flyBV:Destroy(); flyBV = nil end
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        flyVel = Vector3.zero
        notify("Fly", "OFF", false)
    end

    player.CharacterAdded:Connect(function() if feat.fly then task.wait(0.5); Fn.startFly() end end)

    RS.Heartbeat:Connect(function(dt)
        if not flyBV then return end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then flyBV:Destroy(); flyBV = nil; return end
        if flyBV.Parent ~= hrp then flyBV.Parent = hrp end
        local cf = camera.CFrame
        local camLook = cf.LookVector
        if camLook.Magnitude > 0.01 then
            camLook = camLook.Unit
            local clamped = Vector3.new(camLook.X, math.clamp(camLook.Y, -feat.flyPitchAmount, feat.flyPitchAmount), camLook.Z)
            if clamped.Magnitude > 0.01 then
                clamped = clamped.Unit
                hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + clamped)
            end
        end
        local look, right = cf.LookVector, cf.RightVector
        local input = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then input += look end
        if UIS:IsKeyDown(Enum.KeyCode.S) then input -= look end
        if UIS:IsKeyDown(Enum.KeyCode.A) then input -= right end
        if UIS:IsKeyDown(Enum.KeyCode.D) then input += right end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then input += Vector3.new(0,1,0) * feat.flyVerticalBoost end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then input -= Vector3.new(0,1,0) * feat.flyVerticalBoost end
        if input.Magnitude > 1 then input = input.Unit end
        local targetVel = input * feat.flySpeed
        local rate = (input.Magnitude > 0.05) and feat.flyAccel or feat.flyDamping
        flyVel = flyVel:Lerp(targetVel, math.clamp(rate * dt, 0, 1))
        flyBV.Velocity = flyVel
    end)

    RS.Stepped:Connect(function()
        if not feat.noclip then return end
        local c = player.Character; if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
        end
    end)

    UIS.JumpRequest:Connect(function()
        if feat.infJump then
            local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- FREE CAM
-- ══════════════════════════════════════════════════════════════
do
    local fcConn, fcYaw, fcPitch = nil, 0, 0
    local fcPos = Vector3.new(0,0,0)
    local fcSaved = { anchored=false, walkSpeed=16, jumpPower=50 }

    local function freezePlayer()
        local char = player.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then
            fcSaved.anchored = hrp.Anchored
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.Anchored = true
        end
        if hum then
            fcSaved.walkSpeed = hum.WalkSpeed
            fcSaved.jumpPower = hum.JumpPower
            hum.WalkSpeed = 0; hum.JumpPower = 0; hum.AutoRotate = false
        end
    end

    local function unfreezePlayer()
        local char = player.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then hrp.Anchored = fcSaved.anchored end
        if hum then
            hum.WalkSpeed = feat.walkSpeed or fcSaved.walkSpeed
            hum.JumpPower = feat.jumpPower or fcSaved.jumpPower
            hum.AutoRotate = true
        end
    end

    Fn.startFreeCam = function()
        local kb = Keybinds["FreeCam"]
        if not (kb and kb.key) then notify("Free Cam", "Set a keybind first to enable Free Cam", false); return false end
        local x, y = camera.CFrame:ToEulerAnglesYXZ(); fcYaw, fcPitch = y, x
        fcPos = camera.CFrame.Position
        camera.CameraType = Enum.CameraType.Scriptable
        feat.freeCam = true
        UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
        freezePlayer()
        fcConn = RS.RenderStepped:Connect(function(dt)
            local d = Vector3.zero
            local cf = CFrame.new(fcPos) * CFrame.Angles(0, fcYaw, 0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then d += cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then d += cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d -= Vector3.new(0,1,0) end
            if d.Magnitude > 0 then fcPos += d.Unit * feat.freeCamSpeed * dt end
            camera.CFrame = CFrame.new(fcPos) * CFrame.Angles(0, fcYaw, 0) * CFrame.Angles(fcPitch, 0, 0)
        end)
        notify("Free Cam", "ON — press your keybind to exit")
        return true
    end

    Fn.stopFreeCam = function()
        feat.freeCam = false
        if fcConn then fcConn:Disconnect(); fcConn = nil end
        camera.CameraType = Enum.CameraType.Custom
        UIS.MouseBehavior = Enum.MouseBehavior.Default
        unfreezePlayer()
        notify("Free Cam", "OFF", false)
    end

    UIS.InputChanged:Connect(function(i)
        if not fcConn then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement then
            fcYaw = fcYaw - math.rad(i.Delta.X) * 1.5
            fcPitch = math.clamp(fcPitch - math.rad(i.Delta.Y) * 1.5, math.rad(-89), math.rad(89))
        end
    end)

    player.CharacterAdded:Connect(function()
        if feat.freeCam then task.wait(0.6); if feat.freeCam then freezePlayer() end end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- PLAYER TRANSPARENCY
-- ══════════════════════════════════════════════════════════════
do
    local tracked = setmetatable({}, { __mode = "k" })
    local charConn = nil

    local function registerPart(d) if d:IsA("BasePart") then tracked[d] = true end end

    local function hookCharacter(char)
        if charConn then charConn:Disconnect(); charConn = nil end
        for k in pairs(tracked) do tracked[k] = nil end
        for _, d in ipairs(char:GetDescendants()) do registerPart(d) end
        charConn = char.DescendantAdded:Connect(registerPart)
    end

    if player.Character then hookCharacter(player.Character) end
    player.CharacterAdded:Connect(function(c) task.wait(0.15); hookCharacter(c) end)

    RS.RenderStepped:Connect(function()
        if not feat.playerTransparency then
            for p in pairs(tracked) do
                if p.Parent and p.LocalTransparencyModifier ~= 0 then p.LocalTransparencyModifier = 0 end
            end
            return
        end
        local alpha = math.clamp(feat.playerTransparencyAmount / 100, 0, 1)
        for p in pairs(tracked) do
            if p.Parent and p.LocalTransparencyModifier ~= alpha then
                p.LocalTransparencyModifier = alpha
            end
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- VFX (body effects)
-- ══════════════════════════════════════════════════════════════
do
    local vfxObj = {}
    local function clearVfx()
        if vfxObj.neonOrig then
            for p, m in pairs(vfxObj.neonOrig) do
                if p and p.Parent then
                    p.Material = m
                    p.Color = vfxObj.neonColor and vfxObj.neonColor[p] or p.Color
                end
            end
            vfxObj.neonOrig = nil
            vfxObj.neonColor = nil
        end
        for _, o in pairs(vfxObj) do
            if typeof(o) == "Instance" then pcall(function() o:Destroy() end)
            elseif typeof(o) == "RBXScriptConnection" then pcall(function() o:Disconnect() end) end
        end
        vfxObj = {}
    end

    local function ring(pos, col, sz)
        local p = new("Part",{Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,Shape=Enum.PartType.Cylinder,Size=Vector3.new(0.3,sz,sz),CFrame=CFrame.new(pos)*CFrame.Angles(0,0,math.rad(90)),Material=Enum.Material.Neon,Color=col,Transparency=0.15,Parent=workspace})
        local t = TS:Create(p,TweenInfo.new(0.7,Enum.EasingStyle.Quint),{Size=Vector3.new(0.1,sz*4,sz*4),Transparency=1})
        t:Play(); t.Completed:Connect(function() p:Destroy() end)
    end

    Fn.rebuildVFX = function()
        clearVfx()
        local char = player.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        local EC = EFFECT_COLOR

        if feat.glow then
