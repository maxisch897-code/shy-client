-- ══════════════════════════════════════════════════════════════
do
    local scGui = new("ScreenGui", {Name="ShyScreenFX", ResetOnSpawn=false, IgnoreGuiInset=true, ZIndexBehavior=Enum.ZIndexBehavior.Sibling, Parent=pg})
