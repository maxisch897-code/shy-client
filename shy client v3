    end
    Friends.load()
    Friends.isFavourite = function(userId) return Friends.favourites[userId] == true end
    Friends.toggleFavourite = function(userId)
        if Friends.favourites[userId] then Friends.favourites[userId] = nil
        else Friends.favourites[userId] = true end
        Friends.save()
        if Friends.refreshList then Friends.refreshList() end
    end
    Friends.refresh = function(cb)
        task.spawn(function()
            local out = {}
            local ok, pages = pcall(function() return Players:GetFriendsAsync(player.UserId) end)
            if ok and pages then
                while true do
                    local cur = pages:GetCurrentPage()
                    for _, f in ipairs(cur) do
                        out[#out + 1] = {
                            userId = f.Id, username = f.Username, displayName = f.DisplayName,
                            isOnline = f.IsOnline, isFavourite = Friends.isFavourite(f.Id),
                        }
                    end
                    if pages.IsFinished then break end
                    local adv = pcall(function() pages:AdvanceToNextPageAsync() end)
                    if not adv then break end
                end
            end
            table.sort(out, function(a, b)
                if a.isFavourite ~= b.isFavourite then return a.isFavourite end
                if a.isOnline ~= b.isOnline then return a.isOnline end
                return (a.displayName or a.username):lower() < (b.displayName or b.username):lower()
            end)
            Friends.list = out
            if cb then cb() end
            if Friends.refreshList then Friends.refreshList() end
        end)
    end
    Friends.getChat = function(userId)
        Friends.chats[userId] = Friends.chats[userId] or {}
        return Friends.chats[userId]
    end
    Friends.addMessage = function(userId, from, text, ts)
        local chat = Friends.getChat(userId)
        chat[#chat + 1] = {from = from, text = text, time = ts or os.time()}
        Friends.save()
        if Friends.activeChat == userId and Friends.renderChat then Friends.renderChat() end
    end
    Friends.sendToPeer = function(userId, text)
        Friends.addMessage(userId, "me", text)
        if Friends.RELAY_URL == "" or not req then return end
        task.spawn(function()
            pcall(req, {
                Url = Friends.RELAY_URL .. "/send",
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({
                    from = player.UserId,
                    fromName = player.Name,
                    to = userId,
                    text = text,
                    ts = os.time(),
                }),
            })
        end)
    end
    task.spawn(function()
        while true do
            task.wait(3)
            if Friends.RELAY_URL == "" or not req then continue end
            local ok, res = pcall(req, {
                Url = Friends.RELAY_URL .. "/inbox?user=" .. player.UserId .. "&since=" .. tostring(Friends.lastPoll or 0),
                Method = "GET",
            })
            if not (ok and type(res) == "table" and res.Body) then continue end
            local ok2, msgs = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if not (ok2 and type(msgs) == "table") then continue end
            for _, m in ipairs(msgs) do
                if m.from and m.text then
                    Friends.addMessage(m.from, m.from, m.text, m.ts)
                    if m.ts and m.ts > (Friends.lastPoll or 0) then Friends.lastPoll = m.ts end
                end
            end
        end
    end)
end

