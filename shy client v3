                    p.Color = EFFECT_COLOR
                end
            end
        else
            for p, mat in pairs(neonSaved) do
                if p and p.Parent then p.Material = mat end
            end
            table.clear(neonSaved)
        end
    end
    local function hookNeonOnChar(char)
        if neonConn then neonConn:Disconnect(); neonConn = nil end
        if not char then return end
        Fn.applyNeonBody()
        neonConn = char.DescendantAdded:Connect(function()
            if feat.neon then task.defer(Fn.applyNeonBody) end
        end)
    end

    local function applyPartTransparency(p)
        if not p:IsA("BasePart") then return end
        if p.Name == "HumanoidRootPart" then return end
        local a = (feat.playerTransparency and (feat.playerTransparencyLevel / 100)) or 0
        p.LocalTransparencyModifier = a
    end
    Fn.applyPlayerTransparency = function()
        local char = player.Character
        if not char then return end
        for _, d in ipairs(char:GetDescendants()) do applyPartTransparency(d) end
    end
    local function hookCharTransparency(char)
        if not char then return end
        Fn.applyPlayerTransparency()
        char.DescendantAdded:Connect(function(d)
            task.defer(function() applyPartTransparency(d) end)
        end)
    end

    -- NEW: rainbow body
    local rainbowOrigColors = {}
    local rainbowConn = nil
    Fn.applyRainbowChar = function()
        local char = player.Character
        if not char then return end
        if not feat.rainbowChar then
            for p, col in pairs(rainbowOrigColors) do
                if p and p.Parent then p.Color = col end
            end
            table.clear(rainbowOrigColors)
            if rainbowConn then rainbowConn:Disconnect(); rainbowConn = nil end
            return
        end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and rainbowOrigColors[p] == nil then
                rainbowOrigColors[p] = p.Color
            end
        end
        if not rainbowConn then
            local t = 0
            rainbowConn = RS.Heartbeat:Connect(function(dt)
                if not feat.rainbowChar then return end
                t = t + dt * feat.rainbowSpeed
                local c = player.Character
                if not c then return end
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                        local hue = (t + (p.Position.X + p.Position.Z) * 0.05) % 1
                        p.Color = Color3.fromHSV(hue, 0.85, 1)
                    end
                end
            end)
        end
    end

    -- NEW: aura ring under player
    local auraRingPart = nil
    local auraRingConn = nil
    Fn.rebuildAuraRing = function()
        if auraRingPart then auraRingPart:Destroy(); auraRingPart = nil end
        if auraRingConn then auraRingConn:Disconnect(); auraRingConn = nil end
        if not feat.auraRing then return end
        auraRingPart = new("Part", {
            Name="ShyAuraRing", Shape=Enum.PartType.Cylinder, Size=Vector3.new(0.12, feat.auraRingSize, feat.auraRingSize),
            Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false,
            Material=Enum.Material.Neon, Color=EFFECT_COLOR, Transparency=0.25, Parent=workspace,
        })
        local t = 0
        auraRingConn = RS.RenderStepped:Connect(function(dt)
            t = t + dt
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp or not auraRingPart then return end
            local pulse = 1 + math.sin(t * 3) * 0.08
            auraRingPart.Size = Vector3.new(0.12, feat.auraRingSize * pulse, feat.auraRingSize * pulse)
            auraRingPart.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 2.7, 0)) * CFrame.Angles(0, 0, math.rad(90))
            auraRingPart.Color = EFFECT_COLOR
            auraRingPart.Transparency = 0.25 + math.sin(t * 4) * 0.1
        end)
    end

    -- NEW: orbiting orbs
    local orbs = {}
    local orbsConn = nil
    Fn.rebuildOrbs = function()
        for _, o in ipairs(orbs) do o:Destroy() end
        orbs = {}
        if orbsConn then orbsConn:Disconnect(); orbsConn = nil end
        if not feat.orbitOrbs then return end
        for i = 1, feat.orbitOrbCount do
            local o = new("Part", {
                Shape=Enum.PartType.Ball, Size=Vector3.new(feat.orbitOrbSize, feat.orbitOrbSize, feat.orbitOrbSize),
                Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false,
                Material=Enum.Material.Neon, Color=EFFECT_COLOR, Parent=workspace,
            })
            orbs[i] = o
        end
        local t = 0
        orbsConn = RS.RenderStepped:Connect(function(dt)
            t = t + dt * feat.orbitOrbSpeed
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local n = #orbs
            for i, o in ipairs(orbs) do
                if not o.Parent then continue end
                local angle = t + (i - 1) / n * math.pi * 2
                local height = math.sin(t * 2 + i) * 0.5
                local pos = hrp.Position + Vector3.new(math.cos(angle) * feat.orbitOrbRadius, height, math.sin(angle) * feat.orbitOrbRadius)
                o.CFrame = CFrame.new(pos)
                o.Color = EFFECT_COLOR
            end
        end)
    end

    -- NEW: lightning aura
    local lightningConn = nil
    local lightningAcc = 0
    local function spawnLightningArc(hrp)
        local from = hrp.Position + Vector3.new(math.random(-2, 2), math.random(-2, 2), math.random(-2, 2))
        local to = hrp.Position + Vector3.new(math.random(-2, 2), math.random(-2, 2), math.random(-2, 2))
        local mid = (from + to) / 2 + Vector3.new((math.random()-0.5)*2, (math.random()-0.5)*2, (math.random()-0.5)*2)
        local length = (from - to).Magnitude
        local a = new("Part", {Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false,
            Material=Enum.Material.Neon, Color=EFFECT_COLOR, Size=Vector3.new(0.12, 0.12, length),
            CFrame=CFrame.lookAt(mid, to), Transparency=0.1, Parent=workspace})
        TS:Create(a, TweenInfo.new(0.18), {Transparency=1, Size=Vector3.new(0.02,0.02,length)}):Play()
        task.delay(0.2, function() if a then a:Destroy() end end)
    end
    Fn.rebuildLightning = function()
        if lightningConn then lightningConn:Disconnect(); lightningConn = nil end
        if not feat.lightningAura then return end
        lightningAcc = 0
        lightningConn = RS.Heartbeat:Connect(function(dt)
            lightningAcc = lightningAcc + dt
            if lightningAcc < 1 / feat.lightningRate then return end
            lightningAcc = 0
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then spawnLightningArc(hrp) end
        end)
    end

    -- NEW: fire footsteps
    local footstepAcc, lastPos = 0, nil
    local fireFootConn = nil
    Fn.rebuildFireFootsteps = function()
        if fireFootConn then fireFootConn:Disconnect(); fireFootConn = nil end
        if not feat.fireFootsteps then return end
        lastPos = nil
        fireFootConn = RS.Heartbeat:Connect(function(dt)
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then lastPos = nil return end
            if hum.MoveDirection.Magnitude < 0.1 then lastPos = hrp.Position return end
