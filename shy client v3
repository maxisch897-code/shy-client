                regRef(tl, "TextColor3", "Text")
                local sl = new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,12,0,24),Size=UDim2.new(1,-170,0,14),Font=Enum.Font.Gotham,Text="ID: "..tostring(item.id).."  •  "..tostring(item.artist or "Unknown"),TextColor3=T.Muted,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=row})
                regRef(sl, "TextColor3", "Muted")
                local playB = new("TextButton",{Size=UDim2.new(0,54,0,28),Position=UDim2.new(1,-120,0.5,-14),BackgroundColor3=Color3.fromRGB(255,255,255),Text="Play",Font=Enum.Font.GothamBold,TextColor3=ON_ACCENT,TextSize=11,BorderSizePixel=0,AutoButtonColor=false,Parent=row})
