end
function Utils.readPixelBilinear(image, u, v)
	local pixels = image.pixels
	if pixels then
		local r, g, b, a = bilinearAt(pixels, image.width, image.height, u, v)
		return r / 255, g / 255, b / 255, a / 255
	end
	local width, height = image.width, image.height
	local px = math.clamp(u * width - 0.5, 0, width - 1)
	local py = math.clamp(v * height - 0.5, 0, height - 1)
	local x0 = px // 1; local y0 = py // 1
	local x1 = math.min(x0 + 1, width - 1); local y1 = math.min(y0 + 1, height - 1)
	local blockW = x1 - x0 + 1
	local block = image.editable:ReadPixelsBuffer(Vector2.new(x0, y0), Vector2.new(blockW, y1 - y0 + 1))
	local fx = px - x0; local fy = py - y0
	local w11 = fx * fy; local w10 = fx - w11; local w01 = fy - w11; local w00 = 1 - fx - fy + w11
	local i10 = (blockW - 1) * 4
	local i01 = (y1 - y0) * blockW * 4
	local i11 = i01 + i10
	local r = buffer.readu8(block, 0) * w00 + buffer.readu8(block, i10) * w10 + buffer.readu8(block, i01) * w01 + buffer.readu8(block, i11) * w11
	local g = buffer.readu8(block, 1) * w00 + buffer.readu8(block, i10 + 1) * w10 + buffer.readu8(block, i01 + 1) * w01 + buffer.readu8(block, i11 + 1) * w11
	local b = buffer.readu8(block, 2) * w00 + buffer.readu8(block, i10 + 2) * w10 + buffer.readu8(block, i01 + 2) * w01 + buffer.readu8(block, i11 + 2) * w11
	local a = buffer.readu8(block, 3) * w00 + buffer.readu8(block, i10 + 3) * w10 + buffer.readu8(block, i01 + 3) * w01 + buffer.readu8(block, i11 + 3) * w11
