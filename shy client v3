    end
    local vhsOverlay = new("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.fromRGB(80,0,80),
        BackgroundTransparency=0.9, Visible=false, ZIndex=51, Parent=scGui})
    local glitchOverlay = new("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.fromRGB(0,255,255),
        BackgroundTransparency=0.95, Visible=false, ZIndex=52, Parent=scGui})

    local ca = new("ColorCorrectionEffect", {Name="ShyChromatic", Enabled=false, Parent=Lighting})
    local dof = new("DepthOfFieldEffect", {Name="ShyDOF", Enabled=false, Parent=Lighting})
    local retro = new("ColorCorrectionEffect", {Name="ShyRetro", Enabled=false, Parent=Lighting})

    Fn.applyScreenFilters = function()
        ca.Enabled = feat.chromaticAberration
        dof.Enabled = feat.depthOfField
        retro.Enabled = feat.retroFilter
        scanlines.Visible = feat.vhsFilter or feat.glitchFilter
        vhsOverlay.Visible = feat.vhsFilter
        glitchOverlay.Visible = feat.glitchFilter

        if feat.chromaticAberration then
            local k = feat.chromaticStrength
            ca.TintColor = Color3.new(1,1,1)
            ca.Saturation = k * 0.5
            ca.Contrast = k * 0.15
            ca.Brightness = 0
        end
        if feat.depthOfField then
            dof.NearIntensity = 0.5
            dof.FarIntensity = 0.5
            dof.FocusDistance = feat.dofNear
            dof.InFocusRadius = feat.dofFar * 0.05
        end
        if feat.retroFilter then
            local k = feat.retroStrength
            retro.TintColor = Color3.fromRGB(255, 220, 150)
            retro.Saturation = -0.4 * k
            retro.Contrast = 0.25 * k
            retro.Brightness = -0.03 * k
        end
    end

    -- glitch flicker
    local glitchAcc = 0
    RS.RenderStepped:Connect(function(dt)
        if not feat.glitchFilter then return end
        glitchAcc = glitchAcc + dt
        if glitchAcc > 0.05 then
            glitchAcc = 0
            if math.random() < 0.25 then
                glitchOverlay.BackgroundColor3 = Color3.fromRGB(math.random(0,255), math.random(0,255), math.random(0,255))
                glitchOverlay.BackgroundTransparency = 0.85 + math.random() * 0.1
                glitchOverlay.Position = UDim2.new(math.random(-3,3)/100, 0, 0, 0)
            else
                glitchOverlay.BackgroundTransparency = 1
                glitchOverlay.Position = UDim2.new(0,0,0,0)
            end
        end
        if feat.vhsFilter then
            vhsOverlay.Position = UDim2.new(math.sin(tick() * 20) * 0.002, 0, 0, 0)
        end
    end)
end

