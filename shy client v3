            BackgroundColor3 = (bad and T.Bad or T.Accent), BorderSizePixel = 0, Parent = c
        })
        corner(bar, 2)
        gradient(bar, (bad and T.Bad or T.Accent), (bad and T.Bad or T.Accent2), 90)
        local titleLbl = new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 10), Size = UDim2.new(1, -24, 0, 16),
            Font = Enum.Font.GothamBold, Text = title, TextColor3 = T.Text, TextSize = 12,
            TextTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = c
        })
        local msgLbl = new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.new(0, 18, 0, 28), Size = UDim2.new(1, -24, 0, 20),
            Font = Enum.Font.Gotham, Text = msg, TextColor3 = T.Dim, TextSize = 11,
            TextTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = c
        })
