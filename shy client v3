        corner(mhTrack,2)
        mhFill = new("Frame",{Size=UDim2.new(0,0,1,0),BackgroundColor3=T.Accent,BorderSizePixel=0,Parent=mhTrack})
        corner(mhFill,2)
        local fillG = gradient(mhFill,T.Accent,T.Accent2,0)
        mhTrack.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 and Music.sound and Music.sound.TimeLength > 0 then
                local rel = math.clamp((i.Position.X - mhTrack.AbsolutePosition.X) / mhTrack.AbsoluteSize.X, 0, 1)
                Music.sound.TimePosition = rel * Music.sound.TimeLength
            end
        end)

        Fn.updateHud = function()
            coverG.Color = ColorSequence.new(T.Accent, T.Accent2)
            fillG.Color = ColorSequence.new(T.Accent, T.Accent2)
            mhTitle.Text = Music.name
            mhSub.Text = (Music.artist ~= "" and Music.artist) or (Music.id and ("ID "..Music.id)) or "Pick a song in the Music tab"
            coverImg.Image = Music.id and ("rbxthumb://type=Asset&id="..Music.id.."&w=150&h=150") or ""
            playIcon.Visible = not Music.playing
            pauseIcon.Visible = Music.playing
            if UI.nowLbl then UI.nowLbl.Text = Music.name .. (Music.id and not Music.playing and "  (paused)" or "") end
        end
    end

    -- ── lyrics bar
    local lyLbl
    do
        lyLbl = new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,-24,1,0),Position=UDim2.new(0,12,0,0),Font=Enum.Font.GothamMedium,Text="",RichText=true,TextColor3=T.Text,TextSize=16,TextTruncate=Enum.TextTruncate.AtEnd,Parent=overlays.lyrics})
    end

    -- ── per-frame updates
    RS.RenderStepped:Connect(function(dt)
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if overlays.coords.Visible and hrp then
            local p = hrp.Position
            local dh = colorToHex(T.Dim)
            coordsLbl.Text = string.format('<font color="%s">x</font> <b>%d</b>   <font color="%s">y</font> <b>%d</b>   <font color="%s">z</font> <b>%d</b>',
                dh, math.floor(p.X + 0.5), dh, math.floor(p.Y + 0.5), dh, math.floor(p.Z + 0.5))
        end

        if overlays.speed.Visible then
            local v = hrp and hrp.AssemblyLinearVelocity or Vector3.zero
            local target = Vector3.new(v.X, 0, v.Z).Magnitude
            UI.spd = (UI.spd or 0) + (target - (UI.spd or 0)) * math.min(dt * 10, 1)
            spVal.Text = (string.format("%.2f", UI.spd):gsub("%.", ",")) .. " bps"
            spBar.Size = UDim2.new(math.clamp(UI.spd / 60, 0, 1), 0, 1, 0)
        end

        if overlays.musicHud.Visible then
            local len = Music.sound.TimeLength
            mhFill.Size = UDim2.new(len > 0 and math.clamp(Music.sound.TimePosition / len, 0, 1) or 0, 0, 1, 0)
        end

        if overlays.lyrics.Visible then
            local lines = Lyrics.lines
            local n = #lines
            if n == 0 then
                if Lyrics.key ~= "none" then
                    Lyrics.key = "none"
                    lyLbl.Text = '<font color="'..colorToHex(T.Muted)..'">♪  no lyrics loaded</font>'
                end
            else
                local pos = Music.sound.TimePosition + Lyrics.offset
                local idx = 0
                for i = 1, n do if lines[i].t <= pos then idx = i else break end end
                if idx == 0 then
                    if Lyrics.key ~= "pre" then Lyrics.key = "pre"; lyLbl.Text = '<font color="'..colorToHex(T.Muted)..'">♪</font>' end
                else
                    local L = lines[idx]
                    local t1 = lines[idx+1] and lines[idx+1].t or (L.t + 4)
                    local dur = math.clamp(t1 - L.t, 0.5, 6) * 0.85
                    local f = math.clamp((pos - L.t) / dur, 0, 1)
                    local widx = #L.words
                    for i = 1, #L.words do if f <= L.cum[i] then widx = i; break end end
                    local key = idx * 1000 + widx
                    if Lyrics.key ~= key then
                        Lyrics.key = key
                        local acc, dimc = colorToHex(T.Accent), "#8C93A6"
                        local parts = {}
                        for i, w in ipairs(L.words) do
                            w = w:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
                            if i < widx then parts[#parts+1] = '<font color="#FFFFFF">'..w..'</font>'
                            elseif i == widx then parts[#parts+1] = '<font color="'..acc..'"><b>'..w..'</b></font>'
                            else parts[#parts+1] = '<font color="'..dimc..'">'..w..'</font>' end
                        end
                        lyLbl.Text = table.concat(parts, " ")
                    end
                end
            end
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- 3D LYRICS  (current line floats in the air next to your character, typed out letter by letter)
-- ══════════════════════════════════════════════════════════════
do
    feat.lyrics3d = false
    Lyrics.airScale = 1.6
    local A = {}
    Lyrics.A = A
    local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)

    local function esc(c) return (c:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end

    local function build()
        A.part = new("Part", {Name="ShyLyrics3D", Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Transparency=1, Size=Vector3.new(16, 3, 0.05), Parent=workspace.CurrentCamera})
        A.sg = new("SurfaceGui", {Name="ShyLyrics3D", Face=Enum.NormalId.Front, Adornee=A.part, SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud=60, LightInfluence=0, AlwaysOnTop=false, Enabled=false, Parent=A.part})
        A.holder = new("Frame", {BackgroundTransparency=1, Size=UDim2.fromScale(1, 1), Parent=A.sg})
        A.scale = new("UIScale", {Scale=1, Parent=A.holder})
        A.shadow = new("TextLabel", {BackgroundTransparency=1, Size=UDim2.fromScale(1, 1), Position=UDim2.fromOffset(4, 6), FontFace=FONT, TextScaled=true, RichText=true, Text="", TextColor3=Color3.new(0, 0, 0), TextTransparency=0.55, ZIndex=1, Parent=A.holder})
        A.lbl = new("TextLabel", {BackgroundTransparency=1, Size=UDim2.fromScale(1, 1), FontFace=FONT, TextScaled=true, RichText=true, Text="", TextColor3=Color3.new(1, 1, 1), ZIndex=2, Parent=A.holder})
        A.glow = new("UIStroke", {Color=T.Accent, Thickness=3, Transparency=0.6, Parent=A.lbl})
        new("UITextSizeConstraint", {MaxTextSize=130, Parent=A.lbl})
        new("UITextSizeConstraint", {MaxTextSize=130, Parent=A.shadow})
    end

    local function hide()
        if A.sg then A.sg.Enabled = false end
        A.idx, A.pos = nil, nil
    end

    -- random spot in the air, in view of the camera, away from the player and not behind walls
    local function pickSpot(cam, hrp)
        local vp = cam.ViewportSize
        local ps = cam:WorldToViewportPoint(hrp.Position)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {player.Character, A.part}
        for _ = 1, 16 do
            local sx = vp.X * (0.28 + math.random() * 0.44)
            local sy = vp.Y * (0.14 + math.random() * 0.36)
            if ps.Z <= 0 or (Vector2.new(sx, sy) - Vector2.new(ps.X, ps.Y)).Magnitude > vp.Y * 0.25 then
                local ray = cam:ViewportPointToRay(sx, sy)
                local dist = 16 + math.random() * 10
                local hit = workspace:Raycast(ray.Origin, ray.Direction * dist, params)
                if hit then dist = (hit.Position - ray.Origin).Magnitude - 2 end
                if dist >= 9 then return ray.Origin + ray.Direction * dist end
            end
        end
        local cf = cam.CFrame
        return cf.Position + cf.LookVector * 18 + cf.UpVector * 5 + cf.RightVector * (math.random() < 0.5 and -6 or 6)
    end

    local function respawn(cam, hrp)
        A.pos = pickSpot(cam, hrp)
        A.tilt = CFrame.Angles(0, math.rad((math.random() < 0.5 and -1 or 1) * (8 + math.random() * 14)), math.rad((math.random() - 0.5) * 8))
        A.lost, A.bob = 0, math.random() * 6
        A.scale.Scale = 0.6
        TS:Create(A.scale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
    end

    RS.RenderStepped:Connect(function(dt)
        if not feat.lyrics3d then if A.sg and A.sg.Enabled then hide() end return end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local lines = Lyrics.lines
        if not hrp or #lines == 0 or not (Music.sound and Music.sound.IsPlaying) then hide() return end
        local pos = Music.sound.TimePosition + Lyrics.offset
        local idx = 0
        for i = 1, #lines do if lines[i].t <= pos then idx = i else break end end
        if idx == 0 then hide() return end
        if not A.part or not A.part.Parent then build() end

        local L = lines[idx]
        local t1 = lines[idx + 1] and lines[idx + 1].t or (L.t + 4)
        if A.idx ~= idx then -- new line: split into characters and pop in
            A.idx, A.key = idx, nil
            A.chars = {}
            local str = string.upper(table.concat(L.words, " "))
            if not pcall(function() for _, c in utf8.codes(str) do A.chars[#A.chars + 1] = utf8.char(c) end end) then
                A.chars = {}
                for i = 1, #str do A.chars[i] = str:sub(i, i) end
            end
            respawn(workspace.CurrentCamera, hrp)
        end

        -- typewriter: reveal over ~55% of the line, next letter fades in
        local n = #A.chars
        local reveal = math.clamp((pos - L.t) / math.max(math.min(t1 - L.t, 6) * 0.55, 0.2), 0, 1)
        local nf = reveal * n
        local shown = math.floor(nf)
        local frac = nf - shown
        local key = shown * 8 + math.floor(frac * 8)
        if A.key ~= key then
            A.key = key
            local done = {}
            for i = 1, shown do done[i] = esc(A.chars[i]) end
            local solid = table.concat(done)
            local nxt = A.chars[shown + 1]
            A.lbl.Text = nxt and (solid .. string.format('<font transparency="%.2f">%s</font>', 1 - frac, esc(nxt))) or solid
            A.shadow.Text = solid
        end

        -- fade out right before the next line
        local fade = 1 - math.clamp((t1 - pos) / 0.3, 0, 1)
        A.lbl.TextTransparency = fade
        A.shadow.TextTransparency = 0.55 + 0.45 * fade
        A.glow.Transparency = 0.6 + 0.4 * fade
        A.glow.Color = T.Accent

        -- stays fixed in the air; jumps to a new spot if off-screen, behind a wall, too far or over the player
        local cam = workspace.CurrentCamera
        local camPos = cam.CFrame.Position
        local sp, onScreen = cam:WorldToViewportPoint(A.pos)
        local ps = cam:WorldToViewportPoint(hrp.Position)
        local bad = not onScreen or sp.Z < 5 or (A.pos - camPos).Magnitude > 50
            or (ps.Z > 0 and (Vector2.new(sp.X, sp.Y) - Vector2.new(ps.X, ps.Y)).Magnitude < cam.ViewportSize.Y * 0.15)
        A.chk = (A.chk or 0) + dt
        if not bad and A.chk > 0.25 then
            A.chk = 0
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {player.Character, A.part}
            if workspace:Raycast(camPos, A.pos - camPos, params) then bad = true end
        end
        A.lost = bad and (A.lost + dt) or 0
        if A.lost > 0.4 then respawn(cam, hrp) end

        local s = Lyrics.airScale
        A.part.Size = Vector3.new(10 * s, 1.9 * s, 0.05)
        local p = A.pos + Vector3.new(0, math.sin(os.clock() * 1.4 + A.bob) * 0.25, 0)
        A.part.CFrame = CFrame.lookAt(p, camPos) * A.tilt
        A.sg.Enabled = true
    end)
end

-- ══════════════════════════════════════════════════════════════
-- MUSIC + LYRICS ENGINE
-- ══════════════════════════════════════════════════════════════
do
    Music.sound = new("Sound", {Name="ShyMusic", Volume=Music.volume, Looped=true, Parent=SoundService})

    local function cleanName(s)
        s = tostring(s or "")
        s = s:gsub("%b()", " ")
        s = s:gsub("%b[]", " ")
        s = s:gsub("_", " ")
        s = s:gsub("%s+", " ")
        s = s:gsub("^%s+", ""):gsub("%s+$", "")
        return s
    end

    -- lyrics -------------------------------------------------
    local function mkLine(t, text)
        local words, cum, total = {}, {}, 0
        for w in text:gmatch("%S+") do words[#words+1] = w; total = total + #w + 1 end
        local acc = 0
        for i, w in ipairs(words) do acc = acc + #w + 1; cum[i] = acc / math.max(total, 1) end
        return { t=t, text=text, words=words, cum=cum }
    end

    Lyrics.parse = function(raw)
        local lines, plain, synced = {}, {}, false
        for ln in tostring(raw):gmatch("[^\r\n]+") do
            local stamps, rest = {}, ln
            while true do
                local mm, ss, ff, nxt = rest:match("^%s*%[(%d+):(%d+)[%.:]?(%d*)%]()")
                if not mm then break end
                local frac = (ff ~= "" and tonumber("0."..ff)) or 0
                stamps[#stamps+1] = tonumber(mm) * 60 + tonumber(ss) + frac
                rest = rest:sub(nxt)
            end
            rest = rest:gsub("<%d+:%d+[%.:]?%d*>", "")
            rest = rest:gsub("^%s+", ""):gsub("%s+$", "")
            if #stamps > 0 then
                synced = true
                if rest ~= "" then for _, t in ipairs(stamps) do lines[#lines+1] = mkLine(t, rest) end end
            elseif rest ~= "" and not rest:match("^%[%a+:") then
                plain[#plain+1] = rest
            end
        end
        if synced then
            table.sort(lines, function(a, b) return a.t < b.t end)
            return lines
        end
        local total = Music.sound.TimeLength > 0 and Music.sound.TimeLength or 180
        for i, text in ipairs(plain) do lines[#lines+1] = mkLine((i - 1) * total / math.max(#plain, 1), text) end
        return lines
    end

    Lyrics.fetch = function(query, quiet)
        if not req then
            if not quiet then notify("Lyrics", "Executor has no HTTP request — paste LRC instead", false) end
            return
        end
        local q = cleanName(query)
        if q == "" then if not quiet then notify("Lyrics", "Enter artist - song", false) end return end
        task.spawn(function()
            if not quiet then notify("Lyrics", "Searching: " .. q) end
            local ok, res = pcall(req, { Url="https://lrclib.net/api/search?q=" .. HttpService:UrlEncode(q), Method="GET" })
            if not ok or type(res) ~= "table" or not res.Body then notify("Lyrics", "Request failed", false) return end
            local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if not ok2 or type(data) ~= "table" or #data == 0 then notify("Lyrics", "No lyrics found", false) return end
            local pick
            for _, it in ipairs(data) do
                if type(it.syncedLyrics) == "string" and #it.syncedLyrics > 0 then pick = it.syncedLyrics; break end
            end
            if not pick then
                for _, it in ipairs(data) do
                    if type(it.plainLyrics) == "string" and #it.plainLyrics > 0 then pick = it.plainLyrics; break end
                end
            end
            if not pick then notify("Lyrics", "No lyrics found", false) return end
            local lines = Lyrics.parse(pick)
            if #lines == 0 then notify("Lyrics", "Could not read lyrics", false) return end
            Lyrics.lines = lines; Lyrics.key = nil
            notify("Lyrics", "Loaded " .. #lines .. " lines")
        end)
    end

    Lyrics.loadText = function(text)
        local lines = Lyrics.parse(text)
        if #lines == 0 then notify("Lyrics", "Nothing to load", false) return end
        Lyrics.lines = lines; Lyrics.key = nil
        notify("Lyrics", "Loaded " .. #lines .. " lines")
    end

    Lyrics.clear = function() Lyrics.lines = {}; Lyrics.key = nil end

    -- library ------------------------------------------------
    Lib.save = function()
        if not FILE_OK then return end
        local ok, e = pcall(function() return HttpService:JSONEncode(Lib.list) end)
        if ok then pcall(writefile, Lib.file, e) end
    end
    Lib.load = function()
        if not FILE_OK then return end
        local ok, ex = pcall(isfile, Lib.file)
        if ok and ex then
            local ok2, raw = pcall(readfile, Lib.file)
            if ok2 then
                local ok3, d = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok3 and type(d) == "table" then Lib.list = d end
            end
        end
    end
    Lib.add = function(id, name, artist)
        local clean = tostring(id or ""):gsub("rbxassetid://", ""):gsub("%D", "")
        if clean == "" then notify("Library", "Enter a valid audio ID", false) return end
        name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then name = "Song " .. (#Lib.list + 1) end
        for _, e in ipairs(Lib.list) do
            if e.id == clean then
                e.name = name; if artist and artist ~= "" then e.artist = artist end
                Lib.save(); if Lib.refresh then Lib.refresh() end
                notify("Library", "Updated: " .. name)
                return
            end
        end
        Lib.list[#Lib.list+1] = { id=clean, name=name, artist=artist or "" }
        Lib.save(); if Lib.refresh then Lib.refresh() end
        notify("Library", "Saved: " .. name)
    end
    Lib.remove = function(i)
        local e = Lib.list[i]; if not e then return end
        table.remove(Lib.list, i)
        Lib.save(); if Lib.refresh then Lib.refresh() end
        notify("Library", "Deleted: " .. e.name, false)
    end
    Lib.load()

    -- player -------------------------------------------------
    Music.play = function(id, name, artist)
        local clean = tostring(id or ""):gsub("rbxassetid://", ""):gsub("%D", "")
        if clean == "" then notify("Music", "Enter a valid audio ID", false) return end
        Music.id = clean
        Music.name = (name and name ~= "") and name or ("Audio " .. clean)
        Music.artist = artist or ""
        Music.sound.SoundId = "rbxassetid://" .. clean
        Music.sound.TimePosition = 0
        Music.sound:Play()
        Music.playing = true
        Lyrics.clear()
        notify("Music", "Playing: " .. Music.name)
        Fn.updateHud()
        if Lyrics.auto then Lyrics.fetch((Music.artist ~= "" and (Music.artist .. " ") or "") .. Music.name, true) end
        task.delay(4, function()
            if Music.id == clean and Music.sound.TimeLength == 0 then
                notify("Music", "Audio could not load (private/blocked ID?)", false)
            end
        end)
    end

    Music.toggle = function()
        if not Music.id then notify("Music", "Nothing loaded — pick a song first", false) return end
        if Music.playing then Music.sound:Pause(); Music.playing = false
        else Music.sound:Resume(); Music.playing = true end
        Fn.updateHud()
    end

    Music.stop = function()
        Music.sound:Stop(); Music.playing = false
        Fn.updateHud()
    end

    local function step(dir)
        if #Lib.list == 0 then notify("Music", "Save songs in the library first", false) return end
        local cur = 0
        for i, e in ipairs(Lib.list) do if e.id == Music.id then cur = i; break end end
        local nxt = ((cur - 1 + dir) % #Lib.list) + 1
        local e = Lib.list[nxt]
        Music.play(e.id, e.name, e.artist)
    end
    Music.next = function() step(1) end
    Music.prev = function() step(-1) end

    Music.sound.Ended:Connect(function() if not Music.looped then step(1) end end)
end

