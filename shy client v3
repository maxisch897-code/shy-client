        corner(e, RM); stroke(e, 1, 0.55, T.Line); regRef(e, "BackgroundColor3", "Card"); regCard(e)
        return e
    end
    local function doSearch()
        local query = searchInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if query == "" then notify("Music", "Type something to search", false) return end
        for _, c in ipairs(resultsList:GetChildren()) do if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end end
        local loading = note("Searching...", 36)
        task.spawn(function()
            local items
            local ok, pages = pcall(function()
                local params = Instance.new("AudioSearchParams")
                params.SearchKeyword = query
                return AssetService:SearchAudio(params)
            end)
            if ok and pages then
                local ok2, page = pcall(function() return pages:GetCurrentPage() end)
                if ok2 and type(page) == "table" then
                    items = {}
                    for _, it in ipairs(page) do items[#items+1] = { id = it.Id, name = it.Title or it.Name, artist = it.Artist } end
                end
            end
            if not items then
                local ok3, old = pcall(function() return AssetService:SearchAudioAsync(query, Enum.AssetType.Audio, 1, 20) end)
                if ok3 and type(old) == "table" then
                    items = {}
                    for _, it in ipairs(old) do items[#items+1] = { id = it.Id, name = it.Name or it.Title, artist = it.Artist } end
                end
            end
            loading:Destroy()
            if not items or #items == 0 then
                note("No results (search may be blocked in-game) — paste an audio ID instead.", 44)
                return
            end
            for i, item in ipairs(items) do
                local row = new("Frame",{Size=UDim2.new(1,0,0,48),BackgroundColor3=T.Card,BackgroundTransparency=TR.Card,BorderSizePixel=0,LayoutOrder=i,Parent=resultsList})
