-- LIGHTING
-- ══════════════════════════════════════════════════════════════
do
    local savedLight = nil
    Fn.saveLight = function()
        if savedLight then return end
        savedLight = {ClockTime=Lighting.ClockTime,Brightness=Lighting.Brightness,Ambient=Lighting.Ambient,OutdoorAmbient=Lighting.OutdoorAmbient,FogColor=Lighting.FogColor,FogStart=Lighting.FogStart,FogEnd=Lighting.FogEnd,GlobalShadows=Lighting.GlobalShadows}
    end
    Fn.applyFB = function()
        if feat.fullbright then
            Lighting.Ambient = Color3.fromRGB(255,255,255); Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
            Lighting.Brightness = 3; Lighting.GlobalShadows = false
        else
            Lighting.Ambient = Color3.fromRGB(70,70,70); Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
            Lighting.Brightness = 2; Lighting.GlobalShadows = true
        end
    end
    Fn.setDay = function()
        Fn.saveLight(); TS:Create(Lighting,TweenInfo.new(0.5),{ClockTime=12,Brightness=2}):Play()
        Lighting.Ambient = Color3.fromRGB(90,90,90); Lighting.OutdoorAmbient = Color3.fromRGB(130,130,130)
        Lighting.FogColor = Color3.fromRGB(192,192,192); Lighting.FogEnd = 1e5; Lighting.GlobalShadows = true
        notify("Time","Day")
    end
    Fn.setNight = function()
        Fn.saveLight(); TS:Create(Lighting,TweenInfo.new(0.5),{ClockTime=0,Brightness=0.5}):Play()
        Lighting.Ambient = Color3.fromRGB(20,25,45); Lighting.OutdoorAmbient = Color3.fromRGB(40,50,80)
        Lighting.FogColor = Color3.fromRGB(15,20,35); Lighting.FogEnd = 400; Lighting.GlobalShadows = true
        notify("Time","Night")
    end
    Fn.setSunset = function()
        Fn.saveLight(); TS:Create(Lighting,TweenInfo.new(0.5),{ClockTime=17.5,Brightness=2}):Play()
        Lighting.Ambient = Color3.fromRGB(110,70,50); Lighting.OutdoorAmbient = Color3.fromRGB(200,120,80)
        Lighting.FogColor = Color3.fromRGB(255,150,100); Lighting.FogEnd = 600; Lighting.GlobalShadows = true
        notify("Time","Sunset")
    end
    Fn.restoreLight = function()
        if not savedLight then notify("Time","Nothing to restore",false); return end
        TS:Create(Lighting,TweenInfo.new(0.5),{ClockTime=savedLight.ClockTime,Brightness=savedLight.Brightness}):Play()
        Lighting.Ambient=savedLight.Ambient; Lighting.OutdoorAmbient=savedLight.OutdoorAmbient
        Lighting.FogColor=savedLight.FogColor; Lighting.FogStart=savedLight.FogStart
        Lighting.FogEnd=savedLight.FogEnd; Lighting.GlobalShadows=savedLight.GlobalShadows
        notify("Time","Restored",false)
    end
end

