do
    local SG = {panels = {}}
    Glass.SG = SG
    local PCA = Glass.pca
    local MAX_CELLS, OUT_PX, MAX_OUT = 9000, 2, 60000
    local SAT, LIFT = 1.3, 0.85
    SG.budget = 3e-3
    local exp, clamp, floor, ceil, min, max, clock = math.exp, math.clamp, math.floor, math.ceil, math.min, math.max, os.clock
    local CH = {"tR", "tG", "tB", "cR", "cG", "cB"}
    local function trunc(x) if x >= 0 then return floor(x) end return ceil(x) end
    local function gcd(a, b) while b ~= 0 do a, b = b, a % b end return a end
    local function pickStride(n)
        local s = max(1, floor(n * 0.618))
        while s > 1 and gcd(s, n) ~= 1 do s -= 1 end
        return s
    end
    local function rrect(px, py, W, H, R)
        local hx, hy = W * 0.5, H * 0.5
        local dx, dy = px - hx, py - hy
        local ax, ay = math.abs(dx) - (hx - R), math.abs(dy) - (hy - R)
        local sx, sy = dx < 0 and 1 or -1, dy < 0 and 1 or -1
        if ax > 0 and ay > 0 then
            local l = math.sqrt(ax * ax + ay * ay)
            return R - l, sx * ax / l, sy * ay / l
        elseif ax > ay then
            return R - ax, sx, 0
        end
        return R - ay, 0, sy
    end
    local function freeImg(P)
        if P.img then pcall(function() P.img:Destroy() end); P.img = nil end
    end
    local function axis(count, cells)
        local i0, i1, fr = table.create(count, 1), table.create(count, 1), table.create(count, 0)
        for x = 1, count do
            local g = clamp((x - 0.5) * cells / count - 0.5, 0, cells - 1)
            local a = floor(g)
            i0[x], i1[x], fr[x] = a + 1, min(a + 1, cells - 1) + 1, g - a
        end
        return i0, i1, fr
    end
    local function rebuild(P)
        local size = P.frame.AbsoluteSize
        P.lastBuild = clock()
        if size.X < 8 or size.Y < 8 then return end
        local c = 3 + Glass.blur * 0.5
        local gw, gh = max(2, ceil(size.X / c)), max(2, ceil(size.Y / c))
        if gw * gh > MAX_CELLS then
            local s = math.sqrt(MAX_CELLS / (gw * gh))
            gw, gh = max(2, floor(gw * s)), max(2, floor(gh * s))
        end
        local ow, oh = max(gw, ceil(size.X / OUT_PX)), max(gh, ceil(size.Y / OUT_PX))
        if ow * oh > MAX_OUT then
            local s = math.sqrt(MAX_OUT / (ow * oh))
            ow, oh = max(gw, floor(ow * s)), max(gh, floor(oh * s))
        end
        P.sizeX, P.sizeY = size.X, size.Y
        P.band = min(42, min(size.X, size.Y) * 0.45)
        if not (P.img and P.ow == ow and P.oh == oh) then
            local res = Vector2.new(ow, oh)
            local ok, img = pcall(AssetService.CreateEditableImage, AssetService, {Size = res})
            if not (ok and img) and P.img then
                freeImg(P)
                ok, img = pcall(AssetService.CreateEditableImage, AssetService, {Size = res})
            end
            if not (ok and img) then P.gw = nil; return end
            freeImg(P)
            P.img, P.res, P.ow, P.oh = img, res, ow, oh
            P.pane.ImageContent = Content.fromObject(img)
            P.out = buffer.create(ow * oh * 4)
        end
        if P.gw ~= gw or P.gh ~= gh then
            local n = gw * gh
            local tint = P.frame.BackgroundColor3
            local fresh = {}
            for k, name in ipairs(CH) do
                fresh[name] = table.create(n, (k % 3 == 1 and tint.R) or (k % 3 == 2 and tint.G) or tint.B)
            end
            if P.gw then
                local ogw, ogh = P.gw, P.gh
                for y = 0, gh - 1 do
                    local oy = min(ogh - 1, floor((y + 0.5) * ogh / gh))
                    for x = 0, gw - 1 do
                        local j = oy * ogw + min(ogw - 1, floor((x + 0.5) * ogw / gw)) + 1
                        local i = y * gw + x + 1
                        for _, name in ipairs(CH) do fresh[name][i] = P[name][j] end
                    end
                end
            end
            for _, name in ipairs(CH) do P[name] = fresh[name] end
            P.gw, P.gh, P.n = gw, gh, n
            P.hR, P.hG, P.hB = table.create(n, 0), table.create(n, 0), table.create(n, 0)
            P.bR, P.bG, P.bB = table.create(n, 0), table.create(n, 0), table.create(n, 0)
            P.rowR, P.rowG, P.rowB = table.create(gw, 0), table.create(gw, 0), table.create(gw, 0)
            P.queue, P.queued, P.qh, P.idx, P.stride = {}, {}, 1, 0, pickStride(n)
        end
