    miscBtn.MouseEnter:Connect(function() if cur ~= "misc" then tween(miscBtn,0.12,{BackgroundColor3=T.Hover, BackgroundTransparency=0.4}) end end)
    miscBtn.MouseLeave:Connect(function() if cur ~= "misc" then tween(miscBtn,0.12,{BackgroundTransparency=1}) end end)
    miscBtn.MouseButton1Click:Connect(function() Fn.selTab("misc") end)
    Tabs.misc = {btn=miscBtn, label=miscLabel}
    do
        local orderedNames = {}
        for _, s in ipairs(tabSpecs) do orderedNames[s.order] = s.name end
        orderedNames[#orderedNames + 1] = "misc"
        local draggingSidebar, sidebarStart, sidebarMoved = false, nil, false
        sidebar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                draggingSidebar, sidebarStart, sidebarMoved = true, i.Position, false
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if not draggingSidebar then return end
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                if (i.Position - sidebarStart).Magnitude > 12 then sidebarMoved = true end
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if not draggingSidebar then return end
            if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
            draggingSidebar = false
            if not sidebarMoved then return end
            local dy = (i.Position - sidebarStart).Y
            if math.abs(dy) < 30 then return end
            local curName = "home"
            for n, p in pairs(Pages) do if p.Visible then curName = n break end end
            local idx = 1
            for k, n in ipairs(orderedNames) do if n == curName then idx = k break end end
            local nextIdx = dy < 0 and math.min(idx + 1, #orderedNames) or math.max(idx - 1, 1)
            if nextIdx ~= idx then Fn.selTab(orderedNames[nextIdx]) end
        end)
    end
    mkListPage = function(name)
        local p = new("ScrollingFrame",{
            Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, BorderSizePixel=0, ScrollBarThickness=3,
            ScrollBarImageColor3=T.Muted, ScrollBarImageTransparency=0.5, CanvasSize=UDim2.new(0,0,0,0),
            AutomaticCanvasSize=Enum.AutomaticSize.Y, Visible=false, Parent=UI.contentArea
        })
        new("UIListLayout",{Padding=UDim.new(0,6), Parent=p})
        Pages[name] = p
        return p
    end
    UI.Pages = Pages
end

