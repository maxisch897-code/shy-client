local function loadGlassmorphicUI()
    local Node = {}
    Node.__index = function(self, k)
        local m = Node[k]
        if m ~= nil then return m end
        return rawget(self, "_children")[k]
    end
    function Node.FindFirstChild(self, n) return self._children[n] end
    function Node.WaitForChild(self, n) return self._children[n] end
    function Node.GetChildren(self) return table.clone(self._list) end
    function Node.IsA(self, c) return c == self.ClassName or c == "Instance" end
    function Node.FindFirstAncestorOfClass() return nil end
    function Node.GetFullName(self) return self.Parent and (self.Parent:GetFullName() .. "." .. self.Name) or self.Name end
    local function mk(name, class, parent)
        local n = setmetatable({Name = name, ClassName = class, Parent = parent, _children = {}, _list = {}}, Node)
        if parent then parent._children[name] = n; table.insert(parent._list, n) end
        return n
    end
    local realRequire = require
    local function req(m)
        if getmetatable(m) ~= Node then return realRequire(m) end
        if not m._loaded then
            assert(m._fn, "GlassmorphicUI bundle: " .. m.Name .. " is not a module")
            m._value = m._fn(m, req)
            m._loaded = true
        end
        return m._value
    end
local n0 = mk("GlassmorphicUI", "ModuleScript", nil)
n0._fn = function(script, require)
