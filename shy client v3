-- NEW: CROSSHAIR
-- ══════════════════════════════════════════════════════════════
do
    local chGui = new("ScreenGui", {Name="ShyCrosshair", ResetOnSpawn=false, IgnoreGuiInset=true, Parent=pg})
    local chFrame = new("Frame", {
        Size=UDim2.new(0,0,0,0), Position=UDim2.new(0.5,0,0.5,0), AnchorPoint=Vector2.new(0.5,0.5),
        BackgroundTransparency=1, Parent=chGui, Visible=false,
    })
    local parts = {}
    local function mkPart(w, h)
        local f = new("Frame", {
            Size=UDim2.new(0,w,0,h), BackgroundColor3=Color3.fromRGB(255,255,255),
            BorderSizePixel=0, AnchorPoint=Vector2.new(0.5,0.5), Parent=chFrame,
        })
        return f
    end
    Fn.rebuildCrosshair = function()
        for _, p in ipairs(parts) do p:Destroy() end
        parts = {}
        chFrame.Visible = feat.crosshair
        if not feat.crosshair then return end
        local c = hexToColor(feat.crosshairColorHex) or Color3.new(1,1,1)
        local s, t, g = feat.crosshairSize, feat.crosshairThickness, feat.crosshairGap
        if feat.crosshairStyle == "cross" then
            local up = mkPart(t, s); up.Position = UDim2.new(0.5, 0, 0.5, -g - s/2); up.BackgroundColor3 = c; parts[#parts+1] = up
            local dn = mkPart(t, s); dn.Position = UDim2.new(0.5, 0, 0.5, g + s/2); dn.BackgroundColor3 = c; parts[#parts+1] = dn
            local lf = mkPart(s, t); lf.Position = UDim2.new(0.5, -g - s/2, 0.5, 0); lf.BackgroundColor3 = c; parts[#parts+1] = lf
            local rt = mkPart(s, t); rt.Position = UDim2.new(0.5, g + s/2, 0.5, 0); rt.BackgroundColor3 = c; parts[#parts+1] = rt
        elseif feat.crosshairStyle == "dot" then
            local d = mkPart(t*2, t*2); d.Position = UDim2.new(0.5, 0, 0.5, 0); d.BackgroundColor3 = c; parts[#parts+1] = d
        elseif feat.crosshairStyle == "x" then
            for i = 1, 2 do
                local l = mkPart(t, s*1.4)
                l.Position = UDim2.new(0.5, 0, 0.5, 0)
                l.Rotation = i == 1 and 45 or -45
                l.BackgroundColor3 = c
                parts[#parts+1] = l
            end
        elseif feat.crosshairStyle == "circle" then
            -- simple ring made of 4 arcs approximated by 4 bars; keep simple
            for i = 1, 8 do
                local angle = (i - 1) / 8 * math.pi * 2
                local b = mkPart(t, s * 0.4)
                b.Position = UDim2.new(0.5, math.cos(angle) * (g + s*0.2), 0.5, math.sin(angle) * (g + s*0.2))
                b.Rotation = math.deg(angle)
                b.BackgroundColor3 = c
                parts[#parts+1] = b
            end
        end
        if feat.crosshairDot and feat.crosshairStyle ~= "dot" then
            local d = mkPart(t, t); d.Position = UDim2.new(0.5, 0, 0.5, 0); d.BackgroundColor3 = c; parts[#parts+1] = d
        end
        if feat.crosshairOutline then
            for _, p in ipairs(parts) do
                local s2 = new("UIStroke", {Color=Color3.new(0,0,0), Thickness=1, Transparency=0.3, Parent=p})
            end
        end
    end
end

