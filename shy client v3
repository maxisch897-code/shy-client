            local dist = (hrp.Position - lastPos).Magnitude
            if dist < 0.8 then return end
            lastPos = hrp.Position
            local em = new("Part", {Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false,
                Transparency=1, Size=Vector3.new(1,1,1), CFrame=hrp.CFrame * CFrame.new(0,-2.6,0), Parent=workspace})
            local pe = new("ParticleEmitter", {
                Texture="rbxassetid://243098098", Rate=0, Lifetime=NumberRange.new(0.4,0.8),
                Speed=NumberRange.new(2,5), SpreadAngle=Vector2.new(35,35), EmissionDirection=Enum.NormalId.Top,
                Color=ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(255,240,180)),
