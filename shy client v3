                playB.MouseButton1Click:Connect(function() Music.play(item.id, item.name, item.artist) end)
                local saveB = new("TextButton",{Size=UDim2.new(0,54,0,28),Position=UDim2.new(1,-62,0.5,-14),BackgroundColor3=T.Card,Text="Save",Font=Enum.Font.GothamBold,TextColor3=T.Text,TextSize=11,BorderSizePixel=0,AutoButtonColor=false,Parent=row})
                corner(saveB, 7); stroke(saveB, 1, 0.55, T.Line)
                saveB.MouseButton1Click:Connect(function() Lib.add(item.id, item.name, item.artist) end)
            end
        end)
