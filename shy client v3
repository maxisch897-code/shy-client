	local face, u, v
	if absX > absY and absX > absZ then
		if lookDirection.X < 0 then face = "SkyboxRt"; u = 1 - (lookDirection.Z / absX + 1) / 2; v = (lookDirection.Y / absX + 1) / 2
		else face = "SkyboxLf"; u = (lookDirection.Z / absX + 1) / 2; v = (lookDirection.Y / absX + 1) / 2 end
	elseif absY > absZ then
		if lookDirection.Y > 0 then face = "SkyboxUp"; u = 1 - (lookDirection.Z / absY + 1) / 2; v = (lookDirection.X / absY + 1) / 2
		else face = "SkyboxDn"; u = 1 - (lookDirection.Z / absY + 1) / 2; v = 1 - (lookDirection.X / absY + 1) / 2 end
	else
		if lookDirection.Z < 0 then face = "SkyboxFt"; u = (lookDirection.X / absZ + 1) / 2; v = (lookDirection.Y / absZ + 1) / 2
		else face = "SkyboxBk"; u = 1 - (lookDirection.X / absZ + 1) / 2; v = (lookDirection.Y / absZ + 1) / 2 end
	end
	v = 1 - v
	return face, u, v
