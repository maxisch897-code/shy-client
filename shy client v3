                for i = 1, n do if lines[i].t <= pos then idx = i else break end end
                if idx == 0 then
                    if Lyrics.key ~= "pre" then Lyrics.key = "pre"; lyLbl.Text = '<font color="'..colorToHex(T.Muted)..'">♪</font>' end
                else
                    local L = lines[idx]
                    local t1 = lines[idx+1] and lines[idx+1].t or (L.t + 4)
                    local dur = math.clamp(t1 - L.t, 0.5, 6) * 0.85
                    local f = math.clamp((pos - L.t) / dur, 0, 1)
                    local widx = #L.words
                    for i = 1, #L.words do if f <= L.cum[i] then widx = i; break end end
                    local key = idx * 1000 + widx
                    if Lyrics.key ~= key then
                        Lyrics.key = key
                        local acc, dimc = colorToHex(T.Accent), "#8C93A6"
                        local parts = {}
                        for i, w in ipairs(L.words) do
                            w = w:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
                            if i < widx then parts[#parts+1] = '<font color="#FFFFFF">'..w..'</font>'
                            elseif i == widx then parts[#parts+1] = '<font color="'..acc..'"><b>'..w..'</b></font>'
                            else parts[#parts+1] = '<font color="'..dimc..'">'..w..'</font>' end
                        end
                        lyLbl.Text = table.concat(parts, " ")
                    end
                end
            end
        end
    end)
end

