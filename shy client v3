            vfxObj.haloLight = new("PointLight",{Color=EC,Range=9,Brightness=2.2,Parent=anchor})
            vfxObj.halo = model
            local cfs, t = table.create(#parts), 0
            vfxObj.haloC = RS.RenderStepped:Connect(function(dt)
                if not anchor.Parent then return end
                t += dt
                local yOff = (anchor == hrp and 3.4 or anchor.Size.Y * 0.5 + 0.75) + math.sin(t * 2) * 0.08
                local base = anchor.CFrame * CFrame.new(0, yOff, 0.15) * CFrame.Angles(math.rad(-14), t * 0.5, 0)
                for i, lc in ipairs(locals) do cfs[i] = base * lc end
                workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
                for _, c in ipairs(core) do
                    c.p.Transparency = 0.25 - 0.25 * math.max(math.cos(c.th - t * 2.2), 0) ^ 6
                end
            end)
        end
        if feat.wings then
            -- crystal wings: two fans of glassy blade shards from the upper back, gently flapping
            local SPIKES = { -- {angle from horizontal (deg), length, sweep back}
                {84, 2.4, 0.10}, {64, 3.4, 0.18}, {44, 4.3, 0.24}, {24, 4.6, 0.30},
                {5, 4.0, 0.34}, {-16, 3.2, 0.36}, {-38, 2.4, 0.38},
            }
            local model = new("Model",{Name="ShyCrystalWings",Parent=workspace})
            local ice = EC
            local parts, locals = {}, {}
            local back = Vector3.new(0, 0, 1)
            for _, side in ipairs({-1, 1}) do
                for _, sp in ipairs(SPIKES) do
                    local a, L = math.rad(sp[1]), sp[2]
                    local dir = Vector3.new(side * math.cos(a), math.sin(a), sp[3]).Unit
                    local vX = (back - dir * back:Dot(dir)).Unit
                    local vZ = -dir
                    local vY = vZ:Cross(vX)
                    local frame = CFrame.fromMatrix(dir * (L * 0.5 + 0.15), vX, vY, vZ)
                    local hw = 0.16 + L * 0.045
                    for _, half in ipairs({CFrame.new(0, hw * 0.5, 0), CFrame.new(0, -hw * 0.5, 0) * CFrame.Angles(0, 0, math.pi)}) do
                        local w = new("WedgePart",{Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,Size=Vector3.new(0.08,hw,L),Material=Enum.Material.Glass,Color=ice,Transparency=0.3,Reflectance=0.25,Parent=model})
                        parts[#parts+1] = w
                        locals[#locals+1] = {side, frame * half}
                    end
                end
            end
            vfxObj.wingHl = new("Highlight",{FillColor=EC,FillTransparency=0.72,OutlineColor=EC:Lerp(Color3.new(1,1,1),0.3),OutlineTransparency=0.15,DepthMode=Enum.HighlightDepthMode.Occluded,Adornee=model,Parent=model})
            vfxObj.wingLight = new("PointLight",{Color=ice,Range=10,Brightness=1.6,Parent=hrp})
            vfxObj.wingModel = model
            local cfs, t = table.create(#parts), 0
            vfxObj.wingC = RS.RenderStepped:Connect(function(dt)
                if not hrp.Parent then return end
                local air = hum:GetState() == Enum.HumanoidStateType.Freefall
                t += dt * (air and 7 or 2.4)
                local flap = math.rad(14 + math.sin(t) * (air and 16 or 9))
                local base = hrp.CFrame * CFrame.new(0, 0.85, 0.62)
                local wl = base * CFrame.new(-0.3, 0, 0) * CFrame.Angles(0, flap, 0)
                local wr = base * CFrame.new(0.3, 0, 0) * CFrame.Angles(0, -flap, 0)
                for i, lc in ipairs(locals) do cfs[i] = (lc[1] < 0 and wl or wr) * lc[2] end
                workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
            end)
        end
        local head = char:FindFirstChild("Head")
        if feat.crown and head then
            -- soft glowing light-crown: a translucent band around the head with a smooth, slowly
            -- drifting wavy top edge; bright at the rim, fading out toward the head
            local model = new("Model",{Name="ShyCrown",Parent=workspace})
            local top = EC:Lerp(Color3.new(1, 1, 1), 0.45)
            local R = math.clamp(head.Size.Z * 0.66, 0.6, 1.05)
            local SEG, PEAKS = 36, 4
            local seg = math.pi * 2 * R / SEG * 1.08
            local parts, angs = {}, {}
            for i = 1, SEG do
                local p = new("Part",{Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,Transparency=1,Size=Vector3.new(seg,1,0.02),Parent=model})
                for _, face in ipairs({Enum.NormalId.Front, Enum.NormalId.Back}) do
                    local sg = new("SurfaceGui",{Face=face,SizingMode=Enum.SurfaceGuiSizingMode.FixedSize,CanvasSize=Vector2.new(16,96),LightInfluence=0,Brightness=2.5,AlwaysOnTop=false,Parent=p})
                    local f = new("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,Parent=sg})
                    new("UIGradient",{Rotation=90,
                        Color=ColorSequence.new({ColorSequenceKeypoint.new(0,top),ColorSequenceKeypoint.new(0.35,EC),ColorSequenceKeypoint.new(1,EC)}),
                        Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.55),NumberSequenceKeypoint.new(0.1,0.12),NumberSequenceKeypoint.new(0.45,0.5),NumberSequenceKeypoint.new(1,1)}),
                        Parent=f})
                end
                parts[i] = p
                angs[i] = (i - 0.5) / SEG * math.pi * 2
            end
            local att = new("Attachment",{Parent=head})
            vfxObj.crownSpark = new("ParticleEmitter",{Texture="rbxassetid://243098098",Rate=6,Lifetime=NumberRange.new(0.8,1.4),Speed=NumberRange.new(0.3,0.8),SpreadAngle=Vector2.new(25,25),EmissionDirection=Enum.NormalId.Top,Color=ColorSequence.new(EC),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.2),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(1,1)}),LightEmission=1,Parent=att})
            vfxObj.crownAtt = att
            vfxObj.crownLight = new("PointLight",{Color=EC,Range=8,Brightness=2,Parent=head})
            vfxObj.crownModel = model
            local cfs, t = table.create(SEG), 0
            vfxObj.crownC = RS.RenderStepped:Connect(function(dt)
                if not head.Parent then return end
                t += dt
                local base = head.CFrame * CFrame.new(0, head.Size.Y * 0.5 - 0.3, 0)
                for i, p in ipairs(parts) do
                    local th = angs[i]
                    local h = 0.75 + 0.42 * (0.5 + 0.5 * math.cos(th * PEAKS + t * 0.9)) + 0.06 * math.sin(th * 7 - t * 1.7)
                    p.Size = Vector3.new(seg, h, 0.02)
                    cfs[i] = base * CFrame.Angles(0, th, 0) * CFrame.new(0, h * 0.5, -R)
                end
                workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
            end)
        end
        if feat.jumpRing then
            vfxObj.jr = hum.StateChanged:Connect(function(_, ns)
                if ns == Enum.HumanoidStateType.Jumping then
                    local h = char:FindFirstChild("HumanoidRootPart"); if not h then return end
                    ring(h.Position - Vector3.new(0,2.5,0), EC, 4)
                end
            end)
        end
        if feat.landRing then
            local wasAir = false
            vfxObj.lr = hum.StateChanged:Connect(function(_, ns)
                if ns == Enum.HumanoidStateType.Freefall then wasAir = true
                elseif ns == Enum.HumanoidStateType.Landed and wasAir then
                    wasAir = false
                    local h = char:FindFirstChild("HumanoidRootPart"); if not h then return end
                    ring(h.Position - Vector3.new(0,2.5,0), EC, 5)
                end
            end)
        end
    end

    if player.Character then task.spawn(Fn.rebuildVFX) end
    player.CharacterAdded:Connect(function() task.wait(0.5); Fn.rebuildVFX() end)
end

