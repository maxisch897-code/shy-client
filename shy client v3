local function mkT(p, label, def, cb, kbName)
    local st = def or false
    local row = new("TextButton",{Size=UDim2.new(1,-4,0,48),BackgroundColor3=T.Card,BackgroundTransparency=TR.Card,BorderSizePixel=0,AutoButtonColor=false,Text="",Parent=p})
    corner(row, RM); stroke(row, 1, 0.55, T.Line)
    regRef(row, "BackgroundColor3", "Card"); regCard(row)
    row.MouseEnter:Connect(function() tween(row, 0.15, {BackgroundColor3 = T.Hover}) end)
    row.MouseLeave:Connect(function() tween(row, 0.15, {BackgroundColor3 = T.Card}) end)
    local kW = kbName and 46 or 0
    local lbl = new("TextLabel",{Size=UDim2.new(1,-kW-80,1,0),Position=UDim2.new(0,18,0,0),BackgroundTransparency=1,Text=label,TextColor3=T.Text,Font=Enum.Font.GothamMedium,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=3,Parent=row})
    regRef(lbl, "TextColor3", "Text")
    local chip
    if kbName then
        chip = new("TextButton",{Size=UDim2.new(0,42,0,20),Position=UDim2.new(1,-106,0.5,-10),BackgroundColor3=T.Panel,BackgroundTransparency=TR.Card,BorderSizePixel=0,Text="—",TextColor3=T.Dim,Font=Enum.Font.GothamBold,TextSize=10,AutoButtonColor=false,ZIndex=4,Parent=row})
        corner(chip, 6); stroke(chip, 1, 0.55, T.Line)
        chip.MouseButton1Click:Connect(function() openKeyPrompt(kbName) end)
    end
    local track = new("Frame",{Size=UDim2.new(0,40,0,22),Position=UDim2.new(1,-54,0.5,-11),BackgroundColor3=st and T.On or T.Off,BackgroundTransparency=st and 0 or 0.25,BorderSizePixel=0,ZIndex=2,Parent=row})
    corner(track, 11)
    local trackGrad = gradient(track, T.Accent, T.Accent2, 0)
    trackGrad.Enabled = st
    local trackStroke = stroke(track, 1, st and 0.5 or 0.7, st and T.Accent or T.Line, true)
    local knob = new("Frame",{Size=UDim2.new(0,16,0,16),Position=st and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,3,0.5,-8),BackgroundColor3=st and Color3.fromRGB(255,255,255) or Color3.fromRGB(240,240,244),BorderSizePixel=0,ZIndex=3,Parent=track})
    corner(knob, 8)
    local function setSt(v)
        st = v
        tween(track, 0.22, {BackgroundColor3 = st and T.On or T.Off, BackgroundTransparency = st and 0 or 0.25})
        tween(knob, 0.22, {Position = st and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,3,0.5,-8), BackgroundColor3 = st and Color3.fromRGB(255,255,255) or Color3.fromRGB(240,240,244)})
        trackGrad.Enabled = st
        trackStroke.Color = st and T.Accent or T.Line
        trackStroke.Transparency = st and 0.5 or 0.7
        if cb then pcall(cb, st) end
    end
    row.MouseButton1Click:Connect(function() setSt(not st) end)
    if kbName then
        Keybinds[kbName] = {key=nil, label=label, isToggle=true, getState=function() return st end, setState=setSt}
        ToggleReg[kbName] = setSt
        task.spawn(function()
            local last
            while row.Parent do
                local k = Keybinds[kbName].key; local t = k and k.Name or "—"
                if t ~= last then chip.Text = t; chip.TextColor3 = k and T.Accent or T.Dim; last = t end
                task.wait(0.2)
            end
        end)
    end
end

