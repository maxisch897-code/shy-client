                end)
            end
        end
    end
    refreshList()
    hdr(pSaves, "Import")
    local ii = mkInput(pSaves, "Paste JSON", "{...}")
    mkB(pSaves, "Import from Field", function()
        if ii.Text == "" then notify("Import", "Paste JSON first", false) return end
        local ok, d = pcall(function() return HttpService:JSONDecode(ii.Text) end)
        if ok and type(d) == "table" then
