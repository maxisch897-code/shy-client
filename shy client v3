-- FREE CAM
-- ══════════════════════════════════════════════════════════════
do
    local fcConn, fcYaw, fcPitch = nil, 0, 0
    local fcPos = Vector3.new(0,0,0)
    local fcSaved = { anchored=false, walkSpeed=16, jumpPower=50 }
    local function freezePlayer()
        local char = player.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then
            fcSaved.anchored = hrp.Anchored
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.Anchored = true
        end
        if hum then
            fcSaved.walkSpeed = hum.WalkSpeed
            fcSaved.jumpPower = hum.JumpPower
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.AutoRotate = false
        end
    end
    local function unfreezePlayer()
        local char = player.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then hrp.Anchored = fcSaved.anchored end
        if hum then
            hum.WalkSpeed = feat.walkSpeed or fcSaved.walkSpeed
            hum.JumpPower = feat.jumpPower or fcSaved.jumpPower
            hum.AutoRotate = true
        end
    end
    Fn.startFreeCam = function()
        local kb = Keybinds["FreeCam"]
        if not (kb and kb.key) then notify("Free Cam", "Set a keybind first to enable Free Cam", false); return false end
        local x, y = camera.CFrame:ToEulerAnglesYXZ(); fcYaw, fcPitch = y, x
        fcPos = camera.CFrame.Position
        camera.CameraType = Enum.CameraType.Scriptable
        feat.freeCam = true
        UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
        freezePlayer()
        fcConn = RS.RenderStepped:Connect(function(dt)
            local d = Vector3.zero
            local cf = CFrame.new(fcPos) * CFrame.Angles(0, fcYaw, 0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then d += cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then d += cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d -= Vector3.new(0,1,0) end
            if d.Magnitude > 0 then fcPos += d.Unit * feat.freeCamSpeed * dt end
            camera.CFrame = CFrame.new(fcPos) * CFrame.Angles(0, fcYaw, 0) * CFrame.Angles(fcPitch, 0, 0)
        end)
        notify("Free Cam", "ON — press your keybind to exit")
        return true
    end
    Fn.stopFreeCam = function()
        feat.freeCam = false
        if fcConn then fcConn:Disconnect(); fcConn = nil end
        camera.CameraType = Enum.CameraType.Custom
        UIS.MouseBehavior = Enum.MouseBehavior.Default
        unfreezePlayer()
        notify("Free Cam", "OFF", false)
    end
    UIS.InputChanged:Connect(function(i)
        if not fcConn then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement then
            fcYaw = fcYaw - math.rad(i.Delta.X) * 1.5
            fcPitch = math.clamp(fcPitch - math.rad(i.Delta.Y) * 1.5, math.rad(-89), math.rad(89))
        end
    end)
    player.CharacterAdded:Connect(function()
        if feat.freeCam then
            task.wait(0.6)
            if feat.freeCam then freezePlayer() end
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- NEW: CAMERA FX  (screen shake, sprint FOV, camera roll)
-- ══════════════════════════════════════════════════════════════
do
    local shakeOffset = CFrame.new()
    local shakeDecay = 0
    local baseRoll = 0
    local lastFov = 70

    Fn.triggerShake = function(amount)
        if not feat.screenShake then return end
        shakeDecay = math.max(shakeDecay, amount * feat.shakeAmount)
    end

    local sprintFovAdded = 0
    local lastSprintState = false

    RS.RenderStepped:Connect(function(dt)
        -- screen shake
        if shakeDecay > 0.001 then
            local s = shakeDecay * 0.6
            shakeOffset = CFrame.new((math.random() - 0.5) * s, (math.random() - 0.5) * s, 0)
                * CFrame.Angles((math.random() - 0.5) * shakeDecay * 0.05, (math.random() - 0.5) * shakeDecay * 0.05, (math.random() - 0.5) * shakeDecay * 0.08)
            shakeDecay = shakeDecay * math.clamp(1 - dt * 8, 0, 1)
        else
            shakeOffset = CFrame.new()
            shakeDecay = 0
        end

        -- sprint FOV boost
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local sprinting = false
        if hum and hrp and hum.MoveDirection.Magnitude > 0.1 then
            local v = hrp.AssemblyLinearVelocity
            if Vector3.new(v.X, 0, v.Z).Magnitude > feat.walkSpeed * 0.9 then sprinting = true end
        end
        local targetBoost = 0
        if feat.sprintFov and sprinting then targetBoost = feat.sprintFovBoost end
        sprintFovAdded = sprintFovAdded + (targetBoost - sprintFovAdded) * math.clamp(dt * 4, 0, 1)

        -- camera roll on strafe
        local roll = 0
        if feat.cameraRoll and hum then
            local strafe = hum.MoveDirection:Dot(camera.CFrame.RightVector)
            roll = strafe * math.rad(feat.cameraRollAmount)
        end
        baseRoll = baseRoll + (roll - baseRoll) * math.clamp(dt * 6, 0, 1)
    end)

    -- apply camera effects after the camera updates
    local camApplyConn
    camApplyConn = RS.RenderStepped:Connect(function()
        if not camera then return end
        local fov = camera.FieldOfView
        if feat.sprintFov then
            local base = lastFov
            if not UI._fovBaseApplied then lastFov = fov; UI._fovBaseApplied = true end
        end
        if feat.screenShake or feat.cameraRoll then
            camera.CFrame = camera.CFrame * shakeOffset * CFrame.Angles(0, 0, baseRoll)
        end
    end)
end

