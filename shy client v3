            corner(e, RM); stroke(e, 1, 0.55, T.Line); regRef(e, "BackgroundColor3", "Card"); regCard(e)
            return
        end
        for i, name in ipairs(SaveOrder) do
            if Saves[name] then
                local row = new("Frame",{Size=UDim2.new(1,0,0,48),BackgroundColor3=T.Card,BackgroundTransparency=TR.Card,BorderSizePixel=0,LayoutOrder=i,Parent=sl})
                corner(row, RM); stroke(row, 1, 0.55, T.Line); regRef(row, "BackgroundColor3", "Card"); regCard(row)
                local nl = new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,16,0,0),Size=UDim2.new(1,-230,1,0),Font=Enum.Font.GothamMedium,Text=name,TextColor3=T.Text,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=3,Parent=row})
                regRef(nl, "TextColor3", "Text")
                local function mb(t, x, bg, fg, isAccent, cb)
                    local b = new("TextButton",{Size=UDim2.new(0,64,0,28),Position=UDim2.new(1,x,0.5,-14),BackgroundColor3=bg,Text=t,Font=Enum.Font.GothamBold,TextColor3=fg,TextSize=11,BorderSizePixel=0,AutoButtonColor=false,ZIndex=4,Parent=row})
                    corner(b, 7)
                    if isAccent then gradient(b, T.Accent, T.Accent2, 0) else stroke(b, 1, 0.55, T.Line) end
                    b.MouseButton1Click:Connect(cb)
                end
                mb("Load", -212, Color3.fromRGB(255,255,255), ON_ACCENT, true, function() if load(Saves[name]) then notify("Save", "Loaded: " .. name) end end)
                mb("Export", -142, T.Card, T.Text, false, function()
                    local ok, e = pcall(function() return HttpService:JSONEncode(Saves[name]) end)
                    if ok and setclipboard then setclipboard(e); notify("Save", "Copied") end
                end)
                mb("Delete", -72, T.Card, T.Bad, false, function()
