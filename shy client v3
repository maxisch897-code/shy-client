            Material=Enum.Material.Neon, Color=EFFECT_COLOR, Transparency=0.2, CFrame=CFrame.new(pos) * CFrame.new(-0.4, 0, 0), Parent=model})
        local wingR = new("Part", {Size=Vector3.new(0.6, 0.02, 0.5), Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false,
            Material=Enum.Material.Neon, Color=EFFECT_COLOR, Transparency=0.2, CFrame=CFrame.new(pos) * CFrame.new(0.4, 0, 0), Parent=model})
        butterflies[#butterflies+1] = {
            model = model, body = body, wingL = wingL, wingR = wingR,
            base = pos, ph = math.random() * 6.28, sp = 0.5 + math.random() * 0.7,
        }
    end
    RS.Heartbeat:Connect(function(dt)
        if feat.butterflies then
            lastSpawnB += dt
            if #butterflies < feat.butterflyCount and lastSpawnB > 0.3 then
                lastSpawnB = 0
                spawnButterfly()
            end
        elseif #butterflies > 0 then
            for _, b in ipairs(butterflies) do b.model:Destroy() end
            butterflies = {}
        end
        local t = tick()
        for _, b in ipairs(butterflies) do
            local offset = Vector3.new(
                math.sin(t * b.sp + b.ph) * 3,
                math.sin(t * b.sp * 1.7 + b.ph) * 1.2,
                math.cos(t * b.sp * 0.8 + b.ph) * 3
            )
            local pos = b.base + offset
            b.body.CFrame = CFrame.lookAt(pos, pos + Vector3.new(math.cos(t * b.sp + b.ph), 0.3, math.sin(t * b.sp + b.ph)))
            local flap = math.sin(t * 8 + b.ph) * 0.6
            b.wingL.CFrame = b.body.CFrame * CFrame.new(-0.15, 0, 0) * CFrame.Angles(0, 0, flap)
            b.wingR.CFrame = b.body.CFrame * CFrame.new(0.15, 0, 0) * CFrame.Angles(0, 0, -flap)
        end
    end)

    -- meteors
    local meteorAcc = 0
    local function spawnMeteor()
        local cam = workspace.CurrentCamera
        local pos = cam.CFrame.Position + cam.CFrame.LookVector * 200 + Vector3.new(math.random(-150, 150), 150 + math.random(50, 100), math.random(-150, 150))
        local dir = Vector3.new((math.random() - 0.5) * 2, -1, (math.random() - 0.5) * 2).Unit
        local m = new("Part", {Size=Vector3.new(1.5, 1.5, 12), Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false,
            Material=Enum.Material.Neon, Color=EFFECT_COLOR, CFrame=CFrame.lookAt(pos, pos + dir), Parent=workspace})
        local trail = new("Trail", {Attachment0=new("Attachment",{Parent=m}), Attachment1=new("Attachment",{Parent=m, Position=Vector3.new(0,0,-6)}),
            Color=ColorSequence.new(EFFECT_COLOR), Lifetime=1.5, LightEmission=1, Parent=m})
        trail.Attachment0.Position = Vector3.new(0,0,6)
        local t = 0
        local conn
        conn = RS.Heartbeat:Connect(function(dt)
            t += dt
            if not m.Parent then conn:Disconnect() return end
            m.CFrame = CFrame.lookAt(m.Position + dir * 120 * dt, m.Position + dir * 120 * dt + dir)
            if t > 2.5 then conn:Disconnect(); m:Destroy() end
        end)
    end
    RS.Heartbeat:Connect(function(dt)
        if not feat.meteorShower then return end
        meteorAcc += dt
        if meteorAcc >= 1 / feat.meteorRate then
            meteorAcc = 0
            spawnMeteor()
        end
    end)
end

