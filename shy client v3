-- With GlassmorphicUI on, panel tint alpha lives in the "Transparency" attribute
Fn.queueGlassAttr = function(f, name, value)
    Glass.pending = Glass.pending or {}
    Glass.pending[f] = Glass.pending[f] or {}
    Glass.pending[f][name] = value
    if Glass.flushQueued then return end
    Glass.flushQueued = true
    task.delay(0.12, function()
        Glass.flushQueued = false
        local p = Glass.pending; Glass.pending = {}
        for inst, attrs in pairs(p) do
            for k, val in pairs(attrs) do inst:SetAttribute(k, val) end
        end
    end)
end

Fn.panelT = function(f, t)
    if not (Glass.on and Glass.ok) then f.BackgroundTransparency = t
    elseif Glass.hq then Fn.queueGlassAttr(f, "Transparency", t)
    else Glass.SG.setT(f, t) end
end

Fn.applyAllTransparency = function()
    Fn.panelT(UI.mainPanel, TR.Window)
    Fn.panelT(UI.sidebar, TR.Sidebar)
    for _, f in ipairs(UI.cards) do
        if f.Parent then f.BackgroundTransparency = TR.Card end
    end
    for _, f in pairs(overlays) do
        if Glass.on and Glass.ok then Glass.SG.setT(f, TR.Overlay) else f.BackgroundTransparency = TR.Overlay end
    end
end

Fn.setOpacity = function(amount)
    TR.Window = amount; TR.Sidebar = amount * 0.7; TR.Content = amount * 0.8
    TR.Title = amount * 0.6; TR.Card = amount * 0.5
    TR.Overlay = math.min(amount + 0.05, 0.95); TR.Notify = amount * 0.8
    Fn.applyAllTransparency()
end

Fn.applyGlassTransparency = function()
    local b = Glass.clarity / 100
    TR.Window = b; TR.Sidebar = math.max(b - 0.02, 0); TR.Content = b; TR.Title = b
    TR.Card = Glass.ok and math.clamp(b - 0.3, 0.12, 0.55) or math.min(b + 0.18, 0.93); TR.Overlay = Glass.ok and math.clamp(b - 0.25, 0.3, 0.7) or math.max(b - 0.05, 0); TR.Notify = math.max(b - 0.05, 0)
    Fn.applyAllTransparency()
end

Fn.menuBlur = function()
    if not Glass.on then return 6 end
    return Glass.ok and 0 or Glass.blur
end

Fn.setGlassAttr = function(name, value)
    for _, f in ipairs({UI.sidebar, UI.mainPanel}) do f:SetAttribute(name, value) end
end

Fn.setRealGlass = function(on)
    if not Glass.ok then return end
    local lib, hq = Glass.lib, on and Glass.hq
    if hq then
        Fn.setGlassAttr("SuperEllipseFactor", 2)   -- match the circular UICorner + stroke
        Fn.setGlassAttr("BlurRadius", UDim.new(0, math.max(Glass.blur, 1)))
        Fn.setGlassAttr("RefractionFactor", Glass.refraction)
        Fn.setGlassAttr("MaxOutputResolution", 1024)
        local C = lib.Config   -- full quality + fast convergence for HQ
        C.SAMPLING_CELL_SIZE = 4; C.TEMPORAL_SMOOTHING = 0.85
        C.SAMPLE_TIME_BUDGET = 6e-3; C.LIQUID_TIME_BUDGET = 10e-3
    end
    for _, f in ipairs({UI.sidebar, UI.mainPanel}) do
        local t = (f == UI.sidebar) and TR.Sidebar or TR.Window
        Glass.SG.enable(f, on and not Glass.hq, t)
        if hq then
            f:SetAttribute("Transparency", t)
            if not f:HasTag(lib.TAG_NAME) then lib.addGlassBackground(f) end
        elseif f:HasTag(lib.TAG_NAME) then
            f:RemoveTag(lib.TAG_NAME)
        end
    end
    -- overlays always use the smooth engine (they stay on screen with the menu closed)
    for _, f in pairs(overlays) do Glass.SG.enable(f, on, TR.Overlay, true) end
    task.delay(0.1, Fn.syncGlass)
end

-- HQ engine only: freeze GlassmorphicUI while the window is dragged/resized
Fn.dragState = function(f, on)
    local mp = UI.mainPanel
    if not (mp and (f == mp or f:IsAncestorOf(mp))) then return end
    Glass.dragging = on
    if Glass.on and Glass.ok and Glass.hq then Fn.syncGlass() end
end

-- Pause HQ glass while the menu is hidden; keep panel backgrounds right for whichever renderer is active
Fn.syncGlass = function()
    if not Glass.ok then return end
    local lib = Glass.lib
    for _, f in ipairs({UI.sidebar, UI.mainPanel}) do
        if Glass.on and Glass.hq then
            if UI.isOpen then lib.resumeUpdates(f) else lib.pauseUpdates(f) end
        elseif Glass.on then
            f.BackgroundTransparency = 1
        else
            f.BackgroundTransparency = (f == UI.sidebar) and TR.Sidebar or TR.Window
        end
    end
end

Fn.setGlassEngine = function(hq)
    Glass.hq = hq
    if Glass.on and Glass.ok then Fn.setRealGlass(true); Fn.applyGlassTransparency() end
end

-- Liquid Glass: soft dark outline on all menu/overlay text so it reads on clear glass
Fn.applyTextShadow = function(inst)
    if not (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then return end
    local orig = Glass.txt[inst]
    if Glass.on then
        if orig == nil then Glass.txt[inst] = {inst.TextStrokeTransparency, inst.TextStrokeColor3} end
        inst.TextStrokeColor3 = Color3.new(0, 0, 0)
        inst.TextStrokeTransparency = 0.6
    elseif orig then
        inst.TextStrokeTransparency, inst.TextStrokeColor3 = orig[1], orig[2]
        Glass.txt[inst] = nil
    end
end
Fn.setTextShadows = function()
    for _, g in ipairs({UI.gui, UI.ovGui}) do
        if g then
            for _, d in ipairs(g:GetDescendants()) do Fn.applyTextShadow(d) end
            if not Glass.txtHooked then
                g.DescendantAdded:Connect(function(d) if Glass.on then task.defer(Fn.applyTextShadow, d) end end)
            end
        end
    end
    Glass.txtHooked = true
end

Fn.setGlass = function(on, quiet)
    if on == Glass.on then return end
    Glass.on = on
    if on then
        Glass.savedT = {}
        for k, v in pairs(GLASS_T) do Glass.savedT[k] = T[k]; T[k] = v end
    elseif Glass.savedT then
        for k, v in pairs(Glass.savedT) do T[k] = v end
        Glass.savedT = nil
    end
    applyTheme()
    Fn.setTextShadows()
    for _, g in ipairs(GlassGrads) do if g.Parent then g.Enabled = on end end
    for _, e in ipairs(GlassStrokes) do
        if e.s.Parent then e.g.Enabled = on; e.s.Transparency = on and 0.2 or e.o end
    end
    Fn.setRealGlass(on)
    if on then Fn.applyGlassTransparency() else Fn.setOpacity(UI.opacity / 100) end
    if UI.isOpen then TS:Create(glassBlur, TweenInfo.new(0.3), {Size = Fn.menuBlur()}):Play() end
    if Fn.refreshKb then Fn.refreshKb() end
    if Fn.updateHud then Fn.updateHud() end
    if not quiet then
        local msg = not on and "OFF" or (Glass.ok and (Glass.hq and "ON  (GlassmorphicUI HQ)" or "ON  (Smooth engine)") or "ON  (fallback, EditableImage blocked)")
        notify("Liquid Glass", msg, on)
    end
end

Fn.setEffectColor = function(c, quiet)
    EFFECT_COLOR = c
    if UI.colorPreview then UI.colorPreview.BackgroundColor3 = c end
    if UI.colorInput then UI.colorInput.Text = colorToHex(c) end
    Fn.rebuildVFX(); Wx.color()
    if Fn.skyRecolor then Fn.skyRecolor() end
    if not quiet then notify("Color", "Applied to all effects") end
end

Fn.hudPack = function(presetName)
    if presetName and PRESETS[presetName] then
        Fn.setGlass(false, true)
        for k, v in pairs(PRESETS[presetName]) do T[k] = v end
        applyTheme(); Fn.applyAllTransparency(); Fn.refreshKb()
    end
    UI.hudSync = true   -- effects (tint, vignette, cubes, ...) now follow the theme accent
    Fn.setEffectColor(T.Accent, true)
    for _, n in ipairs({"MusicHud","Coords","SpeedHud","KbOverlay","LyricsBar","FxTint","FxVignette","FxBloom"}) do
        if ToggleReg[n] then ToggleReg[n](true) end
    end
    Fn.updateHud()
    notify("HUD Pack", (presetName or "Current theme") .. " HUD enabled")
end

