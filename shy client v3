-- SAVES --------------------------------------------------------
do
    local Saves, SaveOrder = {}, {}
    local SAVE_FILE = "shyclient_saves.json"
    local OVKB = {statusBar="StatusBar", fps="FpsBox", coords="Coords", ping="PingBox", watermark="Watermark",
                  keybinds="KbOverlay", musicHud="MusicHud", speed="SpeedHud", lyrics="LyricsBar"}
    local FEATMAP = {
        Fly="fly", InfJump="infJump", NoClip="noclip", FreeCam="freeCam", Fullbright="fullbright",
        VFXGlow="glow", VFXNeon="neon", VFXTrail="trail", VFXFire="fire",
        VFXSparkle="sparkle", VFXHalo="halo", VFXWings="wings", VFXCrown="crown",
        SkyBlackHole="skyBlackHole", SkyAurora="skyAurora", SkyGalaxy="skyGalaxy", SkyNebula="skyNebula", SkyStarryNight="skyStarryNight", VFXJumpRing="jumpRing", VFXLandRing="landRing",
        WxRain="rain", WxSnow="snow", WxFog="fog", WxThunder="thunder", FxFireflies="fireflies",
        FxCubes="cubes", FxAmbient="ambient", FxGhost="ghost", FxTint="tint", FxBloom="bloom", FxVignette="vignette",
        Lyrics3D="lyrics3d",
    }

    local function col(t)
        if type(t) == "table" and #t == 3 then return Color3.new(t[1], t[2], t[3]) end
        return nil
    end

    local function snap()
        local d = {theme={}, transparency={}, features={}, keybinds={}, sliders={}, overlays={}, meta={}, music={}, glass={}}
        local base = Glass.on and Glass.savedT or nil
        for k, v in pairs(T) do
            if typeof(v) == "Color3" then
                local use = (base and base[k]) or v
                d.theme[k] = {use.R, use.G, use.B}
            end
        end
        for k, v in pairs(TR) do d.transparency[k] = v end
        for k, v in pairs(feat) do if type(v) == "boolean" or type(v) == "number" then d.features[k] = v end end
        d.features.effectColor = {EFFECT_COLOR.R, EFFECT_COLOR.G, EFFECT_COLOR.B}
        for n, kb in pairs(Keybinds) do d.keybinds[n] = kb.key and kb.key.Name or nil end
        for n, s in pairs(SliderReg) do local ok, v = pcall(s.get); if ok then d.sliders[n] = v end end
        for name, frame in pairs(overlays) do
            d.overlays[name] = {xS=frame.Position.X.Scale, xO=frame.Position.X.Offset, yS=frame.Position.Y.Scale, yO=frame.Position.Y.Offset, vis=frame.Visible}
        end
        local win = UI.win
        d.meta.winPos = {xS=win.Position.X.Scale, xO=win.Position.X.Offset, yS=win.Position.Y.Scale, yO=win.Position.Y.Offset}
        d.meta.winSize = {w=win.Size.X.Offset, h=win.Size.Y.Offset}
        d.music = {volume=Music.volume, looped=Music.looped}
        d.glass = {on=Glass.on, clarity=Glass.clarity, blur=Glass.blur, refraction=Glass.refraction, hq=Glass.hq, opacity=UI.opacity}
        return d
    end

    local function load(d)
        if type(d) ~= "table" then return false end
        Fn.setGlass(false, true)
        if d.theme then
            for k, v in pairs(d.theme) do local c = col(v); if c then T[k] = c end end
            applyTheme()
        end
        if d.transparency then
            for k, v in pairs(d.transparency) do if TR[k] ~= nil then TR[k] = v end end
            Fn.applyAllTransparency()
        end
        if d.keybinds then
            for n, kn in pairs(d.keybinds) do
                if Keybinds[n] then
                    if kn then local kc = Enum.KeyCode[kn]; if kc then Keybinds[n].key = kc end
                    else Keybinds[n].key = nil end
                end
            end
        end
        if d.features then
            for k, v in pairs(d.features) do
                if k == "effectColor" then
                    local c = col(v); if c then Fn.setEffectColor(c, true) end
                elseif feat[k] ~= nil then feat[k] = v end
            end
            for kbName, featKey in pairs(FEATMAP) do
                if ToggleReg[kbName] and feat[featKey] ~= nil then
                    pcall(function() ToggleReg[kbName](feat[featKey]) end)
                end
            end
            Fn.rebuildVFX(); Wx.all()
        end
        if d.sliders then
            for n, v in pairs(d.sliders) do
                local s = SliderReg[n]
                if s then pcall(function() s.set(v) end) end
            end
        end
        if d.overlays then
            for name, pos in pairs(d.overlays) do
                local key = (name == "keybindOverlay") and "keybinds" or name
                local f = overlays[key]
                if f then
                    f.Position = UDim2.new(pos.xS, pos.xO, pos.yS, pos.yO)
                    local m = OVKB[key]
                    if m and ToggleReg[m] then pcall(ToggleReg[m], pos.vis) else f.Visible = pos.vis end
                end
            end
            Fn.refreshKb()
        end
        if d.meta then
            local win = UI.win
            if d.meta.winPos then win.Position = UDim2.new(d.meta.winPos.xS, d.meta.winPos.xO, d.meta.winPos.yS, d.meta.winPos.yO) end
            if d.meta.winSize then
                win.Size = UDim2.new(0, math.max(UI.MIN_W, d.meta.winSize.w or UI.ROOT_W), 0, math.max(UI.MIN_H, d.meta.winSize.h or UI.MAIN_H))
            end
        end
        if d.music then
            if d.music.volume then Music.volume = d.music.volume; Music.sound.Volume = Music.volume end
            if d.music.looped ~= nil then
                Music.looped = d.music.looped; Music.sound.Looped = Music.looped
                if UI.loopBtn then UI.loopBtn.Text = Music.looped and "Loop: ON" or "Loop: OFF" end
            end
        end
        if d.glass then
            if d.glass.opacity then UI.opacity = d.glass.opacity end
            if d.glass.clarity then Glass.clarity = d.glass.clarity end
            if d.glass.blur then Glass.blur = d.glass.blur end
            if d.glass.refraction then Glass.refraction = d.glass.refraction end
            if d.glass.hq ~= nil and ToggleReg.GlassHQ then pcall(ToggleReg.GlassHQ, d.glass.hq == true) end
            if d.glass.on then Fn.setGlass(true, true) end
        end
        Fn.updateHud()
        return true
    end

