	if textYAlignment == Enum.TextYAlignment.Top then
		if pixelsY > textBoundsY then
			return r, g, b, a
		end
	elseif textYAlignment == Enum.TextYAlignment.Bottom then
		if pixelsY < sizeY - textBoundsY then
			return r, g, b, a
		end
