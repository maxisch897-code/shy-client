local function mkS(p, label, mn, mx, def, cb, saveName, isF)
    local v = def
    local row = new("Frame",{Size=UDim2.new(1,-4,0,58),BackgroundColor3=T.Card,BackgroundTransparency=TR.Card,BorderSizePixel=0,Parent=p})
    corner(row, RM); stroke(row, 1, 0.55, T.Line)
    regRef(row, "BackgroundColor3", "Card"); regCard(row)
    local lbl = new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,18,0,9),Size=UDim2.new(1,-120,0,16),Font=Enum.Font.GothamMedium,Text=label,TextColor3=T.Text,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=3,Parent=row})
    regRef(lbl, "TextColor3", "Text")
    local vBox = new("Frame",{Position=UDim2.new(1,-72,0,7),Size=UDim2.new(0,54,0,20),BackgroundColor3=T.Accent,BackgroundTransparency=0,BorderSizePixel=0,ZIndex=3,Parent=row})
    corner(vBox, 6); gradient(vBox, T.Accent, T.Accent2, 0)
    local vLbl = new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),Font=Enum.Font.GothamBold,Text=tostring(v),TextColor3=ON_ACCENT,TextSize=11,ZIndex=4,Parent=vBox})
    local track = new("Frame",{Position=UDim2.new(0,18,0,38),Size=UDim2.new(1,-90,0,4),BackgroundColor3=T.Off,BackgroundTransparency=0.2,BorderSizePixel=0,ZIndex=3,Parent=row})
    corner(track, 2)
    local fill = new("Frame",{Size=UDim2.new((v-mn)/(mx-mn),0,1,0),BackgroundColor3=T.Accent,BackgroundTransparency=0,BorderSizePixel=0,ZIndex=4,Parent=track})
    corner(fill, 2); gradient(fill, T.Accent, T.Accent2, 0)
    local function setV(nv, force)
        nv = math.clamp(nv, mn, mx)
        local old = v
        if isF then v = math.floor(nv*100+0.5)/100 else v = math.floor(nv+0.5) end
        vLbl.Text = tostring(v)
        tween(fill, 0.1, {Size = UDim2.new((v-mn)/(mx-mn),0,1,0)})
        if cb and (force or v ~= old) then pcall(cb, v) end
    end
    -- big invisible hit area over the thin track; mouse + touch; page doesn't scroll while dragging
    local hit = new("TextButton",{Position=UDim2.new(0,8,0,26),Size=UDim2.new(1,-74,0,30),BackgroundTransparency=1,Text="",AutoButtonColor=false,ZIndex=6,Parent=row})
    local d = false
    local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
    local function fx(x)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        setV(mn + math.clamp((x - track.AbsolutePosition.X) / w, 0, 1) * (mx - mn))
    end
    hit.InputBegan:Connect(function(i)
        if not isPress(i) then return end
        d = true
        if p:IsA("ScrollingFrame") then p.ScrollingEnabled = false end
        fx(i.Position.X)
    end)
    UIS.InputChanged:Connect(function(i)
        if d and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fx(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if d and isPress(i) then
            d = false
            if p:IsA("ScrollingFrame") then p.ScrollingEnabled = true end
        end
    end)
    if saveName then SliderReg[saveName] = {get=function() return v end, set=function(x) setV(x, true) end} end
end

