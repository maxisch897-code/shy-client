            atmo = new("Atmosphere", {Name="ShyFog", Density=feat.fogDensity, Offset=0.25, Color=Color3.fromRGB(200, 210, 225), Decay=Color3.fromRGB(110, 120, 140), Glare=0, Haze=2, Parent=Lighting})
