            vfxObj.trailA0, vfxObj.trailA1 = a0, a1
        end
        if feat.rainbowTrail then
            local a0 = new("Attachment",{Position=Vector3.new(0,0.7,0),Parent=hrp})
            local a1 = new("Attachment",{Position=Vector3.new(0,-0.7,0),Parent=hrp})
            local tr = new("Trail",{Attachment0=a0,Attachment1=a1,Lifetime=1.5,LightEmission=1,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.1),NumberSequenceKeypoint.new(1,1)}),WidthScale=NumberSequence.new({NumberSequenceKeypoint.new(0,1.2),NumberSequenceKeypoint.new(1,0)}),Parent=hrp})
            vfxObj.rbc = RS.RenderStepped:Connect(function() tr.Color = ColorSequence.new(Color3.fromHSV((tick()*0.6)%1,1,1)) end)
            vfxObj.rbA0, vfxObj.rbA1, vfxObj.rbT = a0, a1, tr
        end
        if feat.fire then
            vfxObj.fire = new("ParticleEmitter",{Texture="rbxassetid://243098098",Rate=60,Lifetime=NumberRange.new(0.5,1),Speed=NumberRange.new(3,6),SpreadAngle=Vector2.new(15,15),Color=ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.new(math.min(EC.R+0.3,1),math.min(EC.G+0.3,1),math.min(EC.B+0.3,1))),
                ColorSequenceKeypoint.new(0.4, EC),
                ColorSequenceKeypoint.new(1, Color3.new(EC.R*0.3,EC.G*0.3,EC.B*0.3)),
            }),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.1),NumberSequenceKeypoint.new(1,1)}),LightEmission=1,Parent=hrp})
            vfxObj.fireL = new("PointLight",{Color=EC,Range=18,Brightness=4,Parent=hrp})
        end
        if feat.sparkle then
            vfxObj.sparkle = new("ParticleEmitter",{Texture="rbxassetid://243098098",Rate=25,Lifetime=NumberRange.new(1.2,2.2),Speed=NumberRange.new(0,0.5),SpreadAngle=Vector2.new(180,180),Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,255,255)),ColorSequenceKeypoint.new(1,EC)}),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(0.4,0.7),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}),LightEmission=1,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-50,50),Parent=hrp})
        end
        if feat.halo then
            local h = new("Part",{Anchored=false,CanCollide=false,CanQuery=false,CanTouch=false,Shape=Enum.PartType.Cylinder,Size=Vector3.new(0.2,2.5,2.5),Material=Enum.Material.Neon,Color=EC,Transparency=0.2,Massless=true,Parent=hrp})
            new("WeldConstraint",{Part0=hrp,Part1=h,Parent=h})
            h.CFrame = hrp.CFrame * CFrame.new(0,4,0) * CFrame.Angles(0,0,math.rad(90))
            vfxObj.haloC = RS.RenderStepped:Connect(function()
                if h.Parent then h.CFrame = hrp.CFrame * CFrame.new(0,4,0) * CFrame.Angles(0,0,math.rad(90)) end
