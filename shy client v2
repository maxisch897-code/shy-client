-- WORLD FX  (weather, floating cubes, ghost trail, screen effects)
-- ══════════════════════════════════════════════════════════════
do
    local fx = new("Folder", {Name="ShyFX", Parent=workspace})
    local function emitterPart(name, size)
        return new("Part", {Name=name,Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,Transparency=1,Size=size,Parent=fx})
    end
