local RB, RM, RS_ = 14, 10, 7
local EFFECT_COLOR = Color3.fromRGB(100, 200, 255)
local ON_ACCENT = Color3.fromRGB(30, 30, 35)

local function regRef(i, p, k) ThemeRefs[#ThemeRefs+1] = {inst=i, prop=p, key=k} end
local function applyTheme()
    local keep = {}
    for _, r in ipairs(ThemeRefs) do
        if r.inst and r.inst:IsDescendantOf(game) then
            keep[#keep+1] = r
            local v = T[r.key]; if v then pcall(function() r.inst[r.prop] = v end) end
        end
    end
    ThemeRefs = keep
end

local function new(c, p) local i = Instance.new(c); for k, v in pairs(p or {}) do i[k] = v end; return i end
local function corner(i, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or RS_); c.Parent = i; return c end
local function gradient(i, c1, c2, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c1, c2)
    g.Rotation = rot or 0
    g.Parent = i
    return g
end
local function tween(o, t, p) local x = TS:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p); x:Play(); return x end
local function hexToColor(h)
    h = tostring(h or ""):gsub("#", ""):gsub("%s", "")
    if #h ~= 6 or not h:match("^%x%x%x%x%x%x$") then return nil end
    return Color3.fromRGB(tonumber(h:sub(1,2),16), tonumber(h:sub(3,4),16), tonumber(h:sub(5,6),16))
end
local function colorToHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
end

local function stroke(p, t, tr, c, skip)
    local s = Instance.new("UIStroke")
    s.Color = c or T.Line; s.Thickness = t or 1; s.Transparency = tr or 0.6
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p
    if not skip then
        if not c or c == T.Line then regRef(s, "Color", "Line") end
        local g = Instance.new("UIGradient")
        g.Rotation = 45
        g.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.35, 0.8),
            NumberSequenceKeypoint.new(0.65, 0.8), NumberSequenceKeypoint.new(1, 0.05),
        })
        g.Enabled = Glass.on
        g.Parent = s
        GlassStrokes[#GlassStrokes+1] = { s=s, g=g, o=s.Transparency }
        if Glass.on then s.Transparency = 0.2 end
    end
    return s
end

local function addSheen(f)
    local g = Instance.new("UIGradient")
    g.Name = "ShyGlass"
    g.Rotation = 35
    g.Color = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(205,218,245))
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.12), NumberSequenceKeypoint.new(1, 0.3),
    })
    g.Enabled = Glass.on
    g.Parent = f
    GlassGrads[#GlassGrads+1] = g
end

local function prune()
    local c = {}
    for _, f in ipairs(UI.cards) do if f:IsDescendantOf(game) then c[#c+1] = f end end
    UI.cards = c
    local g = {}
    for _, x in ipairs(GlassGrads) do if x:IsDescendantOf(game) then g[#g+1] = x end end
    GlassGrads = g
    local s = {}
    for _, e in ipairs(GlassStrokes) do if e.s:IsDescendantOf(game) then s[#s+1] = e end end
    GlassStrokes = s
end

local function regCard(f)
    table.insert(UI.cards, f)
    addSheen(f)
    UI.n += 1
    if UI.n % 200 == 0 then prune() end
end

local function drag(f, h)
    h = h or f
    local d, s, sp
    h.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then d = true; s = i.Position; sp = f.Position end end)
    UIS.InputChanged:Connect(function(i)
        if d and i.UserInputType == Enum.UserInputType.MouseMovement then
            local dd = i.Position - s
            f.Position = UDim2.new(sp.X.Scale, sp.X.Offset + dd.X, sp.Y.Scale, sp.Y.Offset + dd.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then d = false end end)
end

