    Wx.fireflies = function()
        if flyE then flyE:Destroy(); flyE = nil end
        if not feat.fireflies then return end
        flyE = new("ParticleEmitter", {
            Rate=18, Lifetime=NumberRange.new(5, 8), Speed=NumberRange.new(0.5, 1.5),
            EmissionDirection=Enum.NormalId.Top, SpreadAngle=Vector2.new(180, 180),
            Size=NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.28), NumberSequenceKeypoint.new(1, 0)}),
            Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.1), NumberSequenceKeypoint.new(0.8, 0.1), NumberSequenceKeypoint.new(1, 1)}),
            Color=ColorSequence.new(EFFECT_COLOR), LightEmission=1, Acceleration=Vector3.new(0, 0.4, 0), Parent=vol,
        })
    end

    -- floating cubes
    local function mkCube(size, transp)
        return new("Part", {Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,Material=Enum.Material.Neon,Size=Vector3.new(size,size,size),Color=EFFECT_COLOR,Transparency=transp,Parent=fx})
    end
    Wx.cubes = function()
        for _, p in ipairs(cubes) do p:Destroy() end
        cubes = {}
        if feat.cubes then for i = 1, feat.cubeCount do cubes[i] = mkCube(0.7, 0.2) end end
    end
    Wx.ambient = function()
        for _, e in ipairs(amb) do e.part:Destroy() end
        amb = {}
        if feat.ambient then
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local base = hrp and hrp.Position or camera.CFrame.Position
            for i = 1, 28 do
                amb[i] = {
                    part = mkCube(0.3 + math.random() * 0.6, 0.35),
                    pos = base + Vector3.new(math.random(-45, 45), math.random(-6, 18), math.random(-45, 45)),
                    s = 0.6 + math.random() * 1.2, ph = math.random() * 6.28,
                }
            end
        end
    end

    -- screen effects
    Wx.tint = function()
        tint.Enabled = feat.tint
        local k = feat.tintStrength / 100
        tint.TintColor = Color3.new(1, 1, 1):Lerp(EFFECT_COLOR, k * 0.75)
        tint.Saturation = 0.15 * k
        tint.Contrast = 0.08 * k
        tint.Brightness = -0.03 * k
    end
    Wx.bloom = function() bloom.Enabled = feat.bloom end

    local vig = {}
    do
        local function edge(size, pos, rot)
            local f = new("Frame", {Size=size, Position=pos, BackgroundColor3=Color3.fromRGB(0, 10, 10), BorderSizePixel=0, Visible=false, ZIndex=1, Parent=UI.ovGui})
            local g = Instance.new("UIGradient")
            g.Rotation = rot
            g.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1)})
            g.Parent = f
            vig[#vig+1] = f
        end
        edge(UDim2.new(1,0,0.3,0), UDim2.new(0,0,0,0), 90)
        edge(UDim2.new(1,0,0.3,0), UDim2.new(0,0,0.7,0), 270)
        edge(UDim2.new(0.22,0,1,0), UDim2.new(0,0,0,0), 0)
        edge(UDim2.new(0.22,0,1,0), UDim2.new(0.78,0,0,0), 180)
    end
    Wx.vignette = function()
        for _, f in ipairs(vig) do f.Visible = feat.vignette end
    end

    -- ghost trail (afterimage clones)
    local function spawnGhost(char)
        local ok, c = pcall(function() return char:Clone() end)
        if not ok or not c then return end
        local parts = {}
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Anchored = true; d.CanCollide = false; d.CanQuery = false; d.CanTouch = false; d.CastShadow = false
                d.Material = Enum.Material.Neon; d.Color = EFFECT_COLOR
                if d.Name == "HumanoidRootPart" then d.Transparency = 1 else d.Transparency = 0.45; parts[#parts+1] = d end
            elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Decal") or d:IsA("Texture") or d:IsA("Humanoid")
                or d:IsA("Sound") or d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d:IsA("Trail")
                or d:IsA("Light") or d:IsA("Highlight") or d:IsA("Beam") or d:IsA("SurfaceAppearance") then
                d:Destroy()
            end
        end
        c.Parent = fx
        for _, p in ipairs(parts) do
            TS:Create(p, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1}):Play()
        end
        task.delay(0.7, function() c:Destroy() end)
    end

    -- recolor everything on effect-color change
    Wx.color = function()
        for _, p in ipairs(cubes) do p.Color = EFFECT_COLOR end
        for _, e in ipairs(amb) do e.part.Color = EFFECT_COLOR end
        if feat.fireflies then Wx.fireflies() end
        Wx.tint()
        for _, f in ipairs(vig) do f.BackgroundColor3 = EFFECT_COLOR:Lerp(Color3.new(0, 0, 0), 0.85) end
    end

    Wx.all = function()
        Wx.rain(); Wx.snow(); Wx.fog(); Wx.fireflies(); Wx.cubes(); Wx.ambient(); Wx.tint(); Wx.bloom(); Wx.vignette()
    end

    -- update loop
    local t0, lastGhost = tick(), 0
    RS.RenderStepped:Connect(function(dt)
        camera = workspace.CurrentCamera or camera
        local cp = camera.CFrame.Position
        sky.CFrame = CFrame.new(cp + Vector3.new(0, 45, 0))
        vol.CFrame = CFrame.new(cp)
        local now = tick() - t0
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if feat.cubes then
            local n = #cubes
            for i, c in ipairs(cubes) do
                local a = now * feat.cubeSpeed + (i / math.max(n, 1)) * math.pi * 2
                local r = feat.cubeRadius
                local pos = hrp.Position + Vector3.new(math.cos(a) * r, 0.8 + math.sin(now * 2 + i) * 0.9, math.sin(a) * r)
                c.CFrame = CFrame.new(pos) * CFrame.Angles(now + i, now * 1.3, i)
            end
        end

        if feat.ambient then
            for _, e in ipairs(amb) do
                e.pos = e.pos + Vector3.new(math.sin(now * 0.3 + e.ph) * 0.4 * dt, 0.3 * dt, math.cos(now * 0.25 + e.ph) * 0.4 * dt)
                if (e.pos - hrp.Position).Magnitude > 55 or e.pos.Y > hrp.Position.Y + 35 then
                    e.pos = hrp.Position + Vector3.new(math.random(-45, 45), math.random(-6, 4), math.random(-45, 45))
                end
                local p = e.pos + Vector3.new(0, math.sin(now * e.s + e.ph) * 1.2, 0)
                e.part.CFrame = CFrame.new(p) * CFrame.Angles(now * e.s, now * e.s * 0.7, e.ph)
            end
        end

        if feat.ghost and now - lastGhost >= feat.ghostInterval then
            local v = hrp.AssemblyLinearVelocity
            if Vector3.new(v.X, 0, v.Z).Magnitude > 3 then
                lastGhost = now
                spawnGhost(char)
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(math.random(7, 16))
            if feat.thunder then
                for _ = 1, 2 do
                    flash.Brightness = 0.5
                    task.wait(0.06)
                    tween(flash, 0.25, {Brightness = 0})
                    task.wait(0.35)
                end
            end
        end
    end)

    player.CharacterAdded:Connect(function() task.wait(1); if feat.ambient then Wx.ambient() end end)
end

