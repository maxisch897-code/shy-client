            vfxObj.g2 = new("PointLight",{Color=EC,Range=20,Brightness=3,Parent=hrp})
        end
        if feat.neon then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.Material = Enum.Material.Neon end end end
