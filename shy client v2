    local rainE, snowE, flyE, atmo
    local tint = new("ColorCorrectionEffect", {Name="ShyTint", Enabled=false, Parent=Lighting})
    local flash = new("ColorCorrectionEffect", {Name="ShyFlash", Parent=Lighting})
    local bloom = new("BloomEffect", {Name="ShyBloom", Enabled=false, Intensity=0.7, Size=28, Threshold=0.85, Parent=Lighting})
    local cubes, amb = {}, {}

    -- weather
    Wx.rain = function()
        if rainE then rainE:Destroy(); rainE = nil end
        if not feat.rain then return end
        rainE = new("ParticleEmitter", {
            Rate=900, Lifetime=NumberRange.new(0.55, 0.65), Speed=NumberRange.new(95, 110),
            EmissionDirection=Enum.NormalId.Bottom, SpreadAngle=Vector2.new(2, 2),
            Orientation=Enum.ParticleOrientation.VelocityParallel,
            Size=NumberSequence.new(0.5), Squash=NumberSequence.new(-3),
            Transparency=NumberSequence.new(0.45), Color=ColorSequence.new(Color3.fromRGB(175, 200, 255)),
            LightEmission=0.25, Acceleration=Vector3.new(-8, 0, 0), Parent=sky,
        })
    end
    Wx.snow = function()
        if snowE then snowE:Destroy(); snowE = nil end
        if not feat.snow then return end
        snowE = new("ParticleEmitter", {
            Rate=350, Lifetime=NumberRange.new(7, 9), Speed=NumberRange.new(5, 8),
            EmissionDirection=Enum.NormalId.Bottom, SpreadAngle=Vector2.new(25, 25),
            Size=NumberSequence.new(0.35), Transparency=NumberSequence.new(0.15),
            Color=ColorSequence.new(Color3.fromRGB(255, 255, 255)), LightEmission=0.4,
            Acceleration=Vector3.new(3, 0, 2), Rotation=NumberRange.new(0, 360), RotSpeed=NumberRange.new(-40, 40), Parent=sky,
        })
    end
    Wx.fog = function()
        if atmo then atmo:Destroy(); atmo = nil end
