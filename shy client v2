        end

        if overlays.lyrics.Visible then
            local lines = Lyrics.lines
            local n = #lines
            if n == 0 then
                if Lyrics.key ~= "none" then
                    Lyrics.key = "none"
                    lyLbl.Text = '<font color="'..colorToHex(T.Muted)..'">♪  no lyrics loaded</font>'
                end
            else
                local pos = Music.sound.TimePosition + Lyrics.offset
                local idx = 0
                for i = 1, n do if lines[i].t <= pos then idx = i else break end end
                if idx == 0 then
                    if Lyrics.key ~= "pre" then Lyrics.key = "pre"; lyLbl.Text = '<font color="'..colorToHex(T.Muted)..'">♪</font>' end
                else
                    local L = lines[idx]
                    local t1 = lines[idx+1] and lines[idx+1].t or (L.t + 4)
                    local dur = math.clamp(t1 - L.t, 0.5, 6) * 0.85
                    local f = math.clamp((pos - L.t) / dur, 0, 1)
                    local widx = #L.words
                    for i = 1, #L.words do if f <= L.cum[i] then widx = i; break end end
                    local key = idx * 1000 + widx
                    if Lyrics.key ~= key then
                        Lyrics.key = key
                        local acc, dimc = colorToHex(T.Accent), "#8C93A6"
                        local parts = {}
                        for i, w in ipairs(L.words) do
                            w = w:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
                            if i < widx then parts[#parts+1] = '<font color="#FFFFFF">'..w..'</font>'
                            elseif i == widx then parts[#parts+1] = '<font color="'..acc..'"><b>'..w..'</b></font>'
                            else parts[#parts+1] = '<font color="'..dimc..'">'..w..'</font>' end
                        end
                        lyLbl.Text = table.concat(parts, " ")
                    end
                end
            end
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- MUSIC + LYRICS ENGINE
-- ══════════════════════════════════════════════════════════════
do
    Music.sound = new("Sound", {Name="ShyMusic", Volume=Music.volume, Looped=true, Parent=SoundService})

    local function cleanName(s)
        s = tostring(s or "")
        s = s:gsub("%b()", " ")
        s = s:gsub("%b[]", " ")
        s = s:gsub("_", " ")
        s = s:gsub("%s+", " ")
        s = s:gsub("^%s+", ""):gsub("%s+$", "")
        return s
    end

    -- lyrics -------------------------------------------------
    local function mkLine(t, text)
        local words, cum, total = {}, {}, 0
        for w in text:gmatch("%S+") do words[#words+1] = w; total = total + #w + 1 end
        local acc = 0
        for i, w in ipairs(words) do acc = acc + #w + 1; cum[i] = acc / math.max(total, 1) end
        return { t=t, text=text, words=words, cum=cum }
    end

    Lyrics.parse = function(raw)
        local lines, plain, synced = {}, {}, false
        for ln in tostring(raw):gmatch("[^\r\n]+") do
            local stamps, rest = {}, ln
            while true do
                local mm, ss, ff, nxt = rest:match("^%s*%[(%d+):(%d+)[%.:]?(%d*)%]()")
                if not mm then break end
                local frac = (ff ~= "" and tonumber("0."..ff)) or 0
                stamps[#stamps+1] = tonumber(mm) * 60 + tonumber(ss) + frac
                rest = rest:sub(nxt)
            end
            rest = rest:gsub("<%d+:%d+[%.:]?%d*>", "")
            rest = rest:gsub("^%s+", ""):gsub("%s+$", "")
            if #stamps > 0 then
                synced = true
                if rest ~= "" then for _, t in ipairs(stamps) do lines[#lines+1] = mkLine(t, rest) end end
            elseif rest ~= "" and not rest:match("^%[%a+:") then
                plain[#plain+1] = rest
            end
        end
        if synced then
            table.sort(lines, function(a, b) return a.t < b.t end)
            return lines
        end
        local total = Music.sound.TimeLength > 0 and Music.sound.TimeLength or 180
        for i, text in ipairs(plain) do lines[#lines+1] = mkLine((i - 1) * total / math.max(#plain, 1), text) end
        return lines
    end

    Lyrics.fetch = function(query, quiet)
        if not req then
            if not quiet then notify("Lyrics", "Executor has no HTTP request — paste LRC instead", false) end
            return
        end
        local q = cleanName(query)
        if q == "" then if not quiet then notify("Lyrics", "Enter artist - song", false) end return end
        task.spawn(function()
            if not quiet then notify("Lyrics", "Searching: " .. q) end
            local ok, res = pcall(req, { Url="https://lrclib.net/api/search?q=" .. HttpService:UrlEncode(q), Method="GET" })
            if not ok or type(res) ~= "table" or not res.Body then notify("Lyrics", "Request failed", false) return end
            local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if not ok2 or type(data) ~= "table" or #data == 0 then notify("Lyrics", "No lyrics found", false) return end
            local pick
            for _, it in ipairs(data) do
                if type(it.syncedLyrics) == "string" and #it.syncedLyrics > 0 then pick = it.syncedLyrics; break end
            end
            if not pick then
                for _, it in ipairs(data) do
                    if type(it.plainLyrics) == "string" and #it.plainLyrics > 0 then pick = it.plainLyrics; break end
                end
            end
            if not pick then notify("Lyrics", "No lyrics found", false) return end
            local lines = Lyrics.parse(pick)
            if #lines == 0 then notify("Lyrics", "Could not read lyrics", false) return end
            Lyrics.lines = lines; Lyrics.key = nil
            notify("Lyrics", "Loaded " .. #lines .. " lines")
        end)
    end

    Lyrics.loadText = function(text)
        local lines = Lyrics.parse(text)
        if #lines == 0 then notify("Lyrics", "Nothing to load", false) return end
        Lyrics.lines = lines; Lyrics.key = nil
        notify("Lyrics", "Loaded " .. #lines .. " lines")
    end

    Lyrics.clear = function() Lyrics.lines = {}; Lyrics.key = nil end

    -- library ------------------------------------------------
    Lib.save = function()
        if not FILE_OK then return end
        local ok, e = pcall(function() return HttpService:JSONEncode(Lib.list) end)
        if ok then pcall(writefile, Lib.file, e) end
    end
    Lib.load = function()
        if not FILE_OK then return end
        local ok, ex = pcall(isfile, Lib.file)
        if ok and ex then
            local ok2, raw = pcall(readfile, Lib.file)
            if ok2 then
                local ok3, d = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok3 and type(d) == "table" then Lib.list = d end
            end
        end
    end
    Lib.add = function(id, name, artist)
        local clean = tostring(id or ""):gsub("rbxassetid://", ""):gsub("%D", "")
        if clean == "" then notify("Library", "Enter a valid audio ID", false) return end
        name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then name = "Song " .. (#Lib.list + 1) end
        for _, e in ipairs(Lib.list) do
            if e.id == clean then
                e.name = name; if artist and artist ~= "" then e.artist = artist end
                Lib.save(); if Lib.refresh then Lib.refresh() end
                notify("Library", "Updated: " .. name)
                return
            end
        end
        Lib.list[#Lib.list+1] = { id=clean, name=name, artist=artist or "" }
        Lib.save(); if Lib.refresh then Lib.refresh() end
        notify("Library", "Saved: " .. name)
    end
    Lib.remove = function(i)
        local e = Lib.list[i]; if not e then return end
        table.remove(Lib.list, i)
        Lib.save(); if Lib.refresh then Lib.refresh() end
        notify("Library", "Deleted: " .. e.name, false)
    end
    Lib.load()

    -- player -------------------------------------------------
    Music.play = function(id, name, artist)
        local clean = tostring(id or ""):gsub("rbxassetid://", ""):gsub("%D", "")
        if clean == "" then notify("Music", "Enter a valid audio ID", false) return end
        Music.id = clean
        Music.name = (name and name ~= "") and name or ("Audio " .. clean)
        Music.artist = artist or ""
        Music.sound.SoundId = "rbxassetid://" .. clean
        Music.sound.TimePosition = 0
        Music.sound:Play()
        Music.playing = true
        Lyrics.clear()
        notify("Music", "Playing: " .. Music.name)
        Fn.updateHud()
        if Lyrics.auto then Lyrics.fetch((Music.artist ~= "" and (Music.artist .. " ") or "") .. Music.name, true) end
        task.delay(4, function()
            if Music.id == clean and Music.sound.TimeLength == 0 then
                notify("Music", "Audio could not load (private/blocked ID?)", false)
            end
        end)
    end

    Music.toggle = function()
        if not Music.id then notify("Music", "Nothing loaded — pick a song first", false) return end
        if Music.playing then Music.sound:Pause(); Music.playing = false
        else Music.sound:Resume(); Music.playing = true end
        Fn.updateHud()
    end

    Music.stop = function()
        Music.sound:Stop(); Music.playing = false
        Fn.updateHud()
    end

    local function step(dir)
        if #Lib.list == 0 then notify("Music", "Save songs in the library first", false) return end
        local cur = 0
        for i, e in ipairs(Lib.list) do if e.id == Music.id then cur = i; break end end
        local nxt = ((cur - 1 + dir) % #Lib.list) + 1
        local e = Lib.list[nxt]
        Music.play(e.id, e.name, e.artist)
    end
    Music.next = function() step(1) end
    Music.prev = function() step(-1) end

    Music.sound.Ended:Connect(function() if not Music.looped then step(1) end end)
end

