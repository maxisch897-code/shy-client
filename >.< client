    -- ══════════ POTIONS (active effects) ══════════
    -- Pills glide smoothly between 4 layouts. Click it in edit mode (chat open).
    do
        local pw = overlays.potions
        local ROMAN = {"I","II","III","IV","V","VI","VII","VIII","IX","X"}
        local STYLES = {"Classic","Mirror","Swap","Inline"}
        local RH, GP, W = 30, 5, 200
        local head = new("Frame",{Size=UDim2.new(1,0,0,32),BackgroundColor3=T.Card,BackgroundTransparency=0.1,BorderSizePixel=0,Parent=pw})
        corner(head, 11); regRef(head, "BackgroundColor3", "Card")
        local ttl = new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,14,0,0),Size=UDim2.new(1,-50,1,0),Font=Enum.Font.GothamBold,Text="Potions",TextColor3=T.Text,TextSize=14,TextXAlignment=Enum.TextXAlignment.Left,Parent=head})
        regRef(ttl, "TextColor3", "Text")
        local flask = new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(1,-34,0,0),Size=UDim2.new(0,24,1,0),Font=Enum.Font.GothamBold,Text="⚗",TextColor3=T.Accent,TextSize=16,Parent=head})
        regRef(flask, "TextColor3", "Accent")
        local rows = new("Frame",{BackgroundTransparency=1,Position=UDim2.new(0,0,0,32+GP),Size=UDim2.new(1,0,1,-(32+GP)),Parent=pw})
        local since, rowObjs, shownKey, shownLayout = {}, {}, "", 0

        local function effects()
            local out, alive = {}, {}
            local now = os.clock()
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local function add(id, name, icon, timed)
                alive[id] = true
                local t = "inf"
                if timed then
                    since[id] = since[id] or now
                    local e = math.floor(now - since[id])
                    t = string.format("%d:%02d", e // 60, e % 60)
                end
                out[#out+1] = {id=id, name=name, icon=icon, time=t}
            end
            if hum then
                if hum.WalkSpeed > 17 then add("speed", "Speed "..ROMAN[math.clamp(math.floor(hum.WalkSpeed/16), 1, 10)], "⚡", false) end
                local jp = hum.UseJumpPower and hum.JumpPower or hum.JumpHeight * 7
                if jp > 55 then add("jump", "Jump Boost "..ROMAN[math.clamp(math.floor(jp/50), 1, 10)], "⬆", false) end
                if hum.Health > 0 and hum.Health < hum.MaxHealth then add("regen", "Regeneration", "❤", false) end
            end
            if feat.fly then add("fly", "Flight", "🕊", true) end
            if feat.noclip then add("noclip", "Phasing", "👻", true) end
            if feat.infJump then add("infjump", "Leaping", "🦘", true) end
            if feat.fullbright then add("fb", "Night Vision", "👁", true) end
            if feat.glow then add("glow", "Glowing", "✨", true) end
            if feat.neon then add("neon", "Neon Body", "💡", true) end
            if feat.rainbowChar then add("rainbow", "Rainbow", "🌈", true) end
            if feat.ghost then add("ghost", "Afterimage", "👤", true) end
            if feat.playerTransparency and feat.playerTransparencyLevel >= 60 then add("invis", "Invisibility", "◌", true) end
            if feat.freeCam then add("freecam", "Spectator", "🎥", true) end
            for id in pairs(since) do if not alive[id] then since[id] = nil end end
            return out
        end
        local function keyOf(list)
            local k = {}
            for _, e in ipairs(list) do k[#k+1] = e.id .. e.name end
            return table.concat(k, "|")
        end

        local function mkPill(txt, bold, col, colKey)
            local p = new("Frame",{BackgroundColor3=T.Card,BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.new(0,RH,0,RH),Parent=rows})
            corner(p, 10); regRef(p, "BackgroundColor3", "Card")
            local l = new("TextLabel",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Font=bold and Enum.Font.GothamBold or Enum.Font.GothamMedium,Text=txt,TextColor3=col,TextTransparency=1,TextSize=13,TextTruncate=Enum.TextTruncate.AtEnd,Parent=p})
            regRef(l, "TextColor3", colKey)
            return p, l
        end
        local function createRow(e)
            local ro = {fresh=true, e=e}
            ro.inBg = new("Frame",{BackgroundColor3=T.Card,BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.new(0,W,0,RH),Parent=rows})
            corner(ro.inBg, 10); regRef(ro.inBg, "BackgroundColor3", "Card")
            ro.iconBg, ro.iconLbl = mkPill(e.icon, true, T.Text, "Text"); ro.iconLbl.TextSize = 15
            ro.nameBg, ro.nameLbl = mkPill(e.name, false, T.Text, "Text")
            ro.timeBg, ro.timeLbl = mkPill(e.time, true, T.Accent, "Accent")
            return ro
        end
        local function place(ro, idx, st, animate)
            local animP = animate and not ro.fresh
            local animT = animate or ro.fresh
            local function mvP(o, props) if animP then tween(o, 0.36, props, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) else for k, v in pairs(props) do o[k] = v end end end
            local function mvT(o, props) if animT then tween(o, 0.3, props) else for k, v in pairs(props) do o[k] = v end end end
            local y = (idx-1)*(RH+GP)
            local ix, iw, nx, nw, tx, tw
            if st == 1 then ix,iw,nx,nw,tx,tw = 0,RH,RH+GP,112,RH+GP+112+GP,48
            elseif st == 2 then tx,tw,ix,iw,nx,nw = 0,48,48+GP,RH,48+GP+RH+GP,112
            elseif st == 3 then nx,nw,ix,iw,tx,tw = 0,112,112+GP,RH,112+GP+RH+GP,48
            else ix,iw,nx,nw,tx,tw = 6,26,34,112,150,44 end
            local inline = (st == 4)
            local pillT = inline and 1 or 0.1
            mvP(ro.inBg, {Position=UDim2.new(0,0,0,y)})
            mvT(ro.inBg, {BackgroundTransparency = inline and 0.1 or 1})
            mvP(ro.iconBg, {Position=UDim2.new(0,ix,0,y), Size=UDim2.new(0,iw,0,RH)}); mvT(ro.iconBg, {BackgroundTransparency=pillT})
            mvP(ro.nameBg, {Position=UDim2.new(0,nx,0,y), Size=UDim2.new(0,nw,0,RH)}); mvT(ro.nameBg, {BackgroundTransparency=pillT})
            mvP(ro.timeBg, {Position=UDim2.new(0,tx,0,y), Size=UDim2.new(0,tw,0,RH)}); mvT(ro.timeBg, {BackgroundTransparency=pillT})
            ro.iconLbl.Text = ro.e.icon
            ro.nameLbl.Text = inline and ("•  " .. ro.e.name .. "  •") or ro.e.name
            ro.timeLbl.Text = ro.e.time
            if ro.fresh then
                ro.fresh = false
                for _, l in ipairs({ro.iconLbl, ro.nameLbl, ro.timeLbl}) do tween(l, 0.3, {TextTransparency=0}) end
            end
        end
        local function fadeOut(ro)
            for _, o in ipairs({ro.inBg, ro.iconBg, ro.nameBg, ro.timeBg}) do tween(o, 0.2, {BackgroundTransparency=1}) end
            for _, l in ipairs({ro.iconLbl, ro.nameLbl, ro.timeLbl}) do tween(l, 0.2, {TextTransparency=1}) end
            task.delay(0.3, function() for _, o in ipairs({ro.inBg, ro.iconBg, ro.nameBg, ro.timeBg}) do o:Destroy() end end)
        end
        local function sync(animate)
            local real = effects()
            shownKey = keyOf(real)
            local list = real
            if #list == 0 then list = {{id="none", name="No effects", icon="∅", time="—"}} end
            local st = feat.potionsLayout or 1
            if st < 1 or st > #STYLES then st = 1 end
            shownLayout = st
            local keep = {}
            for i, e in ipairs(list) do
                keep[e.id] = true
                local ro = rowObjs[e.id]
                if not ro then ro = createRow(e); rowObjs[e.id] = ro end
                ro.e = e
                place(ro, i, st, animate)
            end
            for id, ro in pairs(rowObjs) do
                if not keep[id] then fadeOut(ro); rowObjs[id] = nil end
            end
            local sz = UDim2.new(0, W, 0, 32 + GP + #list*(RH+GP) - GP)
            if animate then tween(pw, 0.3, {Size=sz}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) else pw.Size = sz end
        end
        Fn.potionsRebuild = function() sync(false) end
        Fn.potionsCycle = function()
            feat.potionsLayout = ((feat.potionsLayout or 1) % #STYLES) + 1
            sync(true)
            notify("Potions", "Layout: " .. STYLES[feat.potionsLayout])
        end
        task.spawn(function()
            while true do
                task.wait(0.3)
                if pw.Visible then
                    local list = effects()
                    if keyOf(list) ~= shownKey or (feat.potionsLayout or 1) ~= shownLayout then sync(true)
                    else for _, e in ipairs(list) do local ro = rowObjs[e.id]; if ro then ro.e = e; ro.timeLbl.Text = e.time end end end
                end
            end
        end)
        sync(false)
    end

    -- ══════════ WIDGET LAYOUTS (click any widget in edit mode to cycle) ══════════
    -- Default -> Compact -> Large -> Bare (no background, text only). Everything morphs smoothly.
    -- Keybinds (List / Pills) and Potions (4 pill layouts) have their own special layouts.
    do
        local LAYOUTS = {"Default", "Compact", "Large", "Bare"}
        local SCALES = {1, 0.82, 1.22, 1}
        local RADII = {RM, 6, 14, 12}
        local LABELS = {statusBar="Status Bar", fps="FPS", coords="Coordinates", ping="Ping", watermark="Watermark", keybinds="Keybinds", musicHud="Music HUD", speed="Speed", lyrics="Lyrics Bar", keystrokes="Keystrokes", mousestrokes="Mousestrokes"}
        local txtOrig = setmetatable({}, {__mode = "k"})
        for name in pairs(overlays) do if name ~= "potions" then feat["layout_" .. name] = 1 end end
        Fn.LAYOUT_NAMES = LAYOUTS
        Fn.applyLayout = function(name, animate)
            local f = overlays[name]
            if not f or name == "potions" then return end
            if name == "keybinds" then if Fn.kbApply then Fn.kbApply(animate) end return end
            local idx = feat["layout_" .. name] or 1
            if idx < 1 or idx > #LAYOUTS then idx = 1 end
            local function mv(o, props, dur)
                if animate then TS:Create(o, TweenInfo.new(sdur(dur or 0.3), Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props):Play()
                else for k, v in pairs(props) do o[k] = v end end
            end
            local us = f:FindFirstChildOfClass("UIScale") or new("UIScale", {Name = "OwoLayoutScale", Parent = f})
            mv(us, {Scale = SCALES[idx]})
            local rad = RADII[idx]
            local c = f:FindFirstChildOfClass("UICorner"); if c then mv(c, {CornerRadius = UDim.new(0, rad)}) end
            for _, n in ipairs({"OwoGlassFrost", "OwoGlassGloss", "OwoGlassRim"}) do
                local l = f:FindFirstChild(n)
                local lc = l and l:FindFirstChildOfClass("UICorner")
                if lc then lc.CornerRadius = UDim.new(0, rad) end
            end
            local bare = (idx == 4)
            f:SetAttribute("LBare", bare)
            local ln = f:FindFirstChild("OwoLine"); if ln then mv(ln, {Transparency = bare and 1 or 0.6}, 0.25) end
            mv(f, {BackgroundTransparency = bare and 1 or TR.Overlay}, 0.25)
            for _, d in ipairs(f:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    if bare then
                        if txtOrig[d] == nil then txtOrig[d] = {d.TextStrokeTransparency, d.TextStrokeColor3} end
                        d.TextStrokeColor3 = Color3.new(0, 0, 0)
                        mv(d, {TextStrokeTransparency = 0.45}, 0.25)
                    elseif txtOrig[d] then
                        d.TextStrokeColor3 = txtOrig[d][2]
                        mv(d, {TextStrokeTransparency = txtOrig[d][1]}, 0.25)
                        txtOrig[d] = nil
                    end
                end
            end
            if Glass.refreshAll then Glass.refreshAll() end
        end
        Fn.applyAllLayouts = function()
            for name in pairs(overlays) do
                if name ~= "potions" then Fn.applyLayout(name, false) end
            end
            if Fn.potionsRebuild then Fn.potionsRebuild() end
        end
        Fn.cycleLayout = function(name)
            if name == "potions" then if Fn.potionsCycle then Fn.potionsCycle() end return end
            if name == "keybinds" then if Fn.kbCycle then Fn.kbCycle() end return end
            if not overlays[name] then return end
            feat["layout_" .. name] = ((feat["layout_" .. name] or 1) % #LAYOUTS) + 1
            Fn.applyLayout(name, true)
            notify(LABELS[name] or name, "Layout: " .. LAYOUTS[feat["layout_" .. name]])
        end
        Fn.resetLayout = function(name)
            if name == "potions" then feat.potionsLayout = 1; if Fn.potionsRebuild then Fn.potionsRebuild() end return end
            feat["layout_" .. name] = 1; Fn.applyLayout(name, true)
        end
    end

    RS.RenderStepped:Connect(function(dt)
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if overlays.coords.Visible and hrp then
            local p = hrp.Position; local dh = colorToHex(T.Dim)
            coordsLbl.Text = string.format('<font color="%s">x</font> <b>%d</b>   <font color="%s">y</font> <b>%d</b>   <font color="%s">z</font> <b>%d</b>', dh, math.floor(p.X+0.5), dh, math.floor(p.Y+0.5), dh, math.floor(p.Z+0.5))
        end
        if overlays.speed.Visible then
            local v = hrp and hrp.AssemblyLinearVelocity or Vector3.zero
            UI.spd = slerp(UI.spd or 0, Vector3.new(v.X,0,v.Z).Magnitude, dt, 10)
            spVal.Text = (string.format("%.2f", UI.spd):gsub("%.", ",")) .. " bps"
            spBar.Size = UDim2.new(math.clamp(UI.spd/60, 0, 1), 0, 1, 0)
        end
        if overlays.musicHud.Visible then
            local len = Music.sound and Music.sound.TimeLength or 0
            mhFill.Size = UDim2.new(len > 0 and math.clamp(Music.sound.TimePosition/len, 0, 1) or 0, 0, 1, 0)
        end
        if overlays.statusBar.Visible and Fn.setSbMode and Fn.sbLyricLbl then
            local active = feat.lyricsInStatusBar and Music.playing and #Lyrics.lines > 0
            if active then
                Fn.setSbMode("lyrics", true)
                local pos = (Music.sound and Music.sound.TimePosition or 0) + Lyrics.offset
                local idx = 0
                for i = 1, #Lyrics.lines do if Lyrics.lines[i].t <= pos then idx = i else break end end
                if idx > 0 then
                    local L = Lyrics.lines[idx]
                    local t1 = Lyrics.lines[idx+1] and Lyrics.lines[idx+1].t or (L.t+4)
                    local dur = math.clamp(t1-L.t, 0.5, 6)*0.85
                    local f = math.clamp((pos-L.t)/dur, 0, 1)
                    local widx = #L.words
                    for i = 1, #L.words do if f <= L.cum[i] then widx = i; break end end
                    local key = idx*1000+widx
                    if Lyrics.sbKey ~= key then
                        Lyrics.sbKey = key
                        local acc, dimc = colorToHex(T.Accent), "#8C93A6"
                        local parts = {}
                        for i, w in ipairs(L.words) do
                            w = w:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;")
                            if i < widx then parts[#parts+1] = '<font color="#FFFFFF">'..w..'</font>'
                            elseif i == widx then parts[#parts+1] = '<font color="'..acc..'"><b>'..w..'</b></font>'
                            else parts[#parts+1] = '<font color="'..dimc..'">'..w..'</font>' end
                        end
                        Fn.sbLyricLbl.Text = table.concat(parts, " ")
                    end
                else
                    Fn.sbLyricLbl.Text = '<font color="'..colorToHex(T.Muted)..'">♪</font>'
                end
            else
                Fn.setSbMode("normal", true)
            end
        end
        if overlays.lyrics.Visible and lyLbl then
            local lines = Lyrics.lines
            if #lines == 0 then
                if Lyrics.barKey ~= "none" then Lyrics.barKey = "none"; lyLbl.Text = '<font color="'..colorToHex(T.Muted)..'">♪  no lyrics loaded</font>' end
            else
                local pos = (Music.sound and Music.sound.TimePosition or 0) + Lyrics.offset
                local idx = 0
                for i = 1, #lines do if lines[i].t <= pos then idx = i else break end end
                if idx == 0 then
                    if Lyrics.barKey ~= "pre" then Lyrics.barKey = "pre"; lyLbl.Text = '<font color="'..colorToHex(T.Muted)..'">♪</font>' end
                else
                    local L = lines[idx]
                    local t1 = lines[idx+1] and lines[idx+1].t or (L.t+4)
                    local dur = math.clamp(t1-L.t, 0.5, 6)*0.85
                    local f = math.clamp((pos-L.t)/dur, 0, 1)
                    local widx = #L.words
                    for i = 1, #L.words do if f <= L.cum[i] then widx = i; break end end
                    local key = idx*1000+widx
                    if Lyrics.barKey ~= key then
                        Lyrics.barKey = key
                        local acc, dimc = colorToHex(T.Accent), "#8C93A6"
                        local parts = {}
                        for i, w in ipairs(L.words) do
                            w = w:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;")
                            if i < widx then parts[#parts+1] = '<font color="#FFFFFF">'..w..'</font>'
                            elseif i == widx then parts[#parts+1] = '<font color="'..acc..'"><b>'..w..'</b></font>'
                            else parts[#parts+1] = '<font color="'..dimc..'">'..w..'</font>' end
                        end
                        lyLbl.Text = table.concat(parts, " ")
                    end
                end
            end
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- 3D LYRICS
-- ══════════════════════════════════════════════════════════════
do
    local A = {}; Lyrics.A = A
    local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)
    local function esc(c) return (c:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;")) end
    local function build()
        A.part = new("Part", {Name="OwoLyrics3D", Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Transparency=1, Size=Vector3.new(16,3,0.05), Parent=workspace.CurrentCamera})
        A.sg = new("SurfaceGui", {Face=Enum.NormalId.Front, Adornee=A.part, SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud=60, LightInfluence=0, AlwaysOnTop=false, Enabled=false, Parent=A.part})
        A.holder = new("Frame", {BackgroundTransparency=1, Size=UDim2.fromScale(1,1), Parent=A.sg})
        A.scale = new("UIScale", {Scale=1, Parent=A.holder})
        A.shadow = new("TextLabel", {BackgroundTransparency=1, Size=UDim2.fromScale(1,1), Position=UDim2.fromOffset(4,6), FontFace=FONT, TextScaled=true, RichText=true, Text="", TextColor3=Color3.new(0,0,0), TextTransparency=0.55, ZIndex=1, Parent=A.holder})
        A.lbl = new("TextLabel", {BackgroundTransparency=1, Size=UDim2.fromScale(1,1), FontFace=FONT, TextScaled=true, RichText=true, Text="", TextColor3=Color3.new(1,1,1), ZIndex=2, Parent=A.holder})
        A.glow = new("UIStroke", {Color=T.Accent, Thickness=3, Transparency=0.6, Parent=A.lbl})
        new("UITextSizeConstraint", {MaxTextSize=130, Parent=A.lbl}); new("UITextSizeConstraint", {MaxTextSize=130, Parent=A.shadow})
    end
    local function hide() if A.sg then A.sg.Enabled = false end; A.idx, A.pos = nil, nil end
    local function pickSpot(cam, hrp)
        local vp = cam.ViewportSize; local ps = cam:WorldToViewportPoint(hrp.Position)
        local pr = RaycastParams.new(); pr.FilterType = Enum.RaycastFilterType.Exclude; pr.FilterDescendantsInstances = {player.Character, A.part}
        for _ = 1, 16 do
            local sx = vp.X*(0.28+math.random()*0.44); local sy = vp.Y*(0.14+math.random()*0.36)
            if ps.Z <= 0 or (Vector2.new(sx,sy)-Vector2.new(ps.X,ps.Y)).Magnitude > vp.Y*0.25 then
                local ray = cam:ViewportPointToRay(sx,sy); local dist = 16+math.random()*10
                local hit = workspace:Raycast(ray.Origin, ray.Direction*dist, pr)
                if hit then dist = (hit.Position-ray.Origin).Magnitude-2 end
                if dist >= 9 then return ray.Origin + ray.Direction*dist end
            end
        end
        local cf = cam.CFrame
        return cf.Position + cf.LookVector*18 + cf.UpVector*5 + cf.RightVector*(math.random()<0.5 and -6 or 6)
    end
    local function respawn(cam, hrp)
        A.pos = pickSpot(cam, hrp)
        A.tilt = CFrame.Angles(0, math.rad((math.random()<0.5 and -1 or 1)*(8+math.random()*14)), math.rad((math.random()-0.5)*8))
        A.lost, A.bob = 0, math.random()*6
        A.scale.Scale = 0.6
        TS:Create(A.scale, TweenInfo.new(sdur(0.4), Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale=1}):Play()
    end
    RS.RenderStepped:Connect(function(dt)
        if not feat.lyrics3d then if A.sg and A.sg.Enabled then hide() end return end
        local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp or #Lyrics.lines == 0 or not (Music.sound and Music.sound.IsPlaying) then hide() return end
        local pos = Music.sound.TimePosition + Lyrics.offset
        local idx = 0
        for i = 1, #Lyrics.lines do if Lyrics.lines[i].t <= pos then idx = i else break end end
        if idx == 0 then hide() return end
        if not A.part or not A.part.Parent then build() end
        local L = Lyrics.lines[idx]
        local t1 = Lyrics.lines[idx+1] and Lyrics.lines[idx+1].t or (L.t+4)
        if A.idx ~= idx then
            A.idx, A.key = idx, nil; A.chars = {}
            local str = string.upper(table.concat(L.words," "))
            if not pcall(function() for _, c in utf8.codes(str) do A.chars[#A.chars+1] = utf8.char(c) end end) then
                A.chars = {}; for i = 1, #str do A.chars[i] = str:sub(i,i) end
            end
            respawn(workspace.CurrentCamera, hrp)
        end
        local n = #A.chars
        local reveal = math.clamp((pos-L.t)/math.max(math.min(t1-L.t,6)*0.55, 0.2), 0, 1)
        local nf = reveal*n; local shown = math.floor(nf); local frac = nf-shown
        local key = shown*8+math.floor(frac*8)
        if A.key ~= key then
            A.key = key
            local done = {}
            for i = 1, shown do done[i] = esc(A.chars[i]) end
            local solid = table.concat(done)
            local nxt = A.chars[shown+1]
            A.lbl.Text = nxt and (solid..string.format('<font transparency="%.2f">%s</font>', 1-frac, esc(nxt))) or solid
            A.shadow.Text = solid
        end
        local fade = 1 - math.clamp((t1-pos)/0.3, 0, 1)
        A.lbl.TextTransparency = fade
        A.shadow.TextTransparency = 0.55+0.45*fade
        A.glow.Transparency = 0.6+0.4*fade; A.glow.Color = T.Accent
        local cam = workspace.CurrentCamera; local camPos = cam.CFrame.Position
        local sp, onScreen = cam:WorldToViewportPoint(A.pos)
        local ps = cam:WorldToViewportPoint(hrp.Position)
        local bad = not onScreen or sp.Z < 5 or (A.pos-camPos).Magnitude > 50 or (ps.Z > 0 and (Vector2.new(sp.X,sp.Y)-Vector2.new(ps.X,ps.Y)).Magnitude < cam.ViewportSize.Y*0.15)
        A.chk = (A.chk or 0) + dt
        if not bad and A.chk > 0.25 then
            A.chk = 0
            local pr = RaycastParams.new(); pr.FilterType = Enum.RaycastFilterType.Exclude; pr.FilterDescendantsInstances = {player.Character, A.part}
            if workspace:Raycast(camPos, A.pos-camPos, pr) then bad = true end
        end
        A.lost = bad and (A.lost+dt) or 0
        if A.lost > 0.4 then respawn(cam, hrp) end
        local s = Lyrics.airScale
        A.part.Size = Vector3.new(10*s, 1.9*s, 0.05)
        local p = A.pos + Vector3.new(0, math.sin(os.clock()*1.4+A.bob)*0.25, 0)
        A.part.CFrame = CFrame.lookAt(p, camPos) * A.tilt
        A.sg.Enabled = true
    end)
end

-- ══════════════════════════════════════════════════════════════
-- MUSIC ENGINE
-- ══════════════════════════════════════════════════════════════
do
    Music.sound = new("Sound",{Name="OwoMusic",Volume=Music.volume,Looped=true,Parent=SoundService})
    local function mkLine(t, text)
        local words, cum, total = {}, {}, 0
        for w in text:gmatch("%S+") do words[#words+1] = w; total = total + #w + 1 end
        local acc = 0
        for i, w in ipairs(words) do acc = acc + #w + 1; cum[i] = acc/math.max(total,1) end
        return {t=t, text=text, words=words, cum=cum}
    end
    Lyrics.parse = function(raw)
        local lines, plain, synced = {}, {}, false
        for ln in tostring(raw):gmatch("[^\r\n]+") do
            local stamps, rest = {}, ln
            while true do
                local mm, ss, ff, nxt = rest:match("^%s*%[(%d+):(%d+)[%.:]?(%d*)%]()")
                if not mm then break end
                stamps[#stamps+1] = tonumber(mm)*60 + tonumber(ss) + ((ff ~= "" and tonumber("0."..ff)) or 0)
                rest = rest:sub(nxt)
            end
            rest = rest:gsub("<%d+:%d+[%.:]?%d*>",""):gsub("^%s+",""):gsub("%s+$","")
            if #stamps > 0 then synced = true; if rest ~= "" then for _, t in ipairs(stamps) do lines[#lines+1] = mkLine(t, rest) end end
            elseif rest ~= "" and not rest:match("^%[%a+:") then plain[#plain+1] = rest end
        end
        if synced then table.sort(lines, function(a,b) return a.t < b.t end); return lines end
        local total = Music.sound.TimeLength > 0 and Music.sound.TimeLength or 180
        for i, text in ipairs(plain) do lines[#lines+1] = mkLine((i-1)*total/math.max(#plain,1), text) end
        return lines
    end
    Lyrics.fetch = function(query, quiet)
        if not req then if not quiet then notify("Lyrics","No HTTP",false) end return end
        local q = tostring(query or ""):gsub("%b()"," "):gsub("%b[]"," "):gsub("_"," "):gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
        if q == "" then return end
        task.spawn(function()
            if not quiet then notify("Lyrics","Searching: "..q) end
            local ok, res = pcall(req,{Url="https://lrclib.net/api/search?q="..HttpService:UrlEncode(q),Method="GET"})
            if not ok or type(res) ~= "table" or not res.Body then notify("Lyrics","Request failed",false); return end
            local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if not ok2 or type(data) ~= "table" or #data == 0 then notify("Lyrics","No lyrics found",false); return end
            local pick
            for _, it in ipairs(data) do if type(it.syncedLyrics) == "string" and #it.syncedLyrics > 0 then pick = it.syncedLyrics; break end end
            if not pick then for _, it in ipairs(data) do if type(it.plainLyrics) == "string" and #it.plainLyrics > 0 then pick = it.plainLyrics; break end end end
            if not pick then notify("Lyrics","No lyrics found",false); return end
            local lines = Lyrics.parse(pick)
            if #lines == 0 then notify("Lyrics","Could not read",false); return end
            Lyrics.lines = lines; Lyrics.key = nil; Lyrics.sbKey = nil; Lyrics.barKey = nil
            notify("Lyrics","Loaded ".. #lines .." lines")
        end)
    end
    Lyrics.loadText = function(text)
        local lines = Lyrics.parse(text)
        if #lines == 0 then notify("Lyrics","Nothing to load",false); return end
        Lyrics.lines = lines; Lyrics.key = nil; Lyrics.sbKey = nil; Lyrics.barKey = nil
        notify("Lyrics","Loaded ".. #lines .." lines")
    end
    Lyrics.clear = function() Lyrics.lines = {}; Lyrics.key = nil; Lyrics.sbKey = nil; Lyrics.barKey = nil end
    Lib.save = function()
        if not FILE_OK then return end
        local ok, e = pcall(function() return HttpService:JSONEncode(Lib.list) end)
        if ok then pcall(writefile, Lib.file, e) end
    end
    Lib.load = function()
        if not FILE_OK then return end
        local function tryLoad(p)
            local ok, ex = pcall(isfile, p); if not (ok and ex) then return nil end
            local ok2, raw = pcall(readfile, p); if not ok2 then return nil end
            local ok3, d = pcall(function() return HttpService:JSONDecode(raw) end)
            if ok3 and type(d) == "table" then return d end
            return nil
        end
        local d = tryLoad(Lib.file) or tryLoad("shyclient_music.json")
        if d then Lib.list = d end
    end
    Lib.add = function(id, name, artist)
        local clean = tostring(id or ""):gsub("rbxassetid://",""):gsub("%D","")
        if clean == "" then notify("Library","Enter a valid audio ID",false); return end
        name = tostring(name or ""):gsub("^%s+",""):gsub("%s+$","")
        if name == "" then name = "Song "..(#Lib.list+1) end
        for _, e in ipairs(Lib.list) do
            if e.id == clean then
                e.name = name; if artist and artist ~= "" then e.artist = artist end
                Lib.save(); if Lib.refresh then Lib.refresh() end
                notify("Library","Updated: "..name); return
            end
        end
        Lib.list[#Lib.list+1] = {id=clean, name=name, artist=artist or ""}
        Lib.save(); if Lib.refresh then Lib.refresh() end
        notify("Library","Saved: "..name)
    end
    Lib.remove = function(i)
        local e = Lib.list[i]; if not e then return end
        table.remove(Lib.list, i)
        Lib.save(); if Lib.refresh then Lib.refresh() end
        notify("Library","Deleted: "..e.name,false)
    end
    Lib.load()
    Music.play = function(id, name, artist)
        local clean = tostring(id or ""):gsub("rbxassetid://",""):gsub("%D","")
        if clean == "" then notify("Music","Enter a valid audio ID",false); return end
        Music.id = clean
        Music.name = (name and name ~= "") and name or ("Audio "..clean)
        Music.artist = artist or ""
        Music.sound.SoundId = "rbxassetid://"..clean
        Music.sound.TimePosition = 0
        Music.sound:Play(); Music.playing = true
        Lyrics.clear()
        notify("Music","Playing: "..Music.name)
        if Fn.updateHud then Fn.updateHud() end
        if Lyrics.auto then Lyrics.fetch((Music.artist ~= "" and (Music.artist.." ") or "")..Music.name, true) end
        task.delay(4, function() if Music.id == clean and Music.sound.TimeLength == 0 then notify("Music","Could not load (private ID?)",false) end end)
    end
    Music.toggle = function()
        if not Music.id then notify("Music","Nothing loaded",false); return end
        if Music.playing then Music.sound:Pause(); Music.playing = false
        else Music.sound:Resume(); Music.playing = true end
        if Fn.updateHud then Fn.updateHud() end
    end
    Music.stop = function() Music.sound:Stop(); Music.playing = false; if Fn.updateHud then Fn.updateHud() end end
    local function step(dir)
        if #Lib.list == 0 then notify("Music","Save a song first",false); return end
        local cur = 0
        for i, e in ipairs(Lib.list) do if e.id == Music.id then cur = i; break end end
        local e = Lib.list[((cur-1+dir) % #Lib.list)+1]
        Music.play(e.id, e.name, e.artist)
    end
    Music.next = function() step(1) end
    Music.prev = function() step(-1) end
    Music.sound.Ended:Connect(function() if not Music.looped then step(1) end end)
end

