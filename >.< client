        local function apply(animate)
            local st = feat.layout_keybinds or 1
            if st < 1 or st > 2 then st = 1 end
            local n = #list
            local function mv(o, props, dur)
                if animate then tween(o, dur or 0.34, props, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                else for k, v in pairs(props) do o[k] = v end end
            end
            local bare = (st == 2)
            kb:SetAttribute("LBare", bare)
            local ln = kb:FindFirstChild("OwoLine")
            if ln then mv(ln, {Transparency = bare and 1 or 0.6}, 0.25) end
            mv(kb, {BackgroundTransparency = bare and 1 or TR.Overlay}, 0.25)
            if Glass.refreshAll then Glass.refreshAll() end
            emptyLbl.Visible = (n == 0)
            local keyTint = T.Accent:Lerp(T.Bg, 0.62)
            if st == 1 then
                mv(hIconBg, {Position=UDim2.new(0,12,0,9), Size=UDim2.new(0,22,0,22), BackgroundTransparency=1})
                mv(hTitleBg, {Position=UDim2.new(0,38,0,9), Size=UDim2.new(0,W1-50,0,22), BackgroundTransparency=1})
                mv(hTitle, {Position=UDim2.new(0,0,0,0)})
                emptyLbl.Position = UDim2.new(0,14,0,40)
                for i, ro in ipairs(rowObjs) do
                    local y = 40 + (i-1)*24
                    local kw = math.max(32, ro.kw + 16)
                    mv(ro.nameBg, {Position=UDim2.new(0,14,0,y), Size=UDim2.new(0,W1-kw-34,0,20), BackgroundTransparency=1})
                    mv(ro.nameLbl, {Position=UDim2.new(0,0,0,0)})
                    mv(ro.keyBg, {Position=UDim2.new(0,W1-12-kw,0,y+1), Size=UDim2.new(0,kw,0,18), BackgroundTransparency=0.3, BackgroundColor3=keyTint})
                    mv(ro.keyLbl, {TextColor3=T.Accent})
                end
                mv(kb, {Size=UDim2.new(0,W1,0,40 + math.max(n,1)*24 + 8)})
            else
                local maxW, rowW = 0, {}
                for i, ro in ipairs(rowObjs) do
                    local nw = math.max(64, ro.nw + 24)
                    local kw = math.max(36, ro.kw + 20)
                    rowW[i] = {nw, kw}
                    maxW = math.max(maxW, nw + 6 + kw)
                end
                local W2 = math.max(150, maxW)
                mv(hIconBg, {Position=UDim2.new(0,0,0,0), Size=UDim2.new(0,28,0,28), BackgroundTransparency=0.1})
                mv(hTitleBg, {Position=UDim2.new(0,34,0,0), Size=UDim2.new(0,W2-34,0,28), BackgroundTransparency=0.1})
                mv(hTitle, {Position=UDim2.new(0,12,0,0)})
                emptyLbl.Position = UDim2.new(0,4,0,36)
                for i, ro in ipairs(rowObjs) do
                    local y = 36 + (i-1)*32
                    local nw, kw = rowW[i][1], rowW[i][2]
                    mv(ro.nameBg, {Position=UDim2.new(0,0,0,y), Size=UDim2.new(0,nw,0,26), BackgroundTransparency=0.1})
