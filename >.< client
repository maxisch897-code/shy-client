-- RAIN RIPPLES  (drops hit the ground / water and send out rings)
-- ══════════════════════════════════════════════════════════════
do
    local folder = new("Folder", {Name="OwoRipples", Parent=workspace})
    local POOL = 90
    local pool, active = {}, {}
    local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude; rp.IgnoreWater = false
    local function mk()
        local p = new("Part", {Name="Ripple", Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Transparency=1, Size=Vector3.new(1, 0.05, 1)})
        local sg = new("SurfaceGui", {Face=Enum.NormalId.Top, SizingMode=Enum.SurfaceGuiSizingMode.FixedSize, CanvasSize=Vector2.new(160, 160), LightInfluence=0, AlwaysOnTop=false, Brightness=1.5, Parent=p})
        local st = {}
        for i, sc in ipairs({1, 0.6}) do
            local fr = new("Frame", {AnchorPoint=Vector2.new(0.5, 0.5), Position=UDim2.fromScale(0.5, 0.5), Size=UDim2.fromScale(sc * 0.96, sc * 0.96), BackgroundTransparency=1, BorderSizePixel=0, Parent=sg})
            new("UICorner", {CornerRadius=UDim.new(0.5, 0), Parent=fr})
            st[i] = new("UIStroke", {Thickness=6, Color=Color3.new(1, 1, 1), Transparency=1, Parent=fr})
        end
        return {part=p, st=st, age=0, life=1, size=1}
    end
    local acc = 0
    RS.RenderStepped:Connect(function(dt)
        for i = #active, 1, -1 do
            local r = active[i]
            r.age += dt
            local k = r.age / r.life
            if k >= 1 then
                r.part.Parent = nil
                pool[#pool+1] = r
                table.remove(active, i)
            else
                local e = 1 - (1 - k) * (1 - k)
                local s = r.size * (0.2 + 0.8 * e)
                r.part.Size = Vector3.new(s, 0.05, s)
                local tr = 0.15 + 0.85 * k ^ 1.3
                r.st[1].Transparency = tr
                r.st[2].Transparency = math.min(1, tr + 0.25)
            end
        end
        if not feat.rainRipples then acc = 0; return end
        acc = math.min(acc + dt * feat.rippleRate, 6)
        local cam = workspace.CurrentCamera
        while acc >= 1 do
            acc -= 1
            if #active >= POOL then break end
            local base = cam.CFrame.Position
            local ang, rad = math.random() * math.pi * 2, math.sqrt(math.random()) * feat.rippleRadius
            local origin = Vector3.new(base.X + math.cos(ang) * rad, base.Y + 40, base.Z + math.sin(ang) * rad)
            rp.FilterDescendantsInstances = {player.Character, folder}
            local hit = workspace:Raycast(origin, Vector3.new(0, -140, 0), rp)
            if hit and hit.Normal.Y > 0.7 then
                local r = table.remove(pool) or mk()
                r.age, r.life = 0, 0.8 + math.random() * 0.7
                r.size = feat.rippleSize * (0.7 + math.random() * 0.8)
                local col = Color3.new(1, 1, 1):Lerp(EFFECT_COLOR, 0.25)
                r.st[1].Color = col; r.st[2].Color = col
                r.part.Size = Vector3.new(r.size * 0.2, 0.05, r.size * 0.2)
                r.part.CFrame = CFrame.new(hit.Position + Vector3.new(0, 0.04, 0))
                r.part.Parent = folder
                active[#active+1] = r
            end
        end
    end)
end

