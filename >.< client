-- gate(): optional function that must return true before a drag may start (widget edit mode)
-- onClick(): optional function called on a click without movement
local function drag(f, h, gate, onClick)
    h = h or f
    local d, s, sp, moved
    local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
    h.InputBegan:Connect(function(i)
        if isPress(i) then
            if gate and not gate() then return end
            local blocker = dragBlockers[f]
            if blocker and blocker(i.Position) then return end
            d = true; moved = false; s = i.Position; sp = f.Position
            if Fn.dragState then Fn.dragState(f, true) end
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if d and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local dd = i.Position - s
            if not moved and dd.Magnitude > 4 then moved = true end
            if moved or not onClick then
                f.Position = UDim2.new(sp.X.Scale, sp.X.Offset + dd.X, sp.Y.Scale, sp.Y.Offset + dd.Y)
            end
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if d and isPress(i) then
            d = false
            if Fn.dragState then Fn.dragState(f, false) end
            if onClick and not moved then pcall(onClick) end
        end
    end)
end
