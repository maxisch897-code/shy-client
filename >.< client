local function playUiSound(name, volMul)
    if not UISounds.enabled then return end
    local def = UISounds.defs[name]; if not def then return end
    local rl = UISounds.rateLimits[name]
    if rl then
        local now = os.clock()
        if UISounds.lastPlayed[name] and now - UISounds.lastPlayed[name] < rl then return end
        UISounds.lastPlayed[name] = now
    end
    local entry = UISounds.pools[name]; if not entry then return end
    local s = entry.pool[entry.idx]; entry.idx = entry.idx % #entry.pool + 1
    s.Volume = def.v * (volMul or 1) * UISounds.volume
    s.PlaybackSpeed = def.p * UISounds.pitch
    s.TimePosition = 0; s:Play()
end
local function playUiSoundLayered(name)
    playUiSound(name)
    if UISounds.layered[name] then task.delay(0.025, function() playUiSound("sparkle", 0.5) end) end
end
Fn.playUiSound = playUiSound
Fn.playUiSoundLayered = playUiSoundLayered
Fn.setUiSoundId = function(newId)
    newId = tostring(newId or ""):gsub("%s","")
    if newId == "" then return end
    if not newId:match("^rbxassetid://%d+$") and not newId:match("^%d+$") then return end
    if not newId:match("^rbxassetid://") then newId = "rbxassetid://" .. newId end
    UISounds.customId = newId
    feat.uiSoundId = newId:gsub("rbxassetid://","")
    for _, entry in pairs(UISounds.pools) do
        for _, s in ipairs(entry.pool) do s.SoundId = newId end
    end
end

-- ══════════════════════════════════════════════════════════════
-- LIQUID GLASS v2
-- Layered frost + specular gloss + a rim light that follows your cursor,
-- plus a real blur of the world behind the menu.
-- ══════════════════════════════════════════════════════════════
do
    local G = {panels = {}}
    Glass.G = G
    local clamp, exp = math.clamp, math.exp
    local function kp(t, v) return NumberSequenceKeypoint.new(t, clamp(v, 0, 1)) end
    Glass.styles = {
        Frosted  = {clarity=62, blur=10, shine=0.55, tint=0.00},
        Clear    = {clarity=88, blur=4,  shine=0.80, tint=0.00},
        Tinted   = {clarity=70, blur=8,  shine=0.50, tint=0.40},
        Crystal  = {clarity=80, blur=14, shine=1.00, tint=0.12},
        Midnight = {clarity=42, blur=12, shine=0.35, tint=0.20},
    }
    Glass.styleOrder = {"Frosted","Clear","Tinted","Crystal","Midnight"}
    Glass.winT = function() return 0.25 + (clamp(Glass.clarity, 30, 100) - 30) / 70 * 0.55 end

    function G.decorate(f, opts)
        opts = opts or {}
        if G.panels[f] then return G.panels[f] end
        local cr = f:FindFirstChildOfClass("UICorner")
        local function rc(o) if cr then new("UICorner", {CornerRadius=cr.CornerRadius, Parent=o}) end end
        local frost = new("Frame", {Name="OwoGlassFrost", Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, ZIndex=0, Visible=false, Parent=f}); rc(frost)
        local fg = new("UIGradient", {Rotation=90, Parent=frost})
        local gloss = new("Frame", {Name="OwoGlassGloss", Position=UDim2.new(0,1,0,1), Size=UDim2.new(1,-2,0.5,0), BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, ZIndex=0, Visible=false, Parent=f}); rc(gloss)
        local gg = new("UIGradient", {Rotation=90, Parent=gloss})
        local rim = new("Frame", {Name="OwoGlassRim", Size=UDim2.fromScale(1,1), BackgroundTransparency=1, BorderSizePixel=0, ZIndex=400, Visible=false, Parent=f}); rc(rim)
        local st = new("UIStroke", {Color=Color3.new(1,1,1), Thickness=1.5, ApplyStrokeMode=Enum.ApplyStrokeMode.Border, Parent=rim})
        local rg = new("UIGradient", {Rotation=45, Parent=st})
        local P = {f=f, frost=frost, fg=fg, gloss=gloss, gg=gg, rim=rim, stroke=st, rg=rg, vx=0.7, vy=0.7, always=opts.always, small=opts.small}
        G.panels[f] = P
        f.Destroying:Connect(function() G.panels[f] = nil end)
        return P
    end

    local function refresh(P)
        if not P.f.Parent then G.panels[P.f] = nil; return end
        local on = (Glass.on or P.always) and not P.f:GetAttribute("LBare")
        P.frost.Visible, P.gloss.Visible, P.rim.Visible = on, on, on
        if not on then return end
        local s, tint = Glass.shine, Glass.tint
        local k = P.small and 0.7 or 1
        P.frost.BackgroundColor3 = Color3.new(1,1,1):Lerp(T.Accent, tint)
        P.fg.Transparency = NumberSequence.new({kp(0, 1-0.20*s*k), kp(0.55, 1-0.035*s*k), kp(1, 1-0.10*s*k)})
        P.gg.Transparency = NumberSequence.new({kp(0, 1-0.30*s*k), kp(1, 1)})
        P.stroke.Thickness = 0.7 + Glass.refraction * 0.35
        P.rg.Color = ColorSequence.new(Color3.new(1,1,1):Lerp(T.Accent, tint*0.6))
        local bright = clamp(0.05 + (1-s)*0.4, 0, 0.7)
        P.rg.Transparency = NumberSequence.new({kp(0, bright), kp(0.3, 0.93), kp(0.7, 0.93), kp(1, bright+0.1)})
        if P.always then P.f.BackgroundTransparency = Glass.winT() end
    end
    function G.refreshAll() for _, P in pairs(G.panels) do refresh(P) end end
    Glass.refreshAll = G.refreshAll

    local t0, blurSize = os.clock(), 0
    RS.RenderStepped:Connect(function(dt)
        local m = UIS:GetMouseLocation()
        local tnow = os.clock() - t0
        for f, P in pairs(G.panels) do
            if (Glass.on or P.always) and f.Parent and f.Visible then
                local abs = f.AbsoluteSize
                if abs.X > 0 then
                    local c = f.AbsolutePosition + abs / 2
                    local dx, dy = m.X - c.X, m.Y - c.Y
                    local len = math.sqrt(dx*dx + dy*dy)
                    local tx, ty = 0.7, 0.7
                    if Glass.anim and len > 1 then tx, ty = dx/len, dy/len end
                    local a = 1 - exp(-dt * (Glass.anim and 7 or 12))
                    P.vx += (tx - P.vx) * a; P.vy += (ty - P.vy) * a
                    local rot = math.deg(math.atan2(P.vy, P.vx))
                    if Glass.anim then rot += 10 * math.sin(tnow * 0.8 + abs.X * 0.01) end
                    P.rg.Rotation = rot
                end
            end
        end
        local target = (Glass.on and Glass.worldBlur and UI.isOpen) and Glass.blur or 0
        blurSize = blurSize + (target - blurSize) * (1 - exp(-dt * 8))
        glassBlur.Size = blurSize
        glassBlur.Enabled = blurSize > 0.1
    end)
end

