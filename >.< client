local Smooth = { level=1.0, colorSpeed=4.0, effectSpeed=7.0 }
local function slerp(a, b, dt, speed)
    return a + (b - a) * (1 - math.exp(-dt * (speed or 8) * Smooth.level))
end
local function slerpC(a, b, dt, speed)
    return a:Lerp(b, 1 - math.exp(-dt * (speed or 8) * Smooth.level))
end
local function sdur(t) return t / math.max(Smooth.level, 0.1) end

