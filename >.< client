do
    local scGui = new("ScreenGui", {Name="OwoScreenFX", ResetOnSpawn=false, IgnoreGuiInset=true, ZIndexBehavior=Enum.ZIndexBehavior.Sibling, Parent=pg})
    local scanlines = new("Frame", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Visible=false, ZIndex=50, Parent=scGui})
    for i = 0, 60 do
        new("Frame", {Size=UDim2.new(1,0,0,1), Position=UDim2.new(0,0,i/60,0), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.85, BorderSizePixel=0, Parent=scanlines})
    end
    local vhsOverlay = new("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.fromRGB(80,0,80), BackgroundTransparency=0.9, Visible=false, ZIndex=51, Parent=scGui})
    local glitchOverlay = new("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.fromRGB(0,255,255), BackgroundTransparency=0.95, Visible=false, ZIndex=52, Parent=scGui})
    local ca = new("ColorCorrectionEffect", {Name="OwoChromatic", Enabled=false, Parent=Lighting})
    local dof = new("DepthOfFieldEffect", {Name="OwoDOF", Enabled=false, Parent=Lighting})
    local retro = new("ColorCorrectionEffect", {Name="OwoRetro", Enabled=false, Parent=Lighting})
    Fn.applyScreenFilters = function()
        ca.Enabled = feat.chromaticAberration
        dof.Enabled = feat.depthOfField
        retro.Enabled = feat.retroFilter
        scanlines.Visible = feat.vhsFilter or feat.glitchFilter
        vhsOverlay.Visible = feat.vhsFilter
        glitchOverlay.Visible = feat.glitchFilter
        if feat.chromaticAberration then
            ca.TintColor = Color3.new(1,1,1); ca.Saturation = feat.chromaticStrength*0.5; ca.Contrast = feat.chromaticStrength*0.15
        end
        if feat.retroFilter then
            local k = feat.retroStrength
            retro.TintColor = Color3.fromRGB(255,220,150); retro.Saturation = -0.4*k; retro.Contrast = 0.25*k; retro.Brightness = -0.03*k
        end
    end
    local glitchAcc = 0
    RS.RenderStepped:Connect(function(dt)
        if not feat.glitchFilter then return end
        glitchAcc += dt
        if glitchAcc > 0.05 then
