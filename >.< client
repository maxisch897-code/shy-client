-- ══════════════════════════════════════════════════════════════
Fn.applyAllTransparency = function()
    if UI.mainPanel then UI.mainPanel.BackgroundTransparency = TR.Window end
    for _, f in ipairs(UI.cards) do if f.Parent then f.BackgroundTransparency = TR.Card end end
    for _, f in pairs(overlays) do
        if not f:GetAttribute("Bare") and not f:GetAttribute("LBare") then f.BackgroundTransparency = TR.Overlay end
    end
end
Fn.setOpacity = function(amount)
    TR.Window = amount; TR.Sidebar = amount * 0.7; TR.Content = amount * 0.8
    TR.Title = amount * 0.6; TR.Card = amount * 0.5
    TR.Overlay = math.min(amount + 0.05, 0.95); TR.Notify = amount * 0.8
    Fn.applyAllTransparency()
end
Fn.applyGlassTransparency = function()
    local t = Glass.winT()
    TR.Window = t; TR.Sidebar = t; TR.Content = t; TR.Title = t
    TR.Card = math.clamp(t * 0.6 + 0.12, 0.3, 0.7)
    TR.Overlay = math.clamp(t * 0.7 + 0.05, 0.3, 0.75)
    TR.Notify = math.clamp(t * 0.7, 0.2, 0.7)
    Fn.applyAllTransparency()
end
Fn.setGlass = function(on, quiet)
    if on == Glass.on then return end
    Glass.on = on
    for _, g in ipairs(GlassGrads) do if g.Parent then g.Enabled = on end end
    for _, e in ipairs(GlassStrokes) do if e.s.Parent then e.g.Enabled = on; e.s.Transparency = on and 0.2 or e.o end end
    Glass.refreshAll()
    if on then Fn.applyGlassTransparency() else Fn.setOpacity(UI.opacity / 100) end
    if ToggleReg.LiquidGlass then pcall(ToggleReg.LiquidGlass, on) end
    if Fn.refreshKb then Fn.refreshKb() end
    if Fn.updateHud then Fn.updateHud() end
    if not quiet then notify("Liquid Glass", on and "ON" or "OFF", on) end
end
Fn.setGlassStyle = function(name, quiet)
    local s = Glass.styles[name]; if not s then return end
    Glass.applying = true
    local map = {clarity="GlassClarity", blur="GlassBlur", shine="GlassShine", tint="GlassTint"}
    for k, sn in pairs(map) do
        Glass[k] = s[k]
        if SliderReg[sn] then pcall(SliderReg[sn].set, s[k]) end
    end
    Glass.applying = false
    Glass.style = name
    if Glass.paintStyleBtns then Glass.paintStyleBtns() end
    if not Glass.on then Fn.setGlass(true, true) else Fn.applyGlassTransparency() end
    Glass.refreshAll()
    if not quiet then notify("Liquid Glass", "Style: " .. name) end
end
Fn.setEffectColor = function(c, quiet)
    EFFECT_COLOR = c
    if UI.colorPreview then UI.colorPreview.BackgroundColor3 = c end
    if UI.colorInput then UI.colorInput.Text = colorToHex(c) end
    Fn.rebuildVFX(); Wx.color()
    if Fn.rebuildAuraRing then Fn.rebuildAuraRing() end
    if Fn.rebuildOrbs then Fn.rebuildOrbs() end
    if Fn.skyRecolor then Fn.skyRecolor() end
    if Fn.rebuildCrosshair then Fn.rebuildCrosshair() end
    if not quiet then notify("Color", "Applied to all effects") end
end
Fn.hudPack = function(presetName)
    if presetName and PRESETS[presetName] then
        for k, v in pairs(PRESETS[presetName]) do T[k] = v end
        applyTheme(); Fn.applyAllTransparency(); Fn.refreshKb()
    end
    UI.hudSync = true
    Fn.setEffectColor(T.Accent, true)
    for _, n in ipairs({"MusicHud","Coords","SpeedHud","KbOverlay","Potions","FxTint","FxVignette","FxBloom","Crosshair"}) do
        if ToggleReg[n] then ToggleReg[n](true) end
    end
    Fn.updateHud()
    notify("HUD Pack", (presetName or "Current theme") .. " HUD enabled")
end

-- Smooth theme transition
Fn.smoothThemeApply = function(preset, duration)
    duration = duration or 0.6
    local fromColors = {}
    for k, v in pairs(preset) do if typeof(T[k]) == "Color3" then fromColors[k] = T[k] end end
    local start = os.clock()
    task.spawn(function()
        while os.clock() - start < duration do
            local t = (os.clock() - start) / duration
            local et = 1 - (1 - t)^3
            for k, target in pairs(preset) do
                if fromColors[k] then
                    T[k] = fromColors[k]:Lerp(target, et)
                else
                    T[k] = target
                end
            end
            applyTheme()
            Fn.applyAllTransparency()
            RS.RenderStepped:Wait()
        end
        for k, v in pairs(preset) do T[k] = v end
        applyTheme(); Fn.applyAllTransparency()
    end)
end

