local openKeyPrompt
do
    local promptGui = new("ScreenGui", {Name="OwoPrompt",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,Parent=pg})
    openKeyPrompt = function(name)
        for _, c in ipairs(promptGui:GetChildren()) do c:Destroy() end
        local bg = new("Frame", {Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=0.5,BorderSizePixel=0,ZIndex=100,Parent=promptGui})
        local box = new("Frame", {Size=UDim2.new(0,340,0,120),Position=UDim2.new(0.5,-170,0.5,-60),BackgroundColor3=T.Panel,BackgroundTransparency=0.05,BorderSizePixel=0,ZIndex=101,Parent=bg})
        corner(box, RB); stroke(box, 1, 0.5, T.Line, true)
        new("Frame",{Size=UDim2.new(1,0,0,3),BackgroundColor3=T.Accent,BorderSizePixel=0,ZIndex=102,Parent=box})
        new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,0,0,20),Size=UDim2.new(1,0,0,22),Font=Enum.Font.GothamBold,Text="PRESS A KEY",TextColor3=T.Text,TextSize=14,ZIndex=102,Parent=box})
        new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,0,0,48),Size=UDim2.new(1,0,0,18),Font=Enum.Font.GothamMedium,Text=name,TextColor3=T.Accent,TextSize=12,ZIndex=102,Parent=box})
        new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,0,0,78),Size=UDim2.new(1,0,0,16),Font=Enum.Font.Gotham,Text="ESC cancel • BACKSPACE clear",TextColor3=T.Muted,TextSize=10,ZIndex=102,Parent=box})
        local cn
        cn = UIS.InputBegan:Connect(function(i, gp)
            if i.KeyCode == Enum.KeyCode.Escape then cn:Disconnect(); bg:Destroy()
            elseif i.KeyCode == Enum.KeyCode.Backspace then
                if Keybinds[name] then Keybinds[name].key = nil end
                cn:Disconnect(); bg:Destroy(); notify("Keybind", name.." cleared")
            elseif not gp and i.KeyCode ~= Enum.KeyCode.Unknown then
                if Keybinds[name] then Keybinds[name].key = i.KeyCode end
                cn:Disconnect(); bg:Destroy(); notify("Keybind", name.." → "..i.KeyCode.Name)
            end
        end)
    end
    UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Enum.KeyCode.RightShift then return end
        for _, k in pairs(Keybinds) do
            if k.key and i.KeyCode == k.key then
                if k.isToggle then k.setState(not k.getState())
                elseif k.fire then pcall(k.fire) end
                break
            end
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- MOVEMENT
-- ══════════════════════════════════════════════════════════════
do
    local flyBV, flyVel = nil, Vector3.zero
    Fn.startFly = function()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then notify("Fly","Character not ready",false); return end
        feat.fly = true; flyVel = Vector3.zero
        if flyBV then flyBV:Destroy() end
        flyBV = new("BodyVelocity", {MaxForce=Vector3.new(1e5,1e5,1e5), Velocity=Vector3.zero, P=1250, Parent=hrp})
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = true end
        notify("Fly","ON")
    end
    Fn.stopFly = function()
        feat.fly = false
        if flyBV then flyBV:Destroy(); flyBV = nil end
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        flyVel = Vector3.zero
        notify("Fly","OFF",false)
    end
    player.CharacterAdded:Connect(function() if feat.fly then task.wait(0.5); Fn.startFly() end end)
    RS.Heartbeat:Connect(function(dt)
        if not flyBV then return end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then flyBV:Destroy(); flyBV = nil; return end
        if flyBV.Parent ~= hrp then flyBV.Parent = hrp end
        local cf = camera.CFrame
        local camLook = cf.LookVector
        if camLook.Magnitude > 0.01 then
            camLook = camLook.Unit
            local clamped = Vector3.new(camLook.X, math.clamp(camLook.Y, -feat.flyPitchAmount, feat.flyPitchAmount), camLook.Z)
            if clamped.Magnitude > 0.01 then hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + clamped) end
        end
        local look, right = cf.LookVector, cf.RightVector
        local input = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then input += look end
        if UIS:IsKeyDown(Enum.KeyCode.S) then input -= look end
        if UIS:IsKeyDown(Enum.KeyCode.A) then input -= right end
        if UIS:IsKeyDown(Enum.KeyCode.D) then input += right end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then input += Vector3.new(0,1,0)*feat.flyVerticalBoost end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then input -= Vector3.new(0,1,0)*feat.flyVerticalBoost end
        if input.Magnitude > 1 then input = input.Unit end
        local targetVel = input * feat.flySpeed
        local rate = (input.Magnitude > 0.05) and feat.flyAccel or feat.flyDamping
        flyVel = flyVel:Lerp(targetVel, math.clamp(rate*dt, 0, 1))
        flyBV.Velocity = flyVel
    end)
    RS.Stepped:Connect(function()
        if not feat.noclip then return end
        local c = player.Character; if not c then return end
        for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end end
    end)
    UIS.JumpRequest:Connect(function()
        if feat.infJump then
            local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- FREE CAM
-- ══════════════════════════════════════════════════════════════
do
    local fcConn, fcYaw, fcPitch = nil, 0, 0
    local fcPos = Vector3.zero
    local fcSaved = {anchored=false, walkSpeed=16, jumpPower=50}
    local function freeze()
        local char = player.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then fcSaved.anchored = hrp.Anchored; hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero; hrp.Anchored = true end
        if hum then fcSaved.walkSpeed = hum.WalkSpeed; fcSaved.jumpPower = hum.JumpPower; hum.WalkSpeed = 0; hum.JumpPower = 0; hum.AutoRotate = false end
    end
    local function unfreeze()
        local char = player.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then hrp.Anchored = fcSaved.anchored end
        if hum then hum.WalkSpeed = feat.walkSpeed or fcSaved.walkSpeed; hum.JumpPower = feat.jumpPower or fcSaved.jumpPower; hum.AutoRotate = true end
    end
    Fn.startFreeCam = function()
        local kb = Keybinds["FreeCam"]
        if not (kb and kb.key) then notify("Free Cam","Set a keybind first",false); return false end
        local x, y = camera.CFrame:ToEulerAnglesYXZ(); fcYaw, fcPitch = y, x
        fcPos = camera.CFrame.Position
        camera.CameraType = Enum.CameraType.Scriptable
        feat.freeCam = true
        UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
        freeze()
        fcConn = RS.RenderStepped:Connect(function(dt)
            local d = Vector3.zero
            local cf = CFrame.new(fcPos) * CFrame.Angles(0, fcYaw, 0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then d += cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then d += cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d -= Vector3.new(0,1,0) end
            if d.Magnitude > 0 then fcPos += d.Unit * feat.freeCamSpeed * dt end
            camera.CFrame = CFrame.new(fcPos) * CFrame.Angles(0, fcYaw, 0) * CFrame.Angles(fcPitch, 0, 0)
        end)
        notify("Free Cam","ON — press your keybind to exit")
        return true
    end
    Fn.stopFreeCam = function()
        feat.freeCam = false
        if fcConn then fcConn:Disconnect(); fcConn = nil end
        camera.CameraType = Enum.CameraType.Custom
        UIS.MouseBehavior = Enum.MouseBehavior.Default
        unfreeze()
        notify("Free Cam","OFF",false)
    end
    UIS.InputChanged:Connect(function(i)
        if not fcConn then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement then
            fcYaw = fcYaw - math.rad(i.Delta.X)*1.5
            fcPitch = math.clamp(fcPitch - math.rad(i.Delta.Y)*1.5, math.rad(-89), math.rad(89))
        end
    end)
    player.CharacterAdded:Connect(function() if feat.freeCam then task.wait(0.6); if feat.freeCam then freeze() end end end)
end

-- ══════════════════════════════════════════════════════════════
-- CAMERA FX (smoothed)
-- ══════════════════════════════════════════════════════════════
do
    local shakeOff, shakeDecay, baseRoll = CFrame.new(), 0, 0
    local sFovAdd, sShakeTarget = 0, 0
    local lastCamCF = camera.CFrame
    local smoothedCF = camera.CFrame
    Fn.triggerShake = function(amount) if feat.screenShake then shakeDecay = math.max(shakeDecay, amount * feat.shakeAmount) end end
    RS.RenderStepped:Connect(function(dt)
        if shakeDecay > 0.001 then
            local s = shakeDecay * 0.6
            shakeOff = CFrame.new((math.random()-0.5)*s, (math.random()-0.5)*s, 0) * CFrame.Angles((math.random()-0.5)*shakeDecay*0.05, (math.random()-0.5)*shakeDecay*0.05, (math.random()-0.5)*shakeDecay*0.08)
            shakeDecay = shakeDecay * math.clamp(1 - dt*8, 0, 1)
        else shakeOff = CFrame.new(); shakeDecay = 0 end
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local sprinting = false
        if hum and hrp and hum.MoveDirection.Magnitude > 0.1 then
            local v = hrp.AssemblyLinearVelocity
            if Vector3.new(v.X, 0, v.Z).Magnitude > feat.walkSpeed * 0.9 then sprinting = true end
        end
        local tb = (feat.sprintFov and sprinting) and feat.sprintFovBoost or 0
        sFovAdd = slerp(sFovAdd, tb, dt, 4)
        local roll = 0
        if feat.cameraRoll and hum then roll = hum.MoveDirection:Dot(camera.CFrame.RightVector) * math.rad(feat.cameraRollAmount) end
        baseRoll = slerp(baseRoll, roll, dt, 6)
        if feat.sprintFov then camera.FieldOfView = math.clamp(70 + sFovAdd, 20, 120) end
        if (feat.screenShake and shakeDecay > 0) or feat.cameraRoll then
            camera.CFrame = camera.CFrame * shakeOff * CFrame.Angles(0, 0, baseRoll)
        end
        -- Smooth camera motion
        if feat.smoothCamera and not feat.freeCam then
            local cur = camera.CFrame
            local target = cur
            smoothedCF = smoothedCF:Lerp(target, 1 - math.exp(-dt * 20 * feat.smoothCameraStrength * Smooth.level))
            camera.CFrame = smoothedCF
        else
            smoothedCF = camera.CFrame
        end
    end)
end

-- ══════════════════════════════════════════════════════════════
-- VFX
-- ══════════════════════════════════════════════════════════════
do
    local vfxObj = {}
    local function clearVfx()
        for _, o in pairs(vfxObj) do
            if typeof(o) == "Instance" then pcall(function() o:Destroy() end)
            elseif typeof(o) == "RBXScriptConnection" then pcall(function() o:Disconnect() end) end
        end
        vfxObj = {}
    end
    local function ring(pos, col, sz)
        local p = new("Part",{Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,Shape=Enum.PartType.Cylinder,Size=Vector3.new(0.3,sz,sz),CFrame=CFrame.new(pos)*CFrame.Angles(0,0,math.rad(90)),Material=Enum.Material.Neon,Color=col,Transparency=0.15,Parent=workspace})
        local t = TS:Create(p,TweenInfo.new(sdur(0.7),Enum.EasingStyle.Quint),{Size=Vector3.new(0.1,sz*4,sz*4),Transparency=1})
        t:Play(); t.Completed:Connect(function() p:Destroy() end)
    end
    local neonSaved = {}
    local neonConn = nil
    Fn.applyNeonBody = function()
        local char = player.Character; if not char then return end
        if feat.neon then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    if neonSaved[p] == nil then neonSaved[p] = p.Material end
                    p.Material = Enum.Material.Neon; p.Color = EFFECT_COLOR
                end
            end
        else
            for p, mat in pairs(neonSaved) do if p and p.Parent then p.Material = mat end end
            table.clear(neonSaved)
        end
    end
    local function hookNeon(char)
        if neonConn then neonConn:Disconnect(); neonConn = nil end
        if not char then return end
        Fn.applyNeonBody()
        neonConn = char.DescendantAdded:Connect(function() if feat.neon then task.defer(Fn.applyNeonBody) end end)
    end
    local function applyTrans(p)
        if not p:IsA("BasePart") or p.Name == "HumanoidRootPart" then return end
        p.LocalTransparencyModifier = (feat.playerTransparency and feat.playerTransparencyLevel/100) or 0
    end
    Fn.applyPlayerTransparency = function()
        local c = player.Character; if not c then return end
        for _, d in ipairs(c:GetDescendants()) do applyTrans(d) end
    end
    local function hookTrans(char)
        if not char then return end
        Fn.applyPlayerTransparency()
        char.DescendantAdded:Connect(function(d) task.defer(function() applyTrans(d) end) end)
    end
    local rainbowOrig, rainbowConn = {}, nil
    Fn.applyRainbowChar = function()
        local char = player.Character; if not char then return end
        if not feat.rainbowChar then
            for p, col in pairs(rainbowOrig) do if p and p.Parent then p.Color = col end end
            table.clear(rainbowOrig)
            if rainbowConn then rainbowConn:Disconnect(); rainbowConn = nil end
            return
        end
        for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and rainbowOrig[p] == nil then rainbowOrig[p] = p.Color end end
        if not rainbowConn then
            local t = 0
            rainbowConn = RS.Heartbeat:Connect(function(dt)
                if not feat.rainbowChar then return end
                t += dt * feat.rainbowSpeed
                local c = player.Character; if not c then return end
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                        local hue = (t + (p.Position.X + p.Position.Z)*0.05) % 1
                        p.Color = Color3.fromHSV(hue, 0.85, 1)
                    end
                end
            end)
        end
    end
    local auraPart, auraConn = nil, nil
    Fn.rebuildAuraRing = function()
        if auraPart then auraPart:Destroy(); auraPart = nil end
        if auraConn then auraConn:Disconnect(); auraConn = nil end
        if not feat.auraRing then return end
        auraPart = new("Part", {Shape=Enum.PartType.Cylinder, Size=Vector3.new(0.12, feat.auraRingSize, feat.auraRingSize), Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Material=Enum.Material.Neon, Color=EFFECT_COLOR, Transparency=0.25, Parent=workspace})
        local t = 0
        auraConn = RS.RenderStepped:Connect(function(dt)
            t += dt
            local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp or not auraPart then return end
            local pulse = 1 + math.sin(t*3)*0.08
            auraPart.Size = Vector3.new(0.12, feat.auraRingSize*pulse, feat.auraRingSize*pulse)
            auraPart.CFrame = CFrame.new(hrp.Position - Vector3.new(0,2.7,0)) * CFrame.Angles(0,0,math.rad(90))
            auraPart.Color = EFFECT_COLOR
            auraPart.Transparency = 0.25 + math.sin(t*4)*0.1
        end)
    end
    local orbs, orbsConn = {}, nil
    Fn.rebuildOrbs = function()
        for _, o in ipairs(orbs) do o:Destroy() end
        orbs = {}
        if orbsConn then orbsConn:Disconnect(); orbsConn = nil end
        if not feat.orbitOrbs then return end
        for i = 1, feat.orbitOrbCount do
            orbs[i] = new("Part", {Shape=Enum.PartType.Ball, Size=Vector3.new(feat.orbitOrbSize,feat.orbitOrbSize,feat.orbitOrbSize), Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Material=Enum.Material.Neon, Color=EFFECT_COLOR, Parent=workspace})
        end
        local t = 0
        orbsConn = RS.RenderStepped:Connect(function(dt)
            t += dt * feat.orbitOrbSpeed
            local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local n = #orbs
            for i, o in ipairs(orbs) do
                if not o.Parent then continue end
                local angle = t + (i-1)/n * math.pi * 2
                local h = math.sin(t*2 + i) * 0.5
                o.CFrame = CFrame.new(hrp.Position + Vector3.new(math.cos(angle)*feat.orbitOrbRadius, h, math.sin(angle)*feat.orbitOrbRadius))
                o.Color = EFFECT_COLOR
            end
        end)
    end
    local lightConn, lightAcc = nil, 0
    Fn.rebuildLightning = function()
        if lightConn then lightConn:Disconnect(); lightConn = nil end
        if not feat.lightningAura then return end
        lightAcc = 0
        lightConn = RS.Heartbeat:Connect(function(dt)
            lightAcc += dt
            if lightAcc < 1/feat.lightningRate then return end
            lightAcc = 0
            local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local from = hrp.Position + Vector3.new(math.random(-2,2), math.random(-2,2), math.random(-2,2))
            local to = hrp.Position + Vector3.new(math.random(-2,2), math.random(-2,2), math.random(-2,2))
            local mid = (from+to)/2 + Vector3.new((math.random()-0.5)*2, (math.random()-0.5)*2, (math.random()-0.5)*2)
            local len = (from-to).Magnitude
            local a = new("Part", {Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Material=Enum.Material.Neon, Color=EFFECT_COLOR, Size=Vector3.new(0.12,0.12,len), CFrame=CFrame.lookAt(mid, to), Transparency=0.1, Parent=workspace})
            TS:Create(a, TweenInfo.new(sdur(0.18)), {Transparency=1, Size=Vector3.new(0.02,0.02,len)}):Play()
            task.delay(0.2, function() if a then a:Destroy() end end)
        end)
    end
    local lastPos, footConn = nil, nil
    Fn.rebuildFireFootsteps = function()
        if footConn then footConn:Disconnect(); footConn = nil end
        if not feat.fireFootsteps then return end
        lastPos = nil
        footConn = RS.Heartbeat:Connect(function()
            local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart"); local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then lastPos = nil; return end
            if hum.MoveDirection.Magnitude < 0.1 then lastPos = hrp.Position; return end
            if not lastPos then lastPos = hrp.Position; return end
            if (hrp.Position - lastPos).Magnitude < 0.8 then return end
            lastPos = hrp.Position
            local em = new("Part", {Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Transparency=1, Size=Vector3.new(1,1,1), CFrame=hrp.CFrame*CFrame.new(0,-2.6,0), Parent=workspace})
            local pe = new("ParticleEmitter", {Texture="rbxassetid://243098098", Rate=0, Lifetime=NumberRange.new(0.4,0.8), Speed=NumberRange.new(2,5), SpreadAngle=Vector2.new(35,35), EmissionDirection=Enum.NormalId.Top, Color=ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255,240,180)), ColorSequenceKeypoint.new(0.4, EFFECT_COLOR), ColorSequenceKeypoint.new(1, Color3.fromRGB(20,20,20))}), Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.8),NumberSequenceKeypoint.new(1,0)}), Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.1),NumberSequenceKeypoint.new(1,1)}), LightEmission=1, Parent=em})
            pe:Emit(12)
            task.delay(1, function() if em then em:Destroy() end end)
        end)
    end
    Fn.rebuildVFX = function()
        clearVfx()
        local char = player.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        local EC = EFFECT_COLOR
        Fn.applyNeonBody(); Fn.applyPlayerTransparency(); Fn.applyRainbowChar()
        Fn.rebuildAuraRing(); Fn.rebuildOrbs(); Fn.rebuildLightning(); Fn.rebuildFireFootsteps()
        if feat.glow then
            vfxObj.g1 = new("Highlight",{FillColor=EC,FillTransparency=0.5,OutlineColor=EC,OutlineTransparency=0,Parent=char})
            vfxObj.g2 = new("PointLight",{Color=EC,Range=20,Brightness=3,Parent=hrp})
        end
        if feat.trail then
            local a0 = new("Attachment",{Position=Vector3.new(0,0.6,0),Parent=hrp})
