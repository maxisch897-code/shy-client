-- GLOSSY (REFLECTIVE WORLD)
-- ══════════════════════════════════════════════════════════════
do
    local saved = {}
    local conn = nil
    local function skipPart(p)
        if not p:IsA("BasePart") then return true end
        if p:IsA("Terrain") then return true end
        if player.Character and p:IsDescendantOf(player.Character) then return true end
        local a = p
        while a and a ~= workspace do
            if a.Name and a.Name:sub(1,3) == "Owo" then return true end
            a = a.Parent
        end
        return false
    end
    local function applyTo(p)
        if skipPart(p) then return end
        if saved[p] == nil then saved[p] = p.Reflectance end
        pcall(function() p.Reflectance = feat.reflectiveStrength end)
    end
    local function clearAll()
        for p, r in pairs(saved) do
            if p and p.Parent then pcall(function() p.Reflectance = r end) end
        end
        table.clear(saved)
        if conn then conn:Disconnect(); conn = nil end
    end
    Fn.applyReflective = function()
        if not feat.reflective then clearAll(); return end
        for _, d in ipairs(workspace:GetDescendants()) do applyTo(d) end
        if not conn then
            conn = workspace.DescendantAdded:Connect(function(d)
                if feat.reflective then task.defer(function() applyTo(d) end) end
            end)
        end
    end
    Fn.setReflectiveStrength = function(v)
        feat.reflectiveStrength = v
        if feat.reflective then
            for p in pairs(saved) do
                if p and p.Parent then pcall(function() p.Reflectance = v end) end
            end
        end
    end
end

-- ══════════════════════════════════════════════════════════════
-- FPS BOOST
-- ══════════════════════════════════════════════════════════════
do
    local savedDecals   = {}
    local savedSA       = {}
    local savedMeshTex  = {}
    local conn          = nil
    local function isCharacter(p) return player.Character and p:IsDescendantOf(player.Character) end
    local function isOwo(p)
        local a = p
        while a and a ~= workspace do
            if a.Name and a.Name:sub(1, 3) == "Owo" then return true end
            a = a.Parent
        end
        return false
    end
    local function stripPart(p)
        if isCharacter(p) or isOwo(p) then return end
        for _, c in ipairs(p:GetChildren()) do
            if c:IsA("Decal") or c:IsA("Texture") then
                if savedDecals[c] == nil then savedDecals[c] = c.Transparency end
                c.Transparency = 1
            elseif c:IsA("SurfaceAppearance") then
                savedSA[p] = savedSA[p] or {}
                table.insert(savedSA[p], c:Clone())
                c:Destroy()
            end
        end
        if p:IsA("MeshPart") and p.TextureID ~= "" then
            if savedMeshTex[p] == nil then savedMeshTex[p] = p.TextureID end
            p.TextureID = ""
        end
        local sm = p:FindFirstChildOfClass("SpecialMesh")
        if sm and sm.TextureId ~= "" then
            if savedMeshTex[sm] == nil then savedMeshTex[sm] = sm.TextureId end
            sm.TextureId = ""
        end
    end
    local function restoreAll()
        for d, t in pairs(savedDecals) do
            if d and d.Parent then pcall(function() d.Transparency = t end) end
        end
        table.clear(savedDecals)
        for parent, list in pairs(savedSA) do
            if parent and parent.Parent then
                for _, sa in ipairs(list) do pcall(function() sa.Parent = parent end) end
            end
        end
        table.clear(savedSA)
        for inst, id in pairs(savedMeshTex) do
            if inst and inst.Parent then
                if inst:IsA("MeshPart") then
                    pcall(function() inst.TextureID = id end)
                else
                    pcall(function() inst.TextureId = id end)
                end
            end
        end
        table.clear(savedMeshTex)
        if conn then conn:Disconnect(); conn = nil end
    end
    Fn.applyFpsBoost = function()
        if not feat.fpsBoost then restoreAll(); return end
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("BasePart") then stripPart(d) end
        end
        if not conn then
            conn = workspace.DescendantAdded:Connect(function(d)
                if feat.fpsBoost and d:IsA("BasePart") then task.defer(function() stripPart(d) end) end
            end)
        end
    end
end

-- ══════════════════════════════════════════════════════════════
-- REALISTIC SHADER
-- ══════════════════════════════════════════════════════════════
do
    local cc = new("ColorCorrectionEffect", {Name="OwoRealistic",      Enabled=false, Parent=Lighting})
    local bl = new("BloomEffect",           {Name="OwoRealisticBloom", Enabled=false, Parent=Lighting})
    local sr = new("SunRaysEffect",         {Name="OwoRealisticRays",  Enabled=false, Parent=Lighting})
    local df = new("DepthOfFieldEffect",    {Name="OwoRealisticDOF",   Enabled=false, Parent=Lighting})
    local sCC, sBL, sSR, sDF = 0, 0, 0, 0
    Fn.applyRealistic = function()
        local k = feat.realisticStrength or 1
        cc.Brightness  = 0.03 * k
        cc.Contrast    = 0.20 * k
        cc.Saturation  = 0.25 * k
        cc.TintColor   = Color3.fromRGB(255, 250, 240)
        bl.Intensity   = 0.90 * k
        bl.Size        = 26 * k
        bl.Threshold   = 0.88
        sr.Intensity   = 0.08 * k
        sr.Spread      = 0.45
        df.NearIntensity = 0
        df.FarIntensity  = 0.18 * k
        df.FocusDistance = 60
        df.InFocusRadius = 30
    end
    Fn.setRealisticStrength = function(v)
        feat.realisticStrength = v
        if feat.realistic then Fn.applyRealistic() end
    end
    RS.RenderStepped:Connect(function(dt)
        local target = feat.realistic and 1 or 0
        sCC = slerp(sCC, target, dt, 6)
        sBL = slerp(sBL, target, dt, 6)
        sSR = slerp(sSR, target, dt, 6)
        sDF = slerp(sDF, target, dt, 6)
        cc.Enabled = sCC > 0.01
        bl.Enabled = sBL > 0.01
        sr.Enabled = sSR > 0.01
        df.Enabled = sDF > 0.01
        if sCC > 0.01 then
            cc.Brightness = 0.03 * sCC * feat.realisticStrength
            cc.Contrast = 0.20 * sCC * feat.realisticStrength
            cc.Saturation = 0.25 * sCC * feat.realisticStrength
        end
        if sBL > 0.01 then
            bl.Intensity = 0.90 * sBL * feat.realisticStrength
            bl.Size = 26 * sBL * feat.realisticStrength
        end
        if sSR > 0.01 then sr.Intensity = 0.08 * sSR * feat.realisticStrength end
        if sDF > 0.01 then df.FarIntensity = 0.18 * sDF * feat.realisticStrength end
    end)
end

