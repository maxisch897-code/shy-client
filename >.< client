    local ghostFx = new("Folder", {Name="OwoGhost", Parent=workspace})
    local ghostLast = 0
    local function spawnGhost(char)
        local ok, c = pcall(function() return char:Clone() end)
        if not ok or not c then return end
        local parts = {}
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Anchored = true; d.CanCollide = false; d.CanQuery = false; d.CanTouch = false; d.CastShadow = false
                d.Material = Enum.Material.Neon; d.Color = EFFECT_COLOR
                if d.Name == "HumanoidRootPart" then d.Transparency = 1 else d.Transparency = 0.45; parts[#parts+1] = d end
            elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Decal") or d:IsA("Texture") or d:IsA("Humanoid")
                or d:IsA("Sound") or d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d:IsA("Trail")
                or d:IsA("Light") or d:IsA("Highlight") or d:IsA("Beam") or d:IsA("SurfaceAppearance") then
                d:Destroy()
            end
        end
        c.Parent = ghostFx
        for _, p in ipairs(parts) do
            TS:Create(p, TweenInfo.new(sdur(0.6), Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1}):Play()
        end
        task.delay(0.7, function() c:Destroy() end)
    end
    RS.Heartbeat:Connect(function(dt)
        if not feat.ghost then return end
        local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local now = tick()
        if now - ghostLast >= feat.ghostInterval then
            local v = hrp.AssemblyLinearVelocity
            if Vector3.new(v.X, 0, v.Z).Magnitude > 3 then ghostLast = now; spawnGhost(char) end
        end
    end)
    if player.Character then task.spawn(Fn.rebuildVFX) end
    player.CharacterAdded:Connect(function(c) task.wait(0.5); Fn.rebuildVFX(); hookNeon(c); hookTrans(c) end)
    if player.Character then hookNeon(player.Character); hookTrans(player.Character) end
end

