-- MOTION BLUR
-- ══════════════════════════════════════════════════════════════
do
    local mb = new("BlurEffect", {Name="OwoMotionBlur", Size=0, Enabled=false, Parent=Lighting})
    local lastCF = camera.CFrame
    local smoothSize = 0
    RS.RenderStepped:Connect(function(dt)
        if not feat.motionBlur then
            smoothSize = slerp(smoothSize, 0, dt, 12)
            mb.Size = smoothSize
            if mb.Enabled and smoothSize < 0.05 then mb.Enabled = false end
            lastCF = camera.CFrame
            return
        end
        mb.Enabled = true
        local cur = camera.CFrame
        local dp = (cur.Position - lastCF.Position).Magnitude
        local da = (cur.LookVector - lastCF.LookVector).Magnitude
        lastCF = cur
        local speed = dp / math.max(dt, 1/120)
        local rotSpeed = da / math.max(dt, 1/120)
        local target = math.clamp((speed * 0.12 + rotSpeed * 2.0) * feat.motionBlurStrength, 0, 20)
        smoothSize = slerp(smoothSize, target, dt, 8)
        mb.Size = smoothSize
    end)
end

