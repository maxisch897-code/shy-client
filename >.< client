-- ESP / CHAMS
-- ══════════════════════════════════════════════════════════════
do
    local espFolder = new("Folder", {Name="OwoESP", Parent=workspace})
    local espData = {}
    local function createEspFor(plr)
        if plr == player or espData[plr] then return end
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        if not head then return end
        local data = {}
        local bb = new("BillboardGui", {Adornee=head, Size=UDim2.new(0,140,0,48), StudsOffsetWorldSpace=Vector3.new(0,2.8,0), AlwaysOnTop=true, LightInfluence=0, MaxDistance=feat.espMaxDist, Parent=head})
        local bg = new("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.5, BorderSizePixel=0, Parent=bb}); corner(bg, 6)
        data.nameLbl = new("TextLabel", {Size=UDim2.new(1,-6,0,18), Position=UDim2.new(0,3,0,2), BackgroundTransparency=1, Font=Enum.Font.GothamBold, Text=plr.Name, TextColor3=Color3.new(1,1,1), TextSize=12, TextStrokeTransparency=0.3, Parent=bg})
        data.distLbl = new("TextLabel", {Size=UDim2.new(1,-6,0,14), Position=UDim2.new(0,3,0,20), BackgroundTransparency=1, Font=Enum.Font.Gotham, Text="", TextColor3=Color3.fromRGB(200,200,200), TextSize=10, TextStrokeTransparency=0.4, Parent=bg})
        local healthBg = new("Frame", {Size=UDim2.new(1,-6,0,4), Position=UDim2.new(0,3,1,-8), BackgroundColor3=Color3.fromRGB(30,30,30), BorderSizePixel=0, Parent=bg}); corner(healthBg, 2)
        data.healthBar = new("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.fromRGB(80,220,120), BorderSizePixel=0, Parent=healthBg}); corner(data.healthBar, 2)
        data.billboard = bb
        if feat.espChams then
            data.highlight = new("Highlight", {FillColor=EFFECT_COLOR, FillTransparency=0.7, OutlineColor=EFFECT_COLOR, OutlineTransparency=0.2, Adornee=char, Parent=espFolder})
        end
        espData[plr] = data
    end
    local function destroyEspFor(plr)
        local data = espData[plr]; if not data then return end
        for _, obj in pairs(data) do if typeof(obj) == "Instance" then obj:Destroy() end end
        espData[plr] = nil
    end
    Fn.refreshEsp = function()
        for plr, data in pairs(espData) do
            if data.billboard then data.billboard.Enabled = feat.espEnabled and (feat.espNames or feat.espHealth or feat.espDistance) end
            if data.nameLbl then data.nameLbl.Visible = feat.espNames end
            if data.distLbl then data.distLbl.Visible = feat.espDistance end
            if data.healthBar then data.healthBar.Parent.Visible = feat.espHealth end
            if data.highlight then data.highlight.Enabled = feat.espEnabled and feat.espChams end
        end
    end
    local function onPlayerAdded(plr)
        plr.CharacterAdded:Connect(function() task.wait(1); destroyEspFor(plr); if feat.espEnabled then createEspFor(plr) end end)
        if plr.Character and feat.espEnabled then createEspFor(plr) end
    end
    for _, plr in ipairs(Players:GetPlayers()) do onPlayerAdded(plr) end
    Players.PlayerAdded:Connect(onPlayerAdded)
    Players.PlayerRemoving:Connect(destroyEspFor)
    Fn.setEspEnabled = function(on)
        if on then for _, plr in ipairs(Players:GetPlayers()) do if plr ~= player then createEspFor(plr) end end
        else for plr in pairs(espData) do destroyEspFor(plr) end end
        Fn.refreshEsp()
    end
    RS.RenderStepped:Connect(function()
        if not feat.espEnabled then return end
        local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        local myPos = myHrp.Position
        for plr, data in pairs(espData) do
            local char = plr.Character
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not head or not hum then
                if data.billboard then data.billboard.Enabled = false end
            else
                local d = (head.Position - myPos).Magnitude
                local visible = d <= feat.espMaxDist
                if feat.espTeamCheck and plr.Team == player.Team then visible = false end
                if data.billboard then data.billboard.Enabled = visible and (feat.espNames or feat.espHealth or feat.espDistance) end
                if data.distLbl then data.distLbl.Text = string.format("%d studs", math.floor(d)) end
                if data.healthBar then
                    local hp = math.clamp(hum.Health/math.max(hum.MaxHealth,1), 0, 1)
                    data.healthBar.Size = UDim2.new(hp, 0, 1, 0)
                    data.healthBar.BackgroundColor3 = hp > 0.6 and Color3.fromRGB(80,220,120) or (hp > 0.3 and Color3.fromRGB(240,200,80) or Color3.fromRGB(240,80,90))
                end
                if data.highlight then data.highlight.Enabled = visible and feat.espChams end
            end
        end
    end)
end

