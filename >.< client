-- WIDGET EDIT MODE  (widgets can only be moved / resized / re-styled while the chat is open)
-- ══════════════════════════════════════════════════════════════
local Edit = { focused=false, last=-10, on=false, listeners={} }
do
    local function chatFocused()
        local ok, v = pcall(function() return TextChatService.ChatInputBarConfiguration.IsFocused end)
        if ok and v == true then return true end
        local okb, tb = pcall(function() return UIS:GetFocusedTextBox() end)
        if okb and tb and tb.Name == "ChatBar" then return true end
        return false
    end
    -- chat loses focus the moment you click a widget, so a short grace period keeps edit mode alive for that click
    Fn.canEdit = function() return feat.editAnywhere or Edit.focused or (os.clock() - Edit.last) < 0.35 end
    RS.RenderStepped:Connect(function()
        local f = chatFocused()
        if f then Edit.last = os.clock() end
        Edit.focused = f
        local on = Fn.canEdit()
        if on ~= Edit.on then
            Edit.on = on
            for _, fn in ipairs(Edit.listeners) do pcall(fn, on) end
        end
    end)
end

