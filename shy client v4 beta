            local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart"); local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then lastPos = nil; return end
            if hum.MoveDirection.Magnitude < 0.1 then lastPos = hrp.Position; return end
            if not lastPos then lastPos = hrp.Position; return end
            if (hrp.Position - lastPos).Magnitude < 0.8 then return end
            lastPos = hrp.Position
            local em = new("Part", {Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Transparency=1, Size=Vector3.new(1,1,1), CFrame=hrp.CFrame*CFrame.new(0,-2.6,0), Parent=workspace})
            local pe = new("ParticleEmitter", {Texture="rbxassetid://243098098", Rate=0, Lifetime=NumberRange.new(0.4,0.8), Speed=NumberRange.new(2,5), SpreadAngle=Vector2.new(35,35), EmissionDirection=Enum.NormalId.Top, Color=ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255,240,180)), ColorSequenceKeypoint.new(0.4, EFFECT_COLOR), ColorSequenceKeypoint.new(1, Color3.fromRGB(20,20,20))}), Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.8),NumberSequenceKeypoint.new(1,0)}), Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.1),NumberSequenceKeypoint.new(1,1)}), LightEmission=1, Parent=em})
            pe:Emit(12)
            task.delay(1, function() if em then em:Destroy() end end)
