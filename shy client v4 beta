    regRef(lbl, "TextColor3", "Text")
    local vBox = new("Frame",{Position=UDim2.new(1,-72,0,7),Size=UDim2.new(0,54,0,20),BackgroundColor3=T.Accent,BorderSizePixel=0,ZIndex=3,Parent=row})
