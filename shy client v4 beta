-- SAVES (with migration) ---------------------------------------
do
    local Saves, SaveOrder = {}, {}
    local SAVE_FILE = "shyclient_v3_saves.json"
    local OVKB = {statusBar="StatusBar", fps="FpsBox", coords="Coords", ping="PingBox", watermark="Watermark", keybinds="KbOverlay", musicHud="MusicHud", speed="SpeedHud"}
    local FEATMAP = {
        Fly="fly", InfJump="infJump", NoClip="noclip", FreeCam="freeCam", Fullbright="fullbright",
        VFXGlow="glow", VFXNeon="neon", VFXTrail="trail", VFXFire="fire", VFXSparkle="sparkle",
        VFXHalo="halo", VFXWings="wings", VFXCrown="crown",
        SkyBlackHole="skyBlackHole", SkyAurora="skyAurora", SkyGalaxy="skyGalaxy", SkyNebula="skyNebula",
        SkyStarryNight="skyStarryNight", VFXJumpRing="jumpRing", VFXLandRing="landRing",
        WxRain="rain", WxSnow="snow", WxFog="fog", WxThunder="thunder", FxFireflies="fireflies",
        WxMeteor="meteorShower", FxCubes="cubes", FxAmbient="ambient", FxTint="tint",
        FxBloom="bloom", FxVignette="vignette", Lyrics3D="lyrics3d", PlayerTrans="playerTransparency",
        RainbowChar="rainbowChar", AuraRing="auraRing", OrbitOrbs="orbitOrbs",
        LightningAura="lightningAura", FireFootsteps="fireFootsteps", FxButterflies="butterflies",
        FxChroma="chromaticAberration", FxDOF="depthOfField", FxRetro="retroFilter",
        FxVHS="vhsFilter", FxGlitch="glitchFilter", SprintFov="sprintFov", CamRoll="cameraRoll",
        ScreenShake="screenShake", EspEnabled="espEnabled", EspNames="espNames", EspHealth="espHealth",
        EspDistance="espDistance", EspChams="espChams", EspTeam="espTeamCheck",
        Crosshair="crosshair", ChDot="crosshairDot", ChOutline="crosshairOutline",
        UISounds="uiSounds", StatusBarLyrics="lyricsInStatusBar", SmoothLyrics="smoothLyricsTransition",
    }
    local function col(t) if type(t) == "table" and #t == 3 then return Color3.new(t[1], t[2], t[3]) end return nil end
    local function snap()
        local d = {theme={}, transparency={}, features={}, keybinds={}, sliders={}, overlays={}, meta={}, music={}, glass={}, friends={}}
        for k, v in pairs(T) do if typeof(v) == "Color3" then d.theme[k] = {v.R, v.G, v.B} end end
        for k, v in pairs(TR) do d.transparency[k] = v end
        for k, v in pairs(feat) do if type(v) == "boolean" or type(v) == "number" or type(v) == "string" then d.features[k] = v end end
        d.features.effectColor = {EFFECT_COLOR.R, EFFECT_COLOR.G, EFFECT_COLOR.B}
        for n, kb in pairs(Keybinds) do d.keybinds[n] = kb.key and kb.key.Name or nil end
        for n, s in pairs(SliderReg) do local ok, v = pcall(s.get); if ok then d.sliders[n] = v end end
        for name, frame in pairs(overlays) do d.overlays[name] = {xS=frame.Position.X.Scale, xO=frame.Position.X.Offset, yS=frame.Position.Y.Scale, yO=frame.Position.Y.Offset, vis=frame.Visible} end
        local win = UI.win
        d.meta.winPos = {xS=win.Position.X.Scale, xO=win.Position.X.Offset, yS=win.Position.Y.Scale, yO=win.Position.Y.Offset}
        d.meta.winSize = {w=win.Size.X.Offset, h=win.Size.Y.Offset}
        d.music = {volume=Music.volume, looped=Music.looped}
        d.glass = {on=Glass.on, clarity=Glass.clarity, blur=Glass.blur, refraction=Glass.refraction, hq=Glass.hq, opacity=UI.opacity}
        local favList = {}
        for id, v in pairs(Friends.favourites) do if v then favList[#favList + 1] = id end end
        d.friends = {chats = Friends.chats, favourites = favList}
        return d
    end
    local function load(d)
        if type(d) ~= "table" then return false end
        Fn.setGlass(false, true)
        if d.theme then for k, v in pairs(d.theme) do local c = col(v); if c then T[k] = c end end; applyTheme() end
        if d.transparency then for k, v in pairs(d.transparency) do if TR[k] ~= nil then TR[k] = v end end; Fn.applyAllTransparency() end
        if d.keybinds then for n, kn in pairs(d.keybinds) do if Keybinds[n] then if kn then local kc = Enum.KeyCode[kn]; if kc then Keybinds[n].key = kc end else Keybinds[n].key = nil end end end end
        if d.features then
            for k, v in pairs(d.features) do
                if k == "effectColor" then local c = col(v); if c then Fn.setEffectColor(c, true) end
                elseif feat[k] ~= nil then feat[k] = v end
            end
            for kbName, featKey in pairs(FEATMAP) do if ToggleReg[kbName] and feat[featKey] ~= nil then pcall(function() ToggleReg[kbName](feat[featKey]) end) end end
            Fn.rebuildVFX(); Wx.all()
            if Fn.applyScreenFilters then Fn.applyScreenFilters() end
            if Fn.rebuildCrosshair then Fn.rebuildCrosshair() end
            if Fn.setEspEnabled then Fn.setEspEnabled(feat.espEnabled) end
        end
        if d.sliders then for n, v in pairs(d.sliders) do local s = SliderReg[n]; if s then pcall(function() s.set(v) end) end end end
        if d.overlays then
            for name, pos in pairs(d.overlays) do
                local f = overlays[name]
                if f then
                    f.Position = UDim2.new(pos.xS, pos.xO, pos.yS, pos.yO)
                    local m = OVKB[name]
                    if m and ToggleReg[m] then pcall(ToggleReg[m], pos.vis) else f.Visible = pos.vis end
                end
            end
            Fn.refreshKb()
        end
        if d.meta then
            local win = UI.win
            if d.meta.winPos then win.Position = UDim2.new(d.meta.winPos.xS, d.meta.winPos.xO, d.meta.winPos.yS, d.meta.winPos.yO) end
            if d.meta.winSize then win.Size = UDim2.new(0, math.max(UI.MIN_W, d.meta.winSize.w or UI.ROOT_W), 0, math.max(UI.MIN_H, d.meta.winSize.h or UI.MAIN_H)) end
        end
        if d.music then
            if d.music.volume then Music.volume = d.music.volume; Music.sound.Volume = Music.volume end
            if d.music.looped ~= nil then Music.looped = d.music.looped; Music.sound.Looped = Music.looped; if UI.loopBtn then UI.loopBtn.Text = Music.looped and "Loop: ON" or "Loop: OFF" end end
        end
        if d.glass then
            if d.glass.opacity then UI.opacity = d.glass.opacity end
            if d.glass.clarity then Glass.clarity = d.glass.clarity end
            if d.glass.blur then Glass.blur = d.glass.blur end
            if d.glass.refraction then Glass.refraction = d.glass.refraction end
            if d.glass.hq ~= nil and ToggleReg.GlassHQ then pcall(ToggleReg.GlassHQ, d.glass.hq == true) end
            if d.glass.on then Fn.setGlass(true, true) end
        end
        if d.friends then
            if d.friends.chats then Friends.chats = d.friends.chats end
            if d.friends.favourites then for _, id in ipairs(d.friends.favourites) do Friends.favourites[id] = true end end
            Friends.save()
            if Friends.refresh then Friends.refresh() end
        end
        Fn.updateHud()
        return true
    end
    local function save()
        if not FILE_OK then return end
        local ok, e = pcall(function() return HttpService:JSONEncode({s=Saves, o=SaveOrder}) end)
        if ok then pcall(writefile, SAVE_FILE, e) end
    end
    if FILE_OK then
        local function tryLoad(p)
            local ok, ex = pcall(isfile, p); if not (ok and ex) then return nil end
            local ok2, raw = pcall(readfile, p); if not ok2 then return nil end
            local ok3, d = pcall(function() return HttpService:JSONDecode(raw) end)
            if ok3 and type(d) == "table" then return d end
            return nil
        end
        local d = tryLoad(SAVE_FILE) or tryLoad("shyclient_saves.json") or tryLoad("shyclient_v2_saves.json")
        if d then Saves = d.s or {}; SaveOrder = d.o or {} end
    end
    local refreshList
    hdr(pSaves, "Save Current Setup")
    local ni = mkInput(pSaves, "Save Name", "Config 1")
    local function doSave(name)
        if name == "" then notify("Save", "Enter a name", false) return end
        if not Saves[name] then table.insert(SaveOrder, name) end
        Saves[name] = snap(); save(); ni.Text = ""
        if refreshList then refreshList() end
        notify("Save", "Saved: " .. name)
    end
    local br = new("Frame",{Size=UDim2.new(1,-4,0,46),BackgroundTransparency=1,Parent=pSaves})
    new("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,8),Parent=br})
    local sb = new("TextButton",{Size=UDim2.new(0.5,-4,1,0),BackgroundColor3=Color3.new(1,1,1),Text="Save",Font=Enum.Font.GothamBold,TextColor3=ON_ACCENT,TextSize=12,BorderSizePixel=0,AutoButtonColor=false,Parent=br})
    corner(sb, RM); gradient(sb, T.Accent, T.Accent2, 0)
    sb.MouseButton1Click:Connect(function() playUiSoundLayered("click"); doSave((ni.Text:gsub("^%s+",""):gsub("%s+$",""))) end)
    local qs = new("TextButton",{Size=UDim2.new(0.5,-4,1,0),BackgroundColor3=T.Card,BackgroundTransparency=TR.Card,Text="Quick Save",Font=Enum.Font.GothamBold,TextColor3=T.Text,TextSize=12,BorderSizePixel=0,AutoButtonColor=false,Parent=br})
    corner(qs, RM); stroke(qs, 1, 0.55, T.Line); regRef(qs, "BackgroundColor3", "Card"); regRef(qs, "TextColor3", "Text"); regCard(qs)
    qs.MouseButton1Click:Connect(function() playUiSoundLayered("click"); doSave("Slot " .. (#SaveOrder + 1)) end)
    hdr(pSaves, "Saved Slots")
    local sl = new("Frame",{Size=UDim2.new(1,-4,0,0),BackgroundTransparency=1,AutomaticSize=Enum.AutomaticSize.Y,Parent=pSaves})
    new("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,6),Parent=sl})
    refreshList = function()
        for _, c in ipairs(sl:GetChildren()) do if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end end
        if #SaveOrder == 0 then
            local e = new("TextLabel",{Size=UDim2.new(1,0,0,42),BackgroundColor3=T.Card,BackgroundTransparency=TR.Card,Font=Enum.Font.Gotham,Text="No saves yet",TextColor3=T.Muted,TextSize=11,BorderSizePixel=0,Parent=sl})
            corner(e, RM); stroke(e, 1, 0.55, T.Line); regRef(e, "BackgroundColor3", "Card"); regCard(e)
            return
        end
        for i, name in ipairs(SaveOrder) do
            if Saves[name] then
                local row = new("Frame",{Size=UDim2.new(1,0,0,48),BackgroundColor3=T.Card,BackgroundTransparency=TR.Card,BorderSizePixel=0,LayoutOrder=i,Parent=sl})
                corner(row, RM); stroke(row, 1, 0.55, T.Line); regRef(row, "BackgroundColor3", "Card"); regCard(row)
                local nl = new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,16,0,0),Size=UDim2.new(1,-230,1,0),Font=Enum.Font.GothamMedium,Text=name,TextColor3=T.Text,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=3,Parent=row})
                regRef(nl, "TextColor3", "Text")
                local function mb(t, x, bg, fg, isAccent, cb)
                    local b = new("TextButton",{Size=UDim2.new(0,64,0,28),Position=UDim2.new(1,x,0.5,-14),BackgroundColor3=bg,Text=t,Font=Enum.Font.GothamBold,TextColor3=fg,TextSize=11,BorderSizePixel=0,AutoButtonColor=false,ZIndex=4,Parent=row})
                    corner(b, 7)
                    if isAccent then gradient(b, T.Accent, T.Accent2, 0) else stroke(b, 1, 0.55, T.Line) end
                    b.MouseButton1Click:Connect(function() playUiSoundLayered("click"); cb() end)
                end
                mb("Load", -212, Color3.new(1,1,1), ON_ACCENT, true, function() if load(Saves[name]) then notify("Save", "Loaded: " .. name) end end)
                mb("Delete", -72, T.Card, T.Bad, false, function()
                    Saves[name] = nil
                    for k, n in ipairs(SaveOrder) do if n == name then table.remove(SaveOrder, k); break end end
                    save(); if refreshList then refreshList() end
                    notify("Save", "Deleted: " .. name, false)
                end)
            end
        end
    end
    refreshList()
end

