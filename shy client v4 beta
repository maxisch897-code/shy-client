    Fn.rebuildVFX = function()
        clearVfx()
        local char = player.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        local EC = EFFECT_COLOR
        Fn.applyNeonBody(); Fn.applyPlayerTransparency(); Fn.applyRainbowChar()
        Fn.rebuildAuraRing(); Fn.rebuildOrbs(); Fn.rebuildLightning(); Fn.rebuildFireFootsteps()
        if feat.glow then
            vfxObj.g1 = new("Highlight",{FillColor=EC,FillTransparency=0.5,OutlineColor=EC,OutlineTransparency=0,Parent=char})
            vfxObj.g2 = new("PointLight",{Color=EC,Range=20,Brightness=3,Parent=hrp})
        end
        if feat.trail then
            local a0 = new("Attachment",{Position=Vector3.new(0,0.6,0),Parent=hrp})
            local a1 = new("Attachment",{Position=Vector3.new(0,-0.6,0),Parent=hrp})
            vfxObj.trail = new("Trail",{Attachment0=a0,Attachment1=a1,Lifetime=1.2,LightEmission=1,Color=ColorSequence.new(EC),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.15),NumberSequenceKeypoint.new(1,1)}),WidthScale=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}),Parent=hrp})
        end
        if feat.fire then
            vfxObj.fire = new("ParticleEmitter",{Texture="rbxassetid://243098098",Rate=60,Lifetime=NumberRange.new(0.5,1),Speed=NumberRange.new(3,6),SpreadAngle=Vector2.new(15,15),Color=ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.new(math.min(EC.R+0.3,1),math.min(EC.G+0.3,1),math.min(EC.B+0.3,1))), ColorSequenceKeypoint.new(0.4, EC), ColorSequenceKeypoint.new(1, Color3.new(EC.R*0.3,EC.G*0.3,EC.B*0.3))}),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.1),NumberSequenceKeypoint.new(1,1)}),LightEmission=1,Parent=hrp})
        end
        if feat.sparkle then
            vfxObj.sparkle = new("ParticleEmitter",{Texture="rbxassetid://243098098",Rate=25,Lifetime=NumberRange.new(1.2,2.2),Speed=NumberRange.new(0,0.5),SpreadAngle=Vector2.new(180,180),Color=ColorSequence.new({ColorSequenceKeypoint.new(0,EC:Lerp(Color3.new(1,1,1),0.4)),ColorSequenceKeypoint.new(1,EC)}),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(0.4,0.7),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}),LightEmission=1,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-50,50),Parent=hrp})
        end
        if feat.jumpRing then
            vfxObj.jr = hum.StateChanged:Connect(function(_, ns)
                if ns == Enum.HumanoidStateType.Jumping then
                    local h = char:FindFirstChild("HumanoidRootPart"); if not h then return end
                    ring(h.Position - Vector3.new(0,2.5,0), EC, 4); Fn.triggerShake(2)
