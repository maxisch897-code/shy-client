        if lightConn then lightConn:Disconnect(); lightConn = nil end
        if not feat.lightningAura then return end
        lightAcc = 0
        lightConn = RS.Heartbeat:Connect(function(dt)
            lightAcc += dt
            if lightAcc < 1/feat.lightningRate then return end
            lightAcc = 0
            local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local from = hrp.Position + Vector3.new(math.random(-2,2), math.random(-2,2), math.random(-2,2))
