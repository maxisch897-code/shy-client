            t += dt * feat.orbitOrbSpeed
            local char = player.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local n = #orbs
            for i, o in ipairs(orbs) do
                if not o.Parent then continue end
                local angle = t + (i-1)/n * math.pi * 2
                local h = math.sin(t*2 + i) * 0.5
                o.CFrame = CFrame.new(hrp.Position + Vector3.new(math.cos(angle)*feat.orbitOrbRadius, h, math.sin(angle)*feat.orbitOrbRadius))
                o.Color = EFFECT_COLOR
