-- VFX (all body effects)
-- ══════════════════════════════════════════════════════════════
do
    local vfxObj = {}
    local function clearVfx()
        for _, o in pairs(vfxObj) do
            if typeof(o) == "Instance" then pcall(function() o:Destroy() end)
            elseif typeof(o) == "RBXScriptConnection" then pcall(function() o:Disconnect() end) end
        end
        vfxObj = {}
    end
    local function ring(pos, col, sz)
        local p = new("Part",{Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,Shape=Enum.PartType.Cylinder,Size=Vector3.new(0.3,sz,sz),CFrame=CFrame.new(pos)*CFrame.Angles(0,0,math.rad(90)),Material=Enum.Material.Neon,Color=col,Transparency=0.15,Parent=workspace})
        local t = TS:Create(p,TweenInfo.new(0.7,Enum.EasingStyle.Quint),{Size=Vector3.new(0.1,sz*4,sz*4),Transparency=1})
        t:Play(); t.Completed:Connect(function() p:Destroy() end)
    end
    local neonSaved = {}
    local neonConn = nil
    Fn.applyNeonBody = function()
        local char = player.Character; if not char then return end
        if feat.neon then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    if neonSaved[p] == nil then neonSaved[p] = p.Material end
                    p.Material = Enum.Material.Neon; p.Color = EFFECT_COLOR
                end
            end
        else
            for p, mat in pairs(neonSaved) do if p and p.Parent then p.Material = mat end end
            table.clear(neonSaved)
        end
    end
    local function hookNeon(char)
        if neonConn then neonConn:Disconnect(); neonConn = nil end
        if not char then return end
        Fn.applyNeonBody()
        neonConn = char.DescendantAdded:Connect(function() if feat.neon then task.defer(Fn.applyNeonBody) end end)
    end
    local function applyTrans(p)
        if not p:IsA("BasePart") or p.Name == "HumanoidRootPart" then return end
        p.LocalTransparencyModifier = (feat.playerTransparency and feat.playerTransparencyLevel/100) or 0
    end
    Fn.applyPlayerTransparency = function()
        local c = player.Character; if not c then return end
        for _, d in ipairs(c:GetDescendants()) do applyTrans(d) end
    end
    local function hookTrans(char)
        if not char then return end
        Fn.applyPlayerTransparency()
        char.DescendantAdded:Connect(function(d) task.defer(function() applyTrans(d) end) end)
    end
    local rainbowOrig, rainbowConn = {}, nil
    Fn.applyRainbowChar = function()
        local char = player.Character; if not char then return end
        if not feat.rainbowChar then
            for p, col in pairs(rainbowOrig) do if p and p.Parent then p.Color = col end end
            table.clear(rainbowOrig)
            if rainbowConn then rainbowConn:Disconnect(); rainbowConn = nil end
            return
        end
        for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and rainbowOrig[p] == nil then rainbowOrig[p] = p.Color end end
        if not rainbowConn then
            local t = 0
            rainbowConn = RS.Heartbeat:Connect(function(dt)
                if not feat.rainbowChar then return end
                t += dt * feat.rainbowSpeed
                local c = player.Character; if not c then return end
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                        local hue = (t + (p.Position.X + p.Position.Z)*0.05) % 1
