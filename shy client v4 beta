        if not feat.orbitOrbs then return end
        for i = 1, feat.orbitOrbCount do
            orbs[i] = new("Part", {Shape=Enum.PartType.Ball, Size=Vector3.new(feat.orbitOrbSize,feat.orbitOrbSize,feat.orbitOrbSize), Anchored=true, CanCollide=false, CanQuery=false, CanTouch=false, CastShadow=false, Material=Enum.Material.Neon, Color=EFFECT_COLOR, Parent=workspace})
        end
